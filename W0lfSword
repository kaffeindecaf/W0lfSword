        for src_dir in referenceforAI/projects/usbliter8-fun/tools referenceforAI/projects/usbliter8-fun2/tools; do
            [ -d "$src_dir" ] && cp "$src_dir"/* "$ul8_tools_dir/" 2>/dev/null && chmod +x "$ul8_tools_dir"/* 2>/dev/null
        done
        ok "usbliter8-arctic tools synced"
    fi
    
    echo ""
    echo -e "  ${C_GRN}${B}Setup complete. Run './W0lfSword doctor' to verify.${NC}"
    log_script "setup completed ($pkg_manager)"
}

