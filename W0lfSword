cmd_profile() {
    local action="${1:-list}" name="${2:-}"
    case "$action" in
        save)
            [ -z "$name" ] && { echo -e "${C_RED}Usage:${NC} profile save <name>"; return 1; }
            local ip; ip=$(get_device_ip)
            cat > "$DATA_DIR/profiles/$name.json" << EOF
{
  "name": "$name",
  "device_ip": "${ip:-}",
  "target": "com.tigisoftware.Filza",
  "retry_count": 5,
  "ssv_enabled": true,
  "saved_at": "$(date -Iseconds)"
}
EOF
            echo "$name" > "$DATA_DIR/active_profile"
            ok "Profile saved: ${C_EYE}$name${NC}"
            [ -n "$ip" ] && info "Device: $ip"
            return 0
            ;;
        load)
            [ -z "$name" ] && { err "Usage: profile load <name>"; return 1; }
            if [ -f "$DATA_DIR/profiles/$name.json" ]; then
                echo "$name" > "$DATA_DIR/active_profile"
                local saved_ip; saved_ip=$(python3 -c "import json; print(json.load(open('$DATA_DIR/profiles/$name.json')).get('device_ip',''))" 2>/dev/null || echo "")
                [ -n "$saved_ip" ] && echo "$saved_ip" > "$DATA_DIR/active_device"
                ok "Loaded: ${C_EYE}$name${NC}"
                [ -n "$saved_ip" ] && info "Device: $saved_ip"
                return 0
            else
                err "Profile '$name' not found"
            fi
            ;;
        list)
            section "Profiles"
            if ls "$DATA_DIR/profiles/"*.json >/dev/null 2>&1; then
                local active; active=$(cat "$DATA_DIR/active_profile" 2>/dev/null || echo "")
                for f in "$DATA_DIR/profiles/"*.json; do
                    local n; n=$(basename "$f" .json)
                    local dip; dip=$(python3 -c "import json; print(json.load(open('$f')).get('device_ip','-'))" 2>/dev/null || echo "-")
                    local ts; ts=$(python3 -c "import json; print(json.load(open('$f')).get('saved_at','-'))" 2>/dev/null | cut -dT -f1 || echo "-")
                    local marker=" "
                    [ "$active" = "$n" ] && marker="${C_EYE}*${NC}"
                    printf "  %s ${C_EYE}%-14s${NC} ${C_DIM}ip:${NC} %-18s ${C_DIM}saved:${NC} %s\n" "$marker" "$n" "$dip" "$ts"
                done
            else
                echo -e "  ${C_DIM}No profiles yet. Use 'profile save <name>'${NC}"
            fi
            ;;
        *) echo -e "${C_RED}Usage:${NC} profile save|load|list [name]";;
    esac
}

