# ── Multi-device scanner ──────────────────────────────────────
scan_devices() {
    # Returns count of found devices, sets global arrays
    DEV_USB=(); DEV_WIFI=(); DEV_COUNT=0

    # USB devices via libimobiledevice
    if command -v idevice_id &>/dev/null; then
        local uuids; uuids=$(idevice_id -l 2>/dev/null || echo "")
        if [ -z "$uuids" ] && lsusb 2>/dev/null | grep -qi "05ac"; then
            warn "Apple device on USB but usbmuxd can't see it — restart: sudo systemctl restart usbmuxd"
        fi
        if [ -n "$uuids" ]; then
            while IFS= read -r uuid; do
                [ -z "$uuid" ] && continue
                local name; name=$(ideviceinfo -u "$uuid" -k DeviceName 2>/dev/null || echo "iPhone")
                local ios; ios=$(ideviceinfo -u "$uuid" -k ProductVersion 2>/dev/null || echo "?")
                local model; model=$(ideviceinfo -u "$uuid" -k HardwareModel 2>/dev/null || echo "?")
                DEV_USB+=("$uuid|$name|$ios|$model")
                ((DEV_COUNT++))
            done <<< "$uuids"
        fi
    fi

    # WiFi devices from saved list
    local active_active; active_active=$(get_device_ip)
    if [ -f "$DATA_DIR/devices.list" ] && [ -s "$DATA_DIR/devices.list" ]; then
        while read -r dip dname; do
            [ -z "$dip" ] && continue
            local is_usb=false
            for u in "${DEV_USB[@]}"; do
                [[ "$u" == *"$dip"* ]] && is_usb=true && break
            done
            $is_usb && continue

            local mark=" "; [ "$dip" = "$active_active" ] && mark="*"
            local st="${C_DIM}offline${NC}"
            ping_check "$dip" && st="${C_GRN}online${NC}"
            DEV_WIFI+=("$mark|$dip|$dname|$st")
            ((DEV_COUNT++))
        done < <(sort -u "$DATA_DIR/devices.list")
    fi
}

