cmd_setup() {
    show_header
    echo ""
    section "W0lfSword Setup — Install Dependencies"
    echo ""
    disclaimer <<EOF
In plain English: this installs build tools on THIS COMPUTER (clang, dpkg,
THEOS, SSH). Nothing is installed on the phone. The phone only needs to be
jailbroken, have OpenSSH running, and have Filza already installed.
EOF
    # Linux needs root for apt; macOS must NOT be root for brew (brew
    # refuses to run as root) — sudo is only used for /opt/theos there.
    if [ "$EUID" -ne 0 ] && [ "$IS_MACOS" -eq 0 ]; then
        err "Run with sudo: sudo ./W0lfSword setup"
        return 1
    fi
    local SUDO=""
    if [ "$IS_MACOS" -eq 1 ]; then
        [ "$EUID" -ne 0 ] && SUDO="sudo"
    fi
    
    local pkg_manager=""
    if [ "$IS_MACOS" -eq 1 ]; then pkg_manager="brew"
    elif command -v apt &>/dev/null; then pkg_manager="apt"
    elif command -v pacman &>/dev/null; then pkg_manager="pacman"
    else err "No supported package manager (apt/brew/pacman)"; hint "Install clang, dpkg, ssh, git, python3 and THEOS manually — see BUILD.md"; return 1; fi

    echo -e "  ${C_DIM}Detected: ${C_EYE}$OS_NAME — ${pkg_manager}${NC}"
    echo ""

    # macOS: clang comes from Xcode Command Line Tools, not brew.
    if [ "$IS_MACOS" -eq 1 ]; then
        if ! xcode-select -p &>/dev/null; then
            echo -e "  ${C_AMB}⚠ Xcode Command Line Tools not found${NC}"
            echo -e "  ${C_DIM}  → Install them first (provides clang + the iPhoneOS SDK):${NC}"
            echo -e "  ${C_DIM}    xcode-select --install${NC}"
            echo ""
            hint "Re-run 'sudo ./W0lfSword setup' after the install finishes."
            return 1
        fi
        if ! xcrun --sdk iphoneos --show-sdk-path &>/dev/null 2>&1; then
            warn "iPhoneOS SDK not visible — open Xcode once or install the iOS SDK"
            hint "xcrun --sdk iphoneos --show-sdk-path should print a path."
        else
            ok "Xcode iPhoneOS SDK: $(xcrun --sdk iphoneos --show-sdk-path 2>/dev/null)"
        fi
        echo ""
    fi

    local to_install=""
    command -v clang &>/dev/null || { [ "$IS_MACOS" -eq 0 ] && to_install="$to_install clang"; }
    command -v dpkg-deb &>/dev/null || to_install="$to_install dpkg"
    command -v git &>/dev/null || to_install="$to_install git"
    command -v python3 &>/dev/null || to_install="$to_install python3"

    # idevice tools + ssh: platform-specific package names
    if [ "$pkg_manager" = "apt" ]; then
        command -v ssh &>/dev/null || to_install="$to_install openssh-client"
        command -v idevice_id &>/dev/null || to_install="$to_install libimobiledevice-utils"
    elif [ "$pkg_manager" = "brew" ]; then
        command -v idevice_id &>/dev/null || to_install="$to_install libimobiledevice"
    fi
    
    if [ -n "$to_install" ]; then
        echo -e "  ${C_AMB}Missing:${C_RED}${to_install}${NC}"
        echo ""
        if confirm "Install now?"; then
            case "$pkg_manager" in
                apt)    apt update -qq && apt install -y $to_install;;
                brew)   brew install $to_install;;
                pacman) pacman -Sy --noconfirm $to_install;;
            esac
            ok "Packages installed"
        fi
    else
        ok "All system packages present"
    fi
    
    # THEOS
    if check_theos; then
        ok "THEOS found at ${THEOS}"
    else
        echo -e "  ${C_AMB}⚠ THEOS not found${NC}"
        if confirm "Install THEOS?"; then
            if [ "$IS_MACOS" -eq 1 ]; then
                # macOS: /opt/theos is the default theos.dev location
                if command -v brew &>/dev/null && [ ! -d /opt/theos ]; then
                    bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null \
                        && export THEOS=/opt/theos \
                        || { $SUDO mkdir -p /opt/theos && $SUDO chown "$(id -u)" /opt/theos && git clone --recursive https://github.com/theos/theos.git /opt/theos && export THEOS=/opt/theos; }
                else
                    bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null \
                        && export THEOS=/opt/theos
                fi
                ok "THEOS installed at ${THEOS:-/opt/theos}"
                hint "Add 'export THEOS=/opt/theos' to ~/.zshrc (macOS) for future runs."
            else
                bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null
                export THEOS="$HOME/theos"
                ok "THEOS installed"
                hint "The export only lasts for this session — add 'export THEOS=~/theos' to your shell rc for future runs."
            fi
        fi
    fi
    
    # usbliter8-arctic tools sync
    local ul8_tools_dir="$PROJECT_DIR/.w0lfsword/usbliter8/tools"
    if [ ! -f "$ul8_tools_dir/usbliter8ctl" ]; then
        echo ""
        echo -e "  ${C_AMB}Syncing usbliter8-arctic tools...${NC}"
