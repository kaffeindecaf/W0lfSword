cmd_safe() {
    local action="" ip=""
    for a in "$@"; do
        if [ "$a" = "on" ] || [ "$a" = "off" ]; then
            action="$a"
        else
            ip="$a"
        fi
    done
    action="${action:-on}"
    [ -z "$ip" ] && ip=$(get_device_ip)
    [ -z "$ip" ] && { err "No device IP"; hint "Connect via USB or: ./W0lfSword device add <ip>"; return 1; }
    disclaimer <<EOF
In plain English: 'safe on' tells the tweak to only load the Filza UI hooks
(no padlocks, license bypass) and skip ALL kernel writes. Nothing risky runs.
'safe off' lets the full kernel exploit run again on the next Filza launch.
Use safe mode first on new devices to make sure nothing crashes.
EOF

    case "$action" in
        on)
            if ssh_safe "root@$ip" "touch /var/mobile/Documents/.filza_safe_mode" 2>/dev/null; then
                echo -e "  ${C_GRN}✓${NC} Safe mode ENABLED — tweak will skip all kernel writes"
                echo -e "  ${C_DIM}Delete /var/mobile/Documents/.filza_safe_mode to re-enable exploit${NC}"
                log_script "safe mode ON for $ip"
            else
                err "SSH failed — cannot set safe mode on $ip"
                hint "Install OpenSSH on the phone (Sileo/Cydia) and verify with: ./W0lfSword device info $ip"
                return 1
            fi
            ;;
        off)
            if ssh_safe "root@$ip" "rm -f /var/mobile/Documents/.filza_safe_mode" 2>/dev/null; then
                echo -e "  ${C_AMB}⚠${NC} Safe mode DISABLED — exploit will run on next Filza launch"
                echo -e "  ${C_DIM}Run './W0lfSword safe on' to re-enable safety${NC}"
                log_script "safe mode OFF for $ip"
            else
                err "SSH failed — cannot clear safe mode on $ip"
                hint "Install OpenSSH on the phone (Sileo/Cydia) and verify with: ./W0lfSword device info $ip"
                return 1
            fi
            ;;
        *) echo -e "${C_RED}Usage:${NC} safe on|off [ip]";;
    esac
}

crash_monitor() {
    local ip="${1:-}" outfile="${2:-$DATA_DIR/last_crash.log}"
    [ -z "$ip" ] && return 1

    # Don't start the monitor unless the device is actually reachable —
    # otherwise every offline deploy would log a fake "kernel panic".
    if ! ssh_safe "root@$ip" "echo ok" 2>/dev/null | grep -q ok; then
        echo -e "  ${C_DIM}Crash monitor skipped — device unreachable${NC}"
        log_script "crash monitor skipped: $ip unreachable"
        return 1
    fi

    echo -e "  ${C_DIM}Crash monitor started — saving to ${outfile}${NC}"
    log_script "crash monitor started for $ip"

    # Background: tail the log until the device goes offline
    (
        ssh_safe "root@$ip" "tail -f /tmp/FilzaTweak.log 2>/dev/null" 2>/dev/null | while IFS= read -r l; do
            echo "[$(date '+%H:%M:%S')] $l" >> "$outfile"
        done
        # Connection lost — could be a reboot, intentional disconnect, OR a kernel panic
        echo "[$(date '+%H:%M:%S')] === CONNECTION LOST (reboot, disconnect, or kernel panic — check last lines) ===" >> "$outfile"
        log_script "crash monitor: $ip connection lost"
    ) &
    CRASH_MONITOR_PID=$!
    echo -e "  ${C_DIM}Monitor PID: $CRASH_MONITOR_PID (auto-cleaned on next run)${NC}"
}

stop_crash_monitor() {
    [ -n "${CRASH_MONITOR_PID:-}" ] && kill "$CRASH_MONITOR_PID" 2>/dev/null || true
    CRASH_MONITOR_PID=""
}

cmd_crashlog() {
    local logfile="$DATA_DIR/last_crash.log"
    if [ -f "$logfile" ] && [ -s "$logfile" ]; then
        section "Last Crash Log ($logfile)"
        echo ""
        cat "$logfile" | while IFS= read -r l; do
            if echo "$l" | grep -q 'OFFLINE\|PANIC\|kernel panic'; then
                echo -e "  ${C_RED}${B}$l${NC}"
            elif echo "$l" | grep -q 'ERROR\|FAILED'; then
                echo -e "  ${C_RED}$l${NC}"
            elif echo "$l" | grep -q 'Retry\|WARNING\|SAFE'; then
                echo -e "  ${C_AMB}$l${NC}"
            else
                echo -e "  ${C_DIM}$l${NC}"
            fi
        done
        echo ""
        echo -e "  ${C_DIM}Lines: $(wc -l < "$logfile")${NC}"
    else
        echo -e "  ${C_DIM}No crash log yet — deploy first.${NC}"
    fi
}

