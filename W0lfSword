#  MAIN
# ═══════════════════════════════════════════════════════════════

main() {
    # Parse flags
    for a in "$@"; do
        [ "$a" = "-v" ] || [ "$a" = "--verbose" ] && { [ "$VERBOSE" = "false" ] && VERBOSE=true; continue; }
        [ "$a" = "-vv" ] || [ "$a" = "--debug" ] && { DEBUG=true; VERBOSE=true; continue; }
        [ "$a" = "-y" ] || [ "$a" = "--yes" ] && { YES_MODE=true; continue; }
        [ "$a" = "-x" ] || [ "$a" = "--explain" ] && { EXPLAIN=true; continue; }
        [ "$a" = "--json" ] && { JSON_MODE=true; continue; }
    done

    local args=()
    local cmd=""
    for a in "$@"; do
        case "$a" in -v|-vv|--verbose|--debug|-y|--yes|-x|--explain|--json) continue;; esac
        [ "$a" = "--install" ] && a="install"
        [ -z "$cmd" ] && { cmd="$a"; continue; }
        args+=("$a")
    done
    CRIT_CMD="$cmd"

    if $EXPLAIN; then
        explain_text "${cmd:-help}"
        exit 0
    fi

    # J2.3: first-run convenience  -  auto-load a saved 'default' profile when
    # no profile is active yet (and the user didn't ask for profile commands).
    if ! $JSON_MODE && [ "$cmd" != "profile" ] && [ ! -f "$DATA_DIR/active_profile" ] && [ -f "$DATA_DIR/profiles/default.json" ]; then
        echo "default" > "$DATA_DIR/active_profile"
        local def_ip; def_ip=$(python3 -c "import json; print(json.load(open('$DATA_DIR/profiles/default.json')).get('device_ip',''))" 2>/dev/null || echo "")
        [ -n "$def_ip" ] && echo "$def_ip" > "$DATA_DIR/active_device"
        echo -e "  ${C_DIM}Auto-loaded profile 'default'${NC}"
    fi

    case "$cmd" in
        "") run_menu "$@";;
        build)     cmd_build "${args[@]}";;
        extract)   cmd_extract "${args[@]}";;
        deploy)    cmd_deploy "${args[@]}";;
        status)    cmd_status "${args[@]}";;
        audit)     cmd_audit "${args[@]}";;
        log)       cmd_log "${args[@]}";;
        toggle)    cmd_toggle "${args[@]}";;
        offsets)   cmd_offsets "${args[@]}";;
        targets)   cmd_targets "${args[@]}";;
        exploits)  cmd_exploits "${args[@]}";;
        chains)    cmd_chains "${args[@]}";;
        cve)       cmd_cve "${args[@]}";;
        poclab)    cmd_poclab "${args[@]}";;
        experimental|exp) cmd_experimental "${args[@]}";;
        report)    cmd_report "${args[@]}";;
        config|cfg|g) cmd_config "${args[@]}";;
        poc)       cmd_poc "${args[@]}";;
        fuzz)      cmd_fuzz "${args[@]}";;
        kcwatch)   cmd_kcwatch "${args[@]}";;
        readiness) cmd_readiness "${args[@]}";;
        mha)       cmd_mha "${args[@]}";;
        tweaks)    cmd_tweaks "${args[@]}";;
        clean)     cmd_clean "${args[@]}";;
        doctor)    cmd_doctor "${args[@]}";;
        quick)     cmd_quick "${args[@]}";;
        adderall)  cmd_adderall "${args[@]}";;
        nojailbreak|nj) cmd_nojailbreak "${args[@]}";;
        safe)      cmd_safe "${args[@]}";;
        crashlog)  cmd_crashlog "${args[@]}";;
        update)    cmd_update "${args[@]}";;
        setup|install) cmd_setup "${args[@]}";;
        reboot)    cmd_reboot "${args[@]}";;
        export)    cmd_export "${args[@]}";;
        profile)   cmd_profile "${args[@]}";;
        device)    cmd_device "${args[@]}";;
        history)   cmd_history "${args[@]}";;
        monitor)   cmd_monitor "${args[@]}";;
        usbtest)   cmd_usbtest "${args[@]}";;
        panic)     cmd_panic "${args[@]}";;
        kernelcache) cmd_kernelcache "${args[@]}";;
        explain)   cmd_explain "${args[@]}";;
        # Add quick version command
     version|--version|-V) echo -e "${C_WOLF}W0lfSword v${VERSION}${NC}  -  iOS Kernel Exploit Toolkit"; echo -e "${C_DIM}github.com/kaffeindecaf/W0lfSword${NC}";;
        help|h|--help|-h) cmd_help "${args[@]}";;
        usbliter8|ul8)
            if [ "$EUID" -ne 0 ]; then
                echo -e "  ${C_RED}✗ usbliter8 needs root for USB/DFU access${NC}"
                echo -e "  ${C_DIM}Re-run with: ${C_FROST}sudo ./W0lfSword ul8${NC}"
                exit 1
            fi
            shift; run_usbliter8 "$@" ;;
        *) echo -e "${C_RED}Unknown: $cmd${NC}"; echo -e "Run ${C_FROST}./W0lfSword${NC} for interactive menu";;
    esac
}

main "$@"
