cmd_build() {
    $VERBOSE || spinner "compiling"
    check_theos || { err "THEOS not set — export THEOS=~/theos"; return 1; }
    local log; log=$(make package 2>&1)
    local ec=$?
    $VERBOSE && echo "$log" | tail -20
    local deb; deb=$(find_deb)
    if [ $ec -eq 0 ] && [ -n "$deb" ]; then
        ok "Built $(basename "$deb") ($(du -h "$deb" | cut -f1))"
    else
        err "Build failed (exit=$ec)"
        [ -n "$log" ] && echo "  ${C_DIM}${log}${NC}" | tail -5
        return 1
    fi
}

cmd_extract() {
    $VERBOSE || spinner "extracting"
    local deb; deb=$(find_deb)
    [ -z "$deb" ] && { err "No .deb found — build first"; return 1; }
    local edir="/tmp/w0lf_extract_$$"; mkdir -p "$edir"
    dpkg-deb -x "$deb" "$edir/" 2>/dev/null
    local dylib; dylib=$(find "$edir" -name '*.dylib' -type f 2>/dev/null | head -1)
    [ -z "$dylib" ] && { err "No dylib in package"; rm -rf "$edir"; return 1; }
    cp "$dylib" "$PROJECT_DIR/W0lfSword.dylib"
    ok "Extracted W0lfSword.dylib ($(du -h W0lfSword.dylib | cut -f1))"
    rm -rf "$edir"
}

cmd_deploy() {
    local ip; ip=$(get_device_ip "${1:-}")
    [ -z "$ip" ] && { err "No device IP — pass it or use 'device add'"; return 1; }
    $VERBOSE || spinner "deploying to $ip"
    log_script "deploy to $ip"

    if ! ssh_safe "root@$ip" "echo ok" | grep -q ok; then
        err "SSH failed to root@$ip — is OpenSSH installed? Try 'device info $ip'"
        return 1
    fi
    vlog "SSH connection: ok"

    local deb; deb=$(find_deb)
    [ -z "$deb" ] && { err "No .deb — build first: ./W0lfSword build"; return 1; }

    local rp="/tmp/$(basename "$deb")"
    vlog "Uploading $deb → root@$ip:$rp"
    retry 3 1 "scp_safe '$deb' 'root@$ip:$rp'" || { err "SCP failed after 3 retries"; return 1; }
    local out; out=$(ssh_safe "root@$ip" "dpkg -i '$rp' 2>&1; rm -f '$rp'")
    ok "Installed on $ip"
    [ -n "$out" ] && vlog "dpkg: $out"

    ssh_safe "root@$ip" "killall -9 Filza 2>/dev/null" || true
    vlog "Filza restarted"
    echo "$ip" > "$DATA_DIR/active_device"
    log_script "deploy success: $ip"

    # Start crash monitor in background
    crash_monitor "$ip" "$DATA_DIR/last_crash.log"
}

