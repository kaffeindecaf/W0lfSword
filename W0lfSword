# ═══════════════════════════════════════════════════════════════
#  MAIN DISPATCH
# ═══════════════════════════════════════════════════════════════

main() {
    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        build)      cmd_build "$@";;
        extract)    cmd_extract "$@";;
        deploy)     cmd_deploy "$@";;
        status)     cmd_status "$@";;
        audit)      cmd_audit "$@";;
        log)        cmd_log "$@";;
        toggle)     cmd_toggle "$@";;
        offsets)    cmd_offsets "$@";;
        targets)    cmd_targets "$@";;
        clean)      cmd_clean "$@";;
        doctor)     cmd_doctor "$@";;
        help|--help|-h) cmd_help "$@";;
        *)
            echo -e "${CLR_BLOOD}Unknown command: $cmd${NC}"
            echo -e "Run ${CLR_FROST}./W0lfSword help${NC} for usage"
            exit 1
            ;;
    esac
}

main "$@"
