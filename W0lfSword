# single source of truth for the art; show_wolf and the boot scramble
# both render from here
wolf_art() {
    cat << 'WOLF'

                         .d$$b
                       .' TO$;\
                      /  : TP._;
                     / _.;  :Tb|
                    /   /   ;j$j
                _.-"       d$$$$
              .' ..       d$$$$;
             /  /P'      d$$$$P. |\
            /   "      .d$$$P' |\^"l
          .'           `T$P^"""""  :
      ._.'      _.'                ;
   `-.-".-'-' ._.       _.-"    .-"
 `.-" _____  ._              .-"
-.(g$$$$$$$b.              .'
  ""^^T$$$P^)            .(:
    _/  -"  /.'         /:/;
 ._.'-'`-'  ")/         /;/;
`-.-"..--""   " /         /  ;
.-" ..--""        -'          :
..--""--.-"         (\      .-(\
  ..--""              `-\(\\/;`
    _.                      :
                            ;`-
                           :\
                           ;
WOLF
}

show_wolf() {
    echo -e "${1:-$C_WOLF}"
    wolf_art
    echo -e "${NC}"
}

# Scramble the wolf art's own characters ($1 color, $2 frames, $3 spinner)
# and settle into the real art. Leaves the settled wolf on screen.
scramble_wolf() {
    local color="${1:-$C_WOLF}" frames="${2:-12}" spinner="${3:-0}"
    local -a art=()
    local line
    while IFS= read -r line; do art+=("$line"); done < <(wolf_art)
    local n=${#art[@]}
    local chars="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*+-=<>?/\\|"
    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local f i j len out ch r p
    printf "\033[?25l"
    for ((f=0; f<frames; f++)); do
        p=$((f * 100 / frames))   # % of chars already settled this frame
        printf "\033[H\033[2J"
        [ "$spinner" = "1" ] && printf "  ${C_EYE}%s${NC} ${C_GREY}loading...${NC}\n" "${spin[$((f % 10))]}"
        for ((i=0; i<n; i++)); do
            line="${art[$i]}"
            len=${#line}
            out=""
            for ((j=0; j<len; j++)); do
                ch="${line:$j:1}"
                if [ "$ch" = " " ]; then
                    out+=" "
                elif [ $((RANDOM % 100)) -lt "$p" ]; then
                    out+="$ch"
                else
                    r=$((RANDOM % ${#chars}))
                    out+="${chars:$r:1}"
                fi
            done
            printf "%s\n" "$out"
        done
        anim_pause 0.05
    done
    # settle: show the real, fully normal wolf
    printf "\033[H\033[2J"
    show_wolf "$color"
    printf "\033[?25h"
}

# Boot loading screen: the wolf's own characters scramble and settle
# into the real art, with a tiny spinner + "loading..." above. When the
# wolf belongs in the menu (show_wolf=menu), it stays on screen and the
# menu draws below it; otherwise the screen clears for a text-only menu.
WOLF_ON_SCREEN=false
show_loading() {
    anim_on || return 0
    [ "$CFG_SHOW_WOLF" = "never" ] && return 0
    local frames
    frames=$(awk "BEGIN{printf \"%d\", $CFG_LOADING_TIME*12}")
    [ "$frames" -lt 8 ] && frames=8
    [ "$frames" -gt 40 ] && frames=40
    scramble_wolf "$C_WOLF" "$frames" 1
    anim_pause 0.35
    if [ "$CFG_SHOW_WOLF" = "menu" ]; then
        WOLF_ON_SCREEN=true      # menu draws below the settled wolf
    else
        printf "\033[H\033[2J"   # text-only menu
    fi
}

# Text reveal: reads lines on stdin, resolves each one with a short
# color cascade (dim -> frost -> real colors), top to bottom. Shorter
# per line than the wolf scramble, so the menu materializes quickly.
# Lines wider than the terminal are printed as-is: scrambling a line
# that wraps would leave frame fragments behind.
reveal_lines() {
    printf "\033[?25l"
    local -a rlines=()
    local line
    while IFS= read -r line; do rlines+=("$line"); done
    local n=${#rlines[@]}
    local chars="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#$%&*+-=<>?/\\|"
    local i j len out ch r p plain cols
    cols=$(stty size 2>/dev/null | awk '{print $2}')
    [ -n "$cols" ] && [ "$cols" -gt 20 ] || cols=80
    for ((i=0; i<n; i++)); do
        line="${rlines[$i]}"
        # strip ANSI codes to get the visible text for scrambling
        plain=$(printf '%s' "$line" | sed $'s/\033\\[[0-9;]*m//g')
        # character count, not bytes: multibyte glyphs (─, ·, →) are 1 char
        len=$(printf '%s' "$plain" | wc -m 2>/dev/null | tr -d ' ')
        [ -n "$len" ] && [ "$len" -gt 0 ] || len=${#plain}
        if [ "$len" -eq 0 ]; then
            printf "\n"
            continue
        fi
        # too wide to animate safely: the line would wrap mid-scramble
        if [ "$len" -gt "$cols" ]; then
            printf "%s\n" "$line"
            continue
        fi
        # two quick scramble frames, colors shift dim -> frost
        for p in 30 75; do
            out=""
            for ((j=0; j<len; j++)); do
                ch="${plain:$j:1}"
                if [ "$ch" = " " ]; then
                    out+=" "
                elif [ $((RANDOM % 100)) -lt "$p" ]; then
                    out+="$ch"
                else
                    r=$((RANDOM % ${#chars}))
                    out+="${chars:$r:1}"
                fi
            done
            if [ "$p" -eq 30 ]; then
                printf "\r\033[K${C_DIM}%s${NC}" "$out"
            else
                printf "\r\033[K${C_FROST}%s${NC}" "$out"
            fi
            anim_pause 0.008
        done
        # settle: the real line, its own colors
        printf "\r\033[K%s\n" "$line"
        anim_pause 0.005
    done
    printf "\033[?25h"
}

