        local ver; ver=$(echo "$line" | grep -o '@"[^"]*"' | tr -d '@"')
        printf "  ${C_FROST}line %-5s${NC} →  ${C_SNOW}%s${NC}\n" "$ln" "$ver"
    done
    echo ""
    section "SoC Coverage"
    for cpu in A10 A13Above A15Above A16Above A17Above A18Above; do
        local c; c=$(grep -c "is$cpu" kexploit/offsets.m 2>/dev/null || echo 0)
        local sym="${C_GRN}✓"; [ "$c" -eq 0 ] && sym="${C_RED}✗"
        printf "  %s  %-12s  ${C_EYE}%s${NC} blocks\n" "$sym" "$cpu" "$c"
    done
    echo ""
}

