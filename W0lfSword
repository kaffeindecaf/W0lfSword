cmd_offsets() {
    $VERBOSE || spinner "scanning offsets"
    # --json (J6.2): machine-readable version blocks + SoC coverage
    if $JSON_MODE; then
        local blocks=""
        while IFS= read -r line; do
            local ln; ln=$(echo "$line" | cut -d: -f1)
            local ver; ver=$(echo "$line" | grep -o '@"[^"]*"' | head -1 | tr -d '@"')
            blocks="$blocks$ln|$ver"$'\n'
        done < <(grep -n 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO' kexploit/offsets.m 2>/dev/null)
        local socs=""
        for cpu in A10 A13Above A15Above A16Above A17Above A18Above; do
            local c; c=$(grep -c "is$cpu" kexploit/offsets.m 2>/dev/null || echo 0)
            socs="$socs$cpu:$c"$'\n'
        done
        printf '%s---SOCS---%s' "$blocks" "$socs" | python3 -c '
import sys, json
data = sys.stdin.read()
bpart, spart = data.split("---SOCS---")
blocks = []
for l in bpart.splitlines():
    if not l: continue
    ln, ver = l.split("|", 1)
    blocks.append({"line": int(ln), "version": ver})
socs = {}
for l in spart.splitlines():
    if not l: continue
    k, v = l.split(":", 1)
    socs[k] = int(v)
print(json.dumps({"version_blocks": blocks, "soc_coverage": socs, "total_blocks": len(blocks)}, indent=2))
'
        return 0
    fi
    echo ""
    section "iOS Version Blocks"
    grep -n 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO' kexploit/offsets.m 2>/dev/null | while read -r line; do
        local ln; ln=$(echo "$line" | cut -d: -f1)
        local ver; ver=$(echo "$line" | grep -o '@"[^"]*"' | head -1 | tr -d '@"')
        printf "  ${C_FROST}line %-5s${NC} →  ${C_SNOW}%s${NC}\n" "$ln" "$ver"
    done
    echo ""
    section "SoC Coverage"
    for cpu in A10 A13Above A15Above A16Above A17Above A18Above; do
        local c; c=$(grep -c "is$cpu" kexploit/offsets.m 2>/dev/null || echo 0)
        local sym="✓" sym_col="$C_GRN"; [ "$c" -eq 0 ] && { sym="✗"; sym_col="$C_RED"; }
        printf "  ${sym_col}%s${NC}  %-12s  ${C_EYE}%s${NC} blocks\n" "$sym" "$cpu" "$c"
    done
    echo ""
    # kcwatch integration: show the live verification status for the
    # most recently cached build (if kcwatch state exists locally)
    local kc_state="$DATA_DIR/kcwatch"
    if [ -f "$kc_state/t8030/state.json" ] || [ -f "$kc_state/t8110/state.json" ]; then
