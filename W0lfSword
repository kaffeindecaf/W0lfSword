        fi
        echo ""
        if $already_escaped; then
            echo -e "  ${C_GRN}Device $DEV_NAME ($IOS_VER) is jailbroken  -  the kernel exploit isn't needed; hooks + SSV bypass are active${NC}"
        else
            echo -e "  ${C_GRN}Device $DEV_NAME ($IOS_VER) is now fully exploited${NC}"
        fi
        echo -e "  ${C_DIM}SSV writes: $($ENABLE_SSV && echo 'enabled' || echo 'disabled')${NC}"
        echo ""
        disclaimer <<EOF
What you can do NOW in Filza:
  • Browse and edit ANY file on the phone  -  full filesystem access
  • Write to protected system folders: /System, /usr, /bin, /sbin
  • Change ownership/permissions of any file, hide or unhide files
  • Delete/edit without Filza's padlocks, zip/unzip anything
$PERSIST_NOTE
EOF

        # Mark success
        ssh_safe "root@$IP" "touch /var/mobile/Documents/.filza_last_success" 2>/dev/null || true

        # History
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$IP\",\"ios\":\"$IOS_VER\",\"model\":\"$DEV_MODEL\",\"result\":\"success\"}" >> "$DATA_DIR/history.json"
        log_script "adderall SUCCESS: $DEV_MODEL iOS $IOS_VER @ $IP"
    else
        banner "$C_RED" "ESCAPE NOT CONFIRMED" 44
        echo ""
        echo -e "  ${C_AMB}Tips:${NC}"
        echo -e "  • Check offsets:  ${C_FROST}./W0lfSword offsets $IOS_VER${NC}"
        echo -e "  • View full log:  ${C_FROST}./W0lfSword log 100${NC}"
        echo -e "  • Verify offsets.m covers iOS $IOS_VER and $DEV_MODEL"
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$IP\",\"ios\":\"$IOS_VER\",\"result\":\"fail\"}" >> "$DATA_DIR/history.json"
        log_script "adderall FAIL: $DEV_MODEL iOS $IOS_VER @ $IP"
        crit "adderall: escape not confirmed on $DEV_MODEL iOS $IOS_VER"
    fi
    echo ""
}

