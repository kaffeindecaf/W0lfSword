VERBOSE=false

# ── Spinner animation (0.5s) ──────────────────────────────────

spinner() {
    local msg="${1:-Working}"
    local frames=( '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏' )
    local end=$((SECONDS * 10 + 5))  # 0.5s
    while [ $((SECONDS * 10)) -lt $end ]; do
        for f in "${frames[@]}"; do
            [ $((SECONDS * 10)) -ge $end ] && break
            printf "\r  ${C_EYE}%s${NC} ${C_GREY}%s...${NC}" "$f" "$msg"
            sleep 0.05
        done
    done
    printf "\r\033[K"
}

# ── Drawing helpers ───────────────────────────────────────────

line()  { printf "${C_DIM}%s${NC}\n" "$(printf '─%.0s' $(seq 1 "$1"))"; }
hline() { line 58; }

section() {
    echo ""
    printf "  ${C_FROST}${B}%s${NC}\n" "$1"
    printf "  ${C_DIM}%s${NC}\n" "$(printf '─%.0s' $(seq 1 ${#1}))"
}

ok()   { printf "  ${C_GRN}✓${NC} %s\n" "$1"; }
err()  { printf "  ${C_RED}✗${NC} %s\n" "$1"; }
warn() { printf "  ${C_AMB}⚠${NC} %s\n" "$1"; }
info() { printf "  ${C_ICE}ℹ${NC} %s\n" "$1"; }
stage() { printf "  ${C_EYE}[%s]${NC} %s\n" "$1" "$2"; }

# ── Verbose relay ─────────────────────────────────────────────

vlog() { $VERBOSE && printf "  ${C_DIM}[v] %s${NC}\n" "$*" || true; }

