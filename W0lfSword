    if [ -n "$IP" ]; then
        ssh -i "$SSH_KEY" -o ConnectTimeout=3 -o StrictHostKeyChecking=no "root@$IP" "echo ok" 2>/dev/null | grep -q ok \
            && echo -e "  ${C_GRN}✓${NC} SSH to $IP: ok" \
