            ;;
        poc)
            cat <<'EOF'
poc — the panic-PoC lab (RESEARCH ONLY — crashes the device).
  'poc list' — catalog of PoCs with iOS targets.
  'poc sep-panic [ip]' — builds the AppleKeyStore exhaustion tool with
