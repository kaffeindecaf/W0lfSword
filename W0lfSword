# ── Exit trap — restore terminal ─────────────────────────────
cleanup() {
    tput cnorm 2>/dev/null || true   # restore cursor
    stty echo 2>/dev/null || true     # restore echo
    echo -e "\033[?25h"               # show cursor
    log_script "session ended (exit=$?)"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

# ── Fail-safe wrappers ───────────────────────────────────────
ssh_safe() {
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
        -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$@" 2>/dev/null
}
scp_safe() {
    scp -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
        "$@" 2>/dev/null
}
retry() {
    local max="${1:-3}" delay="${2:-1}" cmd="${3:-true}"
    local i=0
    while [ $i -lt "$max" ]; do
        eval "$cmd" && return 0
        i=$((i+1))
        [ $i -lt "$max" ] && sleep "$delay"
    done
    return 1
}

