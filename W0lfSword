cmd_history() {
    local action="${1:-show}"
    case "$action" in
        stats)
            section "Exploit Statistics"
            if [ -f "$DATA_DIR/history.json" ] && [ -s "$DATA_DIR/history.json" ]; then
                local total; total=$(grep -c '"result"' "$DATA_DIR/history.json" 2>/dev/null || echo 0)
                local succ; succ=$(grep -c '"success"' "$DATA_DIR/history.json" 2>/dev/null || echo 0)
                local fail=$((total - succ))
                local pct=0; [ "$total" -gt 0 ] && pct=$(( succ * 100 / total ))
                printf "  ${C_GREY}%-12s${NC} %s\n" "Attempts"   "${C_EYE}$total${NC}"
                printf "  ${C_GREY}%-12s${NC} %s\n" "Success"    "${C_GRN}$succ${NC}"
                printf "  ${C_GREY}%-12s${NC} %s\n" "Failed"     "${C_RED}$fail${NC}"
                printf "  ${C_GREY}%-12s${NC} %s%%\n" "Rate"      "$pct"
                local bar_width=30
                local filled=$((pct * bar_width / 100))
                local empty=$((bar_width - filled))
                printf "  ${C_GREY}%-12s${NC} " "Chart"
                printf "${C_GRN}"
                for ((i=0; i<filled; i++)); do printf "█"; done
                printf "${C_DIM}"
                for ((i=0; i<empty; i++)); do printf "░"; done
                printf "${NC} $pct%%\n"
            else
                echo -e "  ${C_DIM}No exploit history yet${NC}"
            fi
            ;;
        show)
            if [ -f "$DATA_DIR/history.json" ] && [ -s "$DATA_DIR/history.json" ]; then
                section "History Log"
                while IFS= read -r l; do
                    local ts; ts=$(echo "$l" | python3 -c "import sys,json;print(json.loads(sys.stdin.readline()).get('timestamp',''))" 2>/dev/null || echo "")
                    local r; r=$(echo "$l" | python3 -c "import sys,json;print(json.loads(sys.stdin.readline()).get('result',''))" 2>/dev/null || echo "")
                    local color="$C_GRN"; [ "$r" != "success" ] && color="$C_RED"
                    printf "  %s%-8s${NC} ${C_DIM}%s${NC}\n" "$color" "[$r]" "$ts"
                done < "$DATA_DIR/history.json"
            else
                echo -e "  ${C_DIM}No exploit history yet${NC}"
            fi
            ;;
        *) echo -e "${C_RED}Usage:${NC} history [stats]";;
    esac
}

# ═══════════════════════════════════════════════════════════════
#  BETA — Monitor
# ═══════════════════════════════════════════════════════════════

cmd_monitor() {
    local ip; ip=$(get_device_ip)
    [ -z "$ip" ] && { err "No device configured"; return 1; }
    echo ""; echo -e "  ${C_STEEL}${B}── Live Monitor @ $ip ── Ctrl+C to stop ────────${NC}"; echo ""
    ssh -o StrictHostKeyChecking=no "root@$ip" "tail -f /tmp/FilzaTweak.log 2>/dev/null" 2>/dev/null | while IFS= read -r l; do
        if   echo "$l" | grep -q '\*\*\*';                   then echo -e "  ${C_GRN}${B}▓▓▓ $l${NC}"
        elif echo "$l" | grep -q 'ERROR\|FAILED\|PANIC';        then echo -e "  ${C_RED}  ✗ $l${NC}"
        elif echo "$l" | grep -q 'Retry\|retry\|WARNING';      then echo -e "  ${C_AMB}  ▸ $l${NC}"
        elif echo "$l" | grep -q 'succeeded\|ESCAPED\|active=1'; then echo -e "  ${C_GRN}  ✓ $l${NC}"
        elif echo "$l" | grep -q '\[SSV\]\|\[Tweak\]\|\[SBX\]\|\[Padlock\]'; then echo -e "  ${C_FROST}  ─ $l${NC}"
        else echo -e "  ${C_DIM}  $l${NC}"; fi
    done
}

# ═══════════════════════════════════════════════════════════════
#  BETA — Quick (one-shot exploit)
# ═══════════════════════════════════════════════════════════════

cmd_quick() {
    show_header
    echo ""
    local ip; ip=$(get_device_ip)
    [ -z "$ip" ] && { err "No device — use 'device add <ip>' first."; return 1; }

    stage "1/4" "Building..."
    check_theos || { err "THEOS not set"; return 1; }
    local build_out; build_out=$(make package 2>&1)
    local ec=$?
    $VERBOSE && echo "$build_out" | tail -5
    local deb; deb=$(find_deb)
    [ $ec -ne 0 ] || [ -z "$deb" ] && { err "Build failed"; return 1; }
    ok "Built $(basename "$deb")"

    stage "2/4" "Deploying to $ip..."
    local rp="/tmp/$(basename "$deb")"
    scp -o StrictHostKeyChecking=no "$deb" "root@$ip:$rp" >/dev/null 2>&1
    ssh -o StrictHostKeyChecking=no "root@$ip" "dpkg -i '$rp' >/dev/null 2>&1; rm -f '$rp'" 2>/dev/null
    ssh -o StrictHostKeyChecking=no "root@$ip" "killall -9 Filza 2>/dev/null" 2>/dev/null || true
    ok "Deployed + restarted"

    stage "3/4" "Waiting for exploit..."
    local dots=""; for i in $(seq 1 10); do dots+="."; echo -ne "\r  ${C_EYE}[3/4]${NC} Waiting for exploit${dots}"; sleep 1; done
    echo ""

    stage "4/4" "Verifying..."
    local log; log=$(ssh -o StrictHostKeyChecking=no "root@$ip" "tail -20 /tmp/FilzaTweak.log 2>/dev/null" 2>/dev/null || echo "")
    if echo "$log" | grep -q "ESCAPED"; then
        echo ""
        echo -e "  ${C_GRN}${B}  ╔════════════════════════════════════╗${NC}"
        echo -e "  ${C_GRN}${B}  ║   SANDBOX ESCAPED — SUCCESS       ║${NC}"
        echo -e "  ${C_GRN}${B}  ╚════════════════════════════════════╝${NC}"
        echo ""
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$ip\",\"result\":\"success\"}" >> "$DATA_DIR/history.json"
    else
        echo ""
        echo -e "  ${C_RED}${B}  ╔════════════════════════════════════╗${NC}"
        echo -e "  ${C_RED}${B}  ║   ESCAPE NOT CONFIRMED             ║${NC}"
        echo -e "  ${C_RED}${B}  ╚════════════════════════════════════╝${NC}"
        echo -e "  ${C_DIM}Check logs: ./W0lfSword log${NC}"
        echo ""
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$ip\",\"result\":\"fail\"}" >> "$DATA_DIR/history.json"
        $VERBOSE && echo -e "  ${C_DIM}── Raw log tail ──${NC}\n$log\n"
    fi
}

# ═══════════════════════════════════════════════════════════════
#  INTERACTIVE MENU
# ═══════════════════════════════════════════════════════════════

draw_menu() {
    clear
    if $FIRST_DRAW; then
        show_wolf
        FIRST_DRAW=false
    fi
    show_header

    # Show device status inline
    local ip; ip=$(get_device_ip)
    if [ -n "$ip" ]; then
        local st="${C_DIM}checking...${NC}"
        ping -c1 -W1 "$ip" >/dev/null 2>&1 && st="${C_GRN}$ip online${NC}" || st="${C_AMB}$ip offline${NC}"
        echo -e "  ${C_GREY}device:${NC}  $st"
    else
        echo -e "  ${C_GREY}device:${NC}  ${C_DIM}none configured — use [d] to add${NC}"
    fi
    echo ""

    echo -e "  ${C_EYE}${B}[ 1 ]${NC}  Quick Exploit      ${C_DIM}Build → Deploy → Verify${NC}"
    echo -e "  ${C_EYE}${B}[ 2 ]${NC}  Deploy Only        ${C_DIM}Install package on device${NC}"
    echo -e "  ${C_EYE}${B}[ 3 ]${NC}  Device Manager     ${C_DIM}Add / switch / info${NC}"
    echo -e "  ${C_EYE}${B}[ 4 ]${NC}  Live Monitor       ${C_DIM}Real-time log tailing${NC}"
    echo -e "  ${C_EYE}${B}[ 5 ]${NC}  Profiles           ${C_DIM}Save / load configs${NC}"
    echo -e "  ${C_EYE}${B}[ 6 ]${NC}  History            ${C_DIM}Exploit statistics${NC}"
    echo -e "  ${C_EYE}${B}[ 7 ]${NC}  Diagnostics        ${C_DIM}Doctor · Audit · Status${NC}"
    echo -e "  ${C_EYE}${B}[ 8 ]${NC}  Targets            ${C_DIM}Supported apps${NC}"
    echo ""
    echo -e "  ${C_DIM}───${NC}"
    echo -e "  ${C_DIM}quick:${NC}  ${C_EYE}b${NC}=build  ${C_EYE}d${NC}=deploy  ${C_EYE}s${NC}=status  ${C_EYE}l${NC}=log  ${C_EYE}m${NC}=monitor  ${C_EYE}c${NC}=clean"
    echo -e "  ${C_EYE}${B}[ q ]${NC}  Quit               ${C_DIM}╱  howl later${NC}"
    echo ""
    echo -ne "  ${C_FROST}${B}W0lfSword ▸${NC} "
}

run_menu() {
    FIRST_DRAW=true
    while true; do
        draw_menu
        read -r choice
        spinner "loading"
        echo ""
        case "$choice" in
            1) cmd_quick || true;;
            2) cmd_deploy || true;;
            3) echo -e "  ${C_FROST}Device commands:${NC} list | add <ip> | switch <ip> | info [ip]"
               echo -ne "  ${C_FROST}device ▸${NC} "; read -r dcmd || true
               echo ""; cmd_device $dcmd || true;;
            4) cmd_monitor || true;;
            5) echo -e "  ${C_FROST}Profile commands:${NC} list | save <name> | load <name>"
               echo -ne "  ${C_FROST}profile ▸${NC} "; read -r pcmd || true
               echo ""; cmd_profile $pcmd || true;;
            6) { cmd_history stats; echo ""; cmd_history show; } || true;;
            7) { cmd_doctor; echo ""; cmd_audit; echo ""; cmd_status; } || true;;
            8) cmd_targets || true;;
            # Quick shortcuts
            b|B|build)    cmd_build || true;;
            d|D|deploy)   cmd_deploy || true;;
            s|S|status)   cmd_status || true;;
            l|L|log)      cmd_log 50 || true;;
            m|M|monitor)  cmd_monitor || true;;
            c|C|clean)    cmd_clean || true;;
            doctor)       cmd_doctor || true;;
            audit)        cmd_audit || true;;
            offsets)      cmd_offsets || true;;
            targets|t)    cmd_targets || true;;
            q|Q|quit|exit)
                echo ""; echo -e "  ${C_WOLF}~ howl later ~${NC}"; echo ""; exit 0;;
            *)
                echo -e "  ${C_RED}Unknown — try 1-8, b/d/s/l/m/c, or q${NC}";;
        esac
        echo ""; echo -ne "  ${C_DIM}── Press enter to continue ──${NC}"; read -r || true; echo ""
    done
}

