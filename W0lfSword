        echo -e "  ${C_DIM}↳ try: usbliter8 (SecureROM works on any iOS) or update the device${NC}"
    fi
}

# ── USB test  -  harmless connectivity + pairing checks ─────────
# Read-only round-trips over usbmuxd: pairing validation, device
# identity, a lockdown diagnostics request, and a short syslog
# capture. Proves the cable, the daemon, and the trust pairing
# all work before anything gets deployed. Writes nothing.
cmd_usbtest() {
    show_header
    echo ""
    section "USB Test  -  cable · pairing · data round-trip"
    echo -e "  ${C_DIM}Only harmless read-only requests. Nothing is written to the phone.${NC}"
    echo ""

    # usbmuxd (Linux only  -  macOS runs it as a launchd service)
    if [ "$IS_MACOS" -eq 0 ]; then
        if pgrep -x usbmuxd &>/dev/null || pgrep -f "usbmuxd" &>/dev/null; then
            ok "usbmuxd is running"
        else
            err "usbmuxd is not running"
            hint "Start it: sudo systemctl start usbmuxd   (or: usbmuxd -f -v)"
        fi
    fi

    local uuid; uuid=$(idevice_id -l 2>/dev/null | head -1 || echo "")
    if [ -z "$uuid" ]; then
        err "No device on USB"
        hint "Plug the phone in with its Lightning cable (SE/8/X/11 era  -  not USB-C)"
        hint "Straight into the computer, no hub. Charging-but-invisible = cable or port."
        if lsusb 2>/dev/null | grep -qi "05ac"; then
            hint "USB sees an Apple device but usbmuxd doesn't  -  restart: sudo systemctl restart usbmuxd"
        fi
        return 1
    fi
    echo -e "  ${C_GRN}✓${NC} Device visible on USB: ${C_EYE}$uuid${NC}"

    # pairing / trust  -  use the exit code, not output text: the success
    # wording changed between libimobiledevice versions ("is paired with
    # device" vs "Validated pairing with device").
    if idevicepair validate >/dev/null 2>&1; then
        ok "Pairing valid  -  this computer is trusted"
    else
        warn "Not paired  -  tap TRUST on the phone if it asks"
        if idevicepair pair >/dev/null 2>&1; then
            sleep 1
            if idevicepair validate >/dev/null 2>&1; then
                ok "Paired after trust prompt"
            else
                warn "Pairing recorded but validation still failing  -  try again in a moment"
            fi
        else
            err "Pairing failed  -  unlock the phone first (a passcode locks pairing), tap TRUST, then re-run: ./W0lfSword usbtest"
            return 1
        fi
    fi

    # connection type  -  idevice_id -l only lists USB devices, so a UDID
    # here already means the USB path is live. The ConnectionType key is
    # not populated on every libimobiledevice build, so don't rely on it.
    local ctype; ctype=$(ideviceinfo -k ConnectionType 2>/dev/null || echo "")
    if [ "$ctype" = "USB" ]; then
        ok "Connection is USB (Lightning cable)"
    else
        echo -e "  ${C_DIM}connection: USB (Lightning)  -  found via the USB device list${NC}"
    fi

    # identity round-trip
    local name ver model
    name=$(ideviceinfo -k DeviceName 2>/dev/null || echo "?")
    ver=$(ideviceinfo -k ProductVersion 2>/dev/null || echo "?")
    model=$(ideviceinfo -k HardwareModel 2>/dev/null || echo "?")
    echo -e "  ${C_DIM}device: ${C_EYE}$name${NC}  ${C_DIM}iOS $ver · $model${NC}"

    # harmless test request  -  lockdown diagnostics round-trip
    if command -v idevicediagnostics &>/dev/null && idevicediagnostics diagnostics All >/dev/null 2>&1; then
        ok "Lockdown diagnostics round-trip OK (read-only)"
    else
        err "Diagnostics request failed  -  the USB data path is broken"
        hint "Try another cable/port, then re-run: ./W0lfSword usbtest"
        return 1
    fi

    # short syslog capture  -  proves data flows host ← phone
    local slog_file; slog_file="$(mktemp 2>/dev/null || echo /tmp/w0lf_usbtest.$$)"
    idevicesyslog >"$slog_file" 2>/dev/null & local sp=$!
    sleep 2
    kill "$sp" 2>/dev/null || true
    wait "$sp" 2>/dev/null || true
    if [ -s "$slog_file" ]; then
        ok "Syslog stream received data over USB"
    else
        warn "Syslog was empty  -  logging may be off, not fatal"
    fi
    rm -f "$slog_file"

    # cable reliability probe (10 rapid reads)
    test_usb_cable "$uuid" || true

    echo ""
    ok "USB test finished"
    hint "Next: sudo ./W0lfSword adderall"
}

# ── Panic log analyzer ────────────────────────────────────────
# Classifies .ips crash reports / panic logs against known CVEs and
# the BUG_BOUNTY findings (BB-032..037) via scripts/panic_analyzer.py.
cmd_panic() {
    local sub="${1:-list}"
    local panics_dir="$DATA_DIR/panics"
    mkdir -p "$panics_dir"
    case "$sub" in
        list)
            section "Panic Reports ($panics_dir)"
            if compgen -G "$panics_dir/*" >/dev/null 2>&1; then
                ls -t "$panics_dir" | head -20 | while read -r f; do
                    local ts; ts=$(date -r "$panics_dir/$f" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "?")
                    echo -e "  ${C_DIM}$ts${NC}  ${C_FROST}$f${NC}"
                done
            else
                echo -e "  ${C_DIM}No panic reports yet. Fetch one with: ./W0lfSword panic fetch${NC}"
            fi
            ;;
        fetch)
            local ip="${2:-$(get_device_ip)}"
            [ -z "$ip" ] && { err "No device  -  pass an IP: ./W0lfSword panic fetch <ip>"; return 1; }
            section "Fetching latest crash report from $ip"
            local remote
            remote=$(ssh_safe "root@$ip" 'ls -t /var/mobile/Library/Logs/CrashReporter/*.ips /Library/Logs/CrashReporter/*.ips 2>/dev/null | head -1' 2>/dev/null || echo "")
            if [ -z "$remote" ]; then
                err "No .ips found on the device"
                return 1
            fi
            local base; base=$(basename "$remote")
            if scp_safe "root@$ip:$remote" "$panics_dir/$base" 2>/dev/null; then
                ok "Saved $base"
            else
                err "scp failed"
                return 1
            fi
            echo ""
            cmd_panic analyze "$panics_dir/$base"
            ;;
        analyze)
            local f="${2:-}"
            [ -z "$f" ] && { err "Usage: ./W0lfSword panic analyze <file.ips|panic.log>"; return 1; }
            [ -f "$f" ] || { err "No such file: $f"; return 1; }
            section "Analyzing $(basename "$f")"
            echo ""
            python3 "$PROJECT_DIR/scripts/panic_analyzer.py" "$f" || true
            ;;
        *)
            err "Usage: panic list | fetch [ip] | analyze <file>"
            return 1
            ;;
    esac
}

# ── Kernelcache research  -  offline XPF offset work (K4.1 CLI) ─
# resolve/diff kernelcaches with the host-side XPF patchfinder,
# no device needed. The attractive one for iOS security researchers.
kernelcache_xpf() {
    local kc="${1:-}"
    local bin="$PROJECT_DIR/tools/xpf-cli/xpf-cli"
    if [ ! -x "$bin" ]; then
        err "xpf-cli not built"
        hint "Build it: cd tools/xpf-cli && ./build.sh   (needs clang + lzfse)"
        return 1
    fi
    if ! "$bin" "$kc" 2>/dev/null; then
        err "XPF could not parse: $kc"
        hint "Expected an IMG4 kernelcache (A12+ are unencrypted). Extract one from an IPSW: ./W0lfSword kernelcache extract <file.ipsw>"
        return 1
    fi
}

cmd_kernelcache() {
    local sub="${1:-help}"
    case "$sub" in
        resolve)
            local kc="${2:-}"
            [ -z "$kc" ] && { err "Usage: ./W0lfSword kernelcache resolve <kernelcache.img4>"; return 1; }
            [ -f "$kc" ] || { err "No such file: $kc"; return 1; }
            section "XPF resolve  -  $(basename "$kc")"
            echo ""
            kernelcache_xpf "$kc" || return 1
            ;;
        diff)
            local a="${2:-}" b="${3:-}"
            [ -z "$a" ] || [ -z "$b" ] && { err "Usage: ./W0lfSword kernelcache diff <kcA> <kcB>"; return 1; }
            [ -f "$a" ] && [ -f "$b" ] || { err "Both kernelcaches must exist"; return 1; }
            local tmpa tmpb
            tmpa=$(mktemp 2>/dev/null || echo /tmp/w0lf_xpf_a.$$)
            tmpb=$(mktemp 2>/dev/null || echo /tmp/w0lf_xpf_b.$$)
            section "XPF diff  -  $(basename "$a") vs $(basename "$b")"
            echo ""
            if ! kernelcache_xpf "$a" > "$tmpa" 2>/dev/null; then rm -f "$tmpa" "$tmpb"; return 1; fi
            if ! kernelcache_xpf "$b" > "$tmpb" 2>/dev/null; then rm -f "$tmpa" "$tmpb"; return 1; fi
            python3 "$PROJECT_DIR/scripts/xpf_diff.py" "$tmpa" "$tmpb"
            rm -f "$tmpa" "$tmpb"
            ;;
        extract)
            local ipsw="${2:-}"
            [ -z "$ipsw" ] && { err "Usage: ./W0lfSword kernelcache extract <file.ipsw> [board]"; return 1; }
            [ -f "$ipsw" ] || { err "No such file: $ipsw"; return 1; }
            local board="${3:-}"
            local outdir="$DATA_DIR/kernelcaches"
            mkdir -p "$outdir"
            section "Extracting kernelcache from $(basename "$ipsw")"
            echo ""
            python3 - "$ipsw" "$board" "$outdir" <<'PYEOF'
import sys, zipfile, os, re
ipsw, board, outdir = sys.argv[1], sys.argv[2] or None, sys.argv[3]
try:
    z = zipfile.ZipFile(ipsw)
except Exception as e:
    print(f"ERR not a readable zip: {e}"); sys.exit(1)
cands = [n for n in z.namelist() if re.search(r"kernelcache\.release", n)]
if not cands:
    print("ERR no kernelcache.release.* entry in IPSW"); sys.exit(1)
if board:
    cands = [n for n in cands if board.lower() in n.lower()]
    if not cands:
        print(f"ERR no kernelcache entry matching board {board}"); sys.exit(1)
name = cands[0]
data = z.read(name)
out = os.path.join(outdir, os.path.basename(name))
with open(out, "wb") as fh:
    fh.write(data)
print(f"OK {name} -> {out} ({len(data)} bytes)")
PYEOF
            local got; got=$(ls -t "$outdir"/* 2>/dev/null | head -1 || echo "")
            if [ -n "$got" ] && [ -f "$got" ] && confirm "Resolve offsets with XPF now?"; then
                echo ""
                cmd_kernelcache resolve "$got"
            fi
            ;;
        *)
            cat <<'EOF'
kernelcache  -  offline XPF offset research, no device needed.
  resolve <kernelcache.img4>   run the XPF patchfinder, print offsets
  diff <kcA> <kcB>             resolve both, show identical/changed items
  extract <file.ipsw> [board]  pull kernelcache.release.* out of an IPSW

  Verify offsets for any iOS build against kexploit/offsets.m before
  touching hardware  -  the K4.1 methodology as a command. Feed it the
  IMG4 kernelcache from an IPSW (A12+ are unencrypted; XPF handles
  IMG4 + LZFSE decompression). IPSWs: https://ipsw.me
EOF
                        ;;
    esac
}

