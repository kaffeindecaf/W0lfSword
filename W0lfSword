    echo -e "  ${C_DIM}Detected: ${C_EYE}$OS_NAME  -  ${pkg_manager}${NC}"
    echo ""

    # macOS: clang comes from Xcode Command Line Tools, not brew.
    if [ "$IS_MACOS" -eq 1 ]; then
