cmd_device() {
    local action="${1:-list}" arg="${2:-}"
    case "$action" in
        add)
            [ -z "$arg" ] && { echo -e "${C_RED}Usage:${NC} device add <ip> [--name <label>]"; return 1; }
            local dname="${3:-$arg}"
            echo "$arg" > "$DATA_DIR/active_device"
            grep -q "^$arg " "$DATA_DIR/devices.list" 2>/dev/null || echo "$arg $dname" >> "$DATA_DIR/devices.list"
            ok "Device added: ${C_EYE}$arg${NC} ($dname)"
            ;;
        switch)
            [ -z "$arg" ] && { err "Usage: device switch <ip>"; return 1; }
            echo "$arg" > "$DATA_DIR/active_device"
            ok "Active device: ${C_EYE}$arg${NC}"
            ;;
        list)
            section "Devices"
            local active; active=$(get_device_ip)
            if [ -f "$DATA_DIR/devices.list" ] && [ -s "$DATA_DIR/devices.list" ]; then
                sort -u "$DATA_DIR/devices.list" | while read -r dip dname; do
                    local m=" "; [ "$dip" = "$active" ] && m="*"
                    local st="online" st_col="$C_GRN"
                    ping_check "$dip" || { st="offline"; st_col="$C_DIM"; }
                    printf "  %s ${C_EYE}%-17s${NC} ${st_col}%-10s${NC} %s\n" "$m" "$dip" "$st" "$dname"
                done
            else
                echo -e "  ${C_DIM}No devices. Use 'device add <ip>'${NC}"
            fi
            ;;
        info)
            local dip="${arg:-$(get_device_ip)}"
            [ -z "$dip" ] && { err "No device"; hint "Connect via USB or: ./W0lfSword device add <ip>"; return 1; }
            $VERBOSE || spinner "querying $dip"
            if ssh -i "$SSH_KEY" -o ConnectTimeout=3 -o StrictHostKeyChecking=no "root@$dip" "echo ok" 2>/dev/null | grep -q ok; then
                section "Device Info"
                local ios; ios=$(ssh_safe "root@$dip" "sw_vers -productVersion" 2>/dev/null || echo "?")
                local mdl; mdl=$(ssh_safe "root@$dip" "sysctl -n hw.machine" 2>/dev/null || echo "?")
                local krn; krn=$(ssh_safe "root@$dip" "sysctl -n kern.osversion" 2>/dev/null || echo "?")
                printf "  ${C_GREY}%-10s${NC} %s\n" "iOS"     "$ios"
                printf "  ${C_GREY}%-10s${NC} %s\n" "Model"   "$mdl"
                printf "  ${C_GREY}%-10s${NC} %s\n" "Kernel"  "$krn"
                printf "  ${C_GREY}%-10s${NC} %s\n" "IP"      "$dip"
            else
                err "Cannot reach $dip"
            fi
            ;;
        *) echo -e "${C_RED}Usage:${NC} device add|list|switch|info [ip]";;
    esac
}

# ═══════════════════════════════════════════════════════════════
#  BETA  -  History
# ═══════════════════════════════════════════════════════════════

cmd_history() {
    local action="${1:-show}"
    case "$action" in
        stats)
            section "Exploit Statistics"
            if [ -f "$DATA_DIR/history.json" ] && [ -s "$DATA_DIR/history.json" ]; then
                local total; total=$(grep -c '"result"' "$DATA_DIR/history.json" 2>/dev/null || echo 0)
                local succ; succ=$(grep -c '"success"' "$DATA_DIR/history.json" 2>/dev/null || echo 0)
                local fail=$((total - succ))
                local pct=0; [ "$total" -gt 0 ] && pct=$(( succ * 100 / total ))
                printf "  ${C_GREY}%-12s${NC} %s\n" "Attempts"   "${C_EYE}$total${NC}"
                printf "  ${C_GREY}%-12s${NC} %s\n" "Success"    "${C_GRN}$succ${NC}"
                printf "  ${C_GREY}%-12s${NC} %s\n" "Failed"     "${C_RED}$fail${NC}"
                printf "  ${C_GREY}%-12s${NC} %s%%\n" "Rate"      "$pct"
                local bar_width=30
                local filled=$((pct * bar_width / 100))
                local empty=$((bar_width - filled))
                printf "  ${C_GREY}%-12s${NC} " "Chart"
                printf "${C_GRN}"
                for ((i=0; i<filled; i++)); do printf "█"; done
                printf "${C_DIM}"
                for ((i=0; i<empty; i++)); do printf "░"; done
                printf "${NC} $pct%%\n"
            else
                echo -e "  ${C_DIM}No exploit history yet${NC}"
            fi
            ;;
        show)
            if [ -f "$DATA_DIR/history.json" ] && [ -s "$DATA_DIR/history.json" ]; then
                section "History Log"
                while IFS= read -r l; do
                    local ts; ts=$(echo "$l" | python3 -c "import sys,json;print(json.loads(sys.stdin.readline()).get('timestamp',''))" 2>/dev/null || echo "")
                    local r; r=$(echo "$l" | python3 -c "import sys,json;print(json.loads(sys.stdin.readline()).get('result',''))" 2>/dev/null || echo "")
                    local color="$C_GRN"; [ "$r" != "success" ] && color="$C_RED"
                    printf "  %s%-8s${NC} ${C_DIM}%s${NC}\n" "$color" "[$r]" "$ts"
                done < "$DATA_DIR/history.json"
            else
                echo -e "  ${C_DIM}No exploit history yet${NC}"
            fi
            ;;
        *) echo -e "${C_RED}Usage:${NC} history [stats]";;
    esac
}

