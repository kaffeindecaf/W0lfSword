    echo ""
    section "W0lfSword Setup  -  Install Dependencies"
    echo ""
    disclaimer <<EOF
In plain English: this installs build tools on THIS COMPUTER (clang, dpkg,
THEOS, SSH). Nothing is installed on the phone. The phone only needs to be
jailbroken, have OpenSSH running, and have Filza already installed.
EOF
    # Linux needs root for apt; macOS must NOT be root for brew (brew
    # refuses to run as root)  -  sudo is only used for /opt/theos there.
    if [ "$EUID" -ne 0 ] && [ "$IS_MACOS" -eq 0 ]; then
        err "Run with sudo: sudo ./W0lfSword setup"
