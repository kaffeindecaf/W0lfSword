check_theos() {
    # Try env var, then common paths
    [ -n "${THEOS:-}" ] && [ -d "$THEOS" ] && return 0
    for d in "$HOME/theos" /opt/theos /usr/local/theos "$PROJECT_DIR/.theos" \
             /opt/homebrew/theos /opt/homebrew/share/theos /usr/local/share/theos; do
        [ -d "$d/makefiles" ] && { export THEOS="$d"; vlog "THEOS auto-detected at $d"; return 0; }
    done
    # Under sudo, $HOME might be /root — also check the original user's home
    if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ]; then
        local sudo_home; sudo_home=$(eval echo "~$SUDO_USER" 2>/dev/null)
        [ -n "$sudo_home" ] && [ -d "$sudo_home/theos/makefiles" ] && {
            export THEOS="$sudo_home/theos"
            vlog "THEOS auto-detected at $THEOS (via sudo user)"
            return 0
        }
    fi
    return 1
}

find_deb() { ls -t packages/*.deb 2>/dev/null | head -1; }

get_device_ip() {
    [ -n "${1:-}" ] && echo "$1" && return 0
    local a; a=$(cat "$DATA_DIR/active_device" 2>/dev/null || echo "")
