    local inner=$((w - 2))
    local pad=$(( (inner - ${#txt}) / 2 )); [ "$pad" -lt 0 ] && pad=0
    local l r; l=$(repeat_char ' ' "$pad"); r=$(repeat_char ' ' "$((inner - pad - ${#txt}))")
    printf "  ${col}${B}╔%s╗${NC}\n" "$(repeat_char '═' "$w")"
    printf "  ${col}${B}║${NC} ${col}${B}%s${NC} ${col}${B}║${NC}\n" "${l}${txt}${r}"
    printf "  ${col}${B}╚%s╝${NC}\n" "$(repeat_char '═' "$w")"
}

