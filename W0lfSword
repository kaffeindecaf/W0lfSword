        return 0
    fi
    local dots=""
    for ((i=0; i<12; i++)); do
        dots+="."
        printf "\r  ${C_EYE}[3/5]${NC} Waiting for exploit${dots}"
        sleep 1
    done
    echo ""

    stage "4/5" "Verifying sandbox escape... (reading phone logs)"
    local log; log=$(ssh_safe "root@$IP" "tail -30 /tmp/FilzaTweak.log 2>/dev/null" 2>/dev/null || echo "")
    $DEBUG && echo -e "  ${C_DIM}── Log tail ──${NC}\n$log\n  ${C_DIM}──────────────${NC}"

    stage "5/5" "Final result..."
    echo ""

    if echo "$log" | grep -qE "ESCAPED|already escaped"; then
        local already_escaped=false
        echo "$log" | grep -q "already escaped" && ! echo "$log" | grep -q "ESCAPED" && already_escaped=true
        if $already_escaped; then
            banner "$C_GRN" "SANDBOX ALREADY ESCAPED (jailbroken)" 44
