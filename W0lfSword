# version comparisons on top of version_sort_first (returns the smaller)
ver_ge() { [ "$(version_sort_first "$1" "$2")" = "$2" ]; }  # $1 >= $2
ver_le() { [ "$(version_sort_first "$1" "$2")" = "$1" ]; }  # $1 <= $2

soc_match() {
    local model="$1" pat="$2"
    case "$pat" in
        A12+)     case "$model" in iPhone1[1-8],*|iPad8,*|iPad11,*|iPad1[3-6],*) return 0;; esac;;
        A18)      case "$model" in iPhone17,*) return 0;; esac;;
        A19)      case "$model" in iPhone18,*) return 0;; esac;;
        M5)       case "$model" in iPad17,*) return 0;; esac;;
        A9-A11)   case "$model" in iPhone8,*|iPhone9,*|iPhone10,*) return 0;; esac;;
        A10+)     case "$model" in iPhone[89],*|iPhone10,*|iPhone1[1-8],*|iPad8,*|iPad11,*|iPad1[3-6],*) return 0;; esac;;
        A12-A13)  case "$model" in iPhone1[1-2],*) return 0;; esac;;
        *)        [ "$pat" = "*" ] && return 0;;
    esac
    return 1
}

# Print the per-device compatibility picture: green = supported here,
# amber = pending/research, red = blocked (the "don't use this exploit
# here" warnings). Used by adderall right after device detection.
exploit_compat_check() {
    local ios="$1" model="$2"
    [ -n "$ios" ] || return 0
    while IFS='|' read -r lo hi soc id name status note; do
        [ -n "$id" ] || continue
        [ "$lo" = "*" ] || ver_ge "$ios" "$lo" || continue
        [ "$hi" = "*" ] || ver_le "$ios" "$hi" || continue
        soc_match "$model" "$soc" || continue
        case "$status" in
            implemented) echo -e "  ${C_GRN}✓${NC} ${name}"; [ -n "$note" ] && echo -e "    ${C_DIM}note: ${note}${NC}";;
            pending)     echo -e "  ${C_AMB}◌${NC} ${name}  -  ${note:-not ported yet}";;
            research)    echo -e "  ${C_AMB}◌${NC} ${name}  -  ${note:-research only}";;
            blocked)     echo -e "  ${C_RED}✗${NC} ${name}  -  ${note:-blocked on this device}";;
        esac
    done < <(exploit_matrix)
    return 0
}

soc_family() {
    case "$1" in
        iPhone8,*|iPhone9,*|iPhone10,*) echo "A9-A11";;
        iPhone1[1-6],*)  echo "A12-A16";;
        iPhone17,*)      echo "A17";;
        iPhone18,*)      echo "A18";;
        iPad1[1-9],*)    echo "M1-M4";;
        *)               echo "unknown";;
    esac
}

# ── USB cable reliability probe ───────────────────────────────
# Reads the device 10 times over usbmuxd. A good cable never misses;
# a flaky one drops reads or the device disappears mid-test.
test_usb_cable() {
    local uuid="${1:-}"
    [ -n "$uuid" ] || return 1
    local ok=0 tries=10 i
    for ((i=0; i<tries; i++)); do
        local cur; cur=$(idevice_id -l 2>/dev/null | head -1 || echo "")
        if [ "$cur" != "$uuid" ]; then
            err "Device disappeared from USB on read $((i+1))/$tries  -  flaky cable or port"
            hint "Try a different cable/port. Short, MFI-certified cable straight into the computer (no hub)."
            return 1
        fi
        ideviceinfo -k ProductVersion >/dev/null 2>&1 && ok=$((ok+1))
        sleep 0.1
    done
    if [ "$ok" -ge 9 ]; then
        ok "USB cable looks good ($ok/$tries reads)"
    elif [ "$ok" -ge 6 ]; then
        warn "Cable is flaky ($ok/$tries reads)  -  swap the cable if deploys fail"
    else
        err "Bad USB connection ($ok/$tries reads)  -  try another cable before deploying"
        hint "Short MFI-certified cable, direct port (no hub), no extension dongles."
    fi
    return 0
}

# ── What you can do on this iOS version ───────────────────────
# Gray hint lines under the detected device: which features work
# on that exact iOS version. Version-aware, no device access.
ios_recommendations() {
    local ios="${1:-}"
    [ -n "$ios" ] || return 0
    if [ "$(version_sort_first "$ios" "26.1")" = "26.1" ]; then
        echo -e "  ${C_DIM}↳ iOS $ios: kernel exploit capped (DarkSword patched in 26.1)${NC}"
        echo -e "  ${C_DIM}↳ still works: userspace container access (MCM), bad_query read-escape, safe mode${NC}"
        echo -e "  ${C_DIM}↳ try: mha / fuzz (hunt a new bug) / usbliter8 (tethered bootchain, any iOS)${NC}"
    elif [ "$(version_sort_first "$ios" "17.0")" = "17.0" ]; then
        echo -e "  ${C_DIM}↳ iOS $ios: full support  -  kernel exploit, sandbox escape, SSV writes, root${NC}"
        echo -e "  ${C_DIM}↳ try: adderall  -  the exploit usually wins within a few tries${NC}"
    else
