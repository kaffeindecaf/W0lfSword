}

# ── USB cable reliability probe ───────────────────────────────
# Reads the device 10 times over usbmuxd. A good cable never misses;
# a flaky one drops reads or the device disappears mid-test.
test_usb_cable() {
    local uuid="${1:-}"
    [ -n "$uuid" ] || return 1
    local ok=0 tries=10 i
    for ((i=0; i<tries; i++)); do
        local cur; cur=$(idevice_id -l 2>/dev/null | head -1 || echo "")
        if [ "$cur" != "$uuid" ]; then
            err "Device disappeared from USB on read $((i+1))/$tries — flaky cable or port"
            hint "Try a different cable/port. Short, MFI-certified cable straight into the computer (no hub)."
            return 1
        fi
        ideviceinfo -k ProductVersion >/dev/null 2>&1 && ok=$((ok+1))
        sleep 0.1
    done
    if [ "$ok" -ge 9 ]; then
        ok "USB cable looks good ($ok/$tries reads)"
    elif [ "$ok" -ge 6 ]; then
        warn "Cable is flaky ($ok/$tries reads) — swap the cable if deploys fail"
    else
        err "Bad USB connection ($ok/$tries reads) — try another cable before deploying"
        hint "Short MFI-certified cable, direct port (no hub), no extension dongles."
    fi
    return 0
}

