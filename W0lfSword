cmd_quick() {
    show_header
    echo ""
    disclaimer <<EOF
One button: compile the tweak on this computer, install it on the phone,
restart Filza, wait for the kernel exploit, and check the result.
$FILZA_NOTE
$JAILBREAK_NOTE
$PERSIST_NOTE
EOF
    local ip; ip=$(get_device_ip)
    [ -z "$ip" ] && { err "No device  -  use 'device add <ip>' first."; hint "Example: ./W0lfSword device add 192.168.1.50"; return 1; }

    stage "1/4" "Building... (on this computer)"
    check_theos || { err "THEOS not set"; hint "Install it with: sudo ./W0lfSword setup (then doctor to verify)"; return 1; }
    local build_out; build_out=$(make package 2>&1)
    local ec=$?
    $VERBOSE && echo "$build_out" | tail -5
    local deb; deb=$(find_deb)
    [ $ec -ne 0 ] || [ -z "$deb" ] && { err "Build failed"; hint "Run './W0lfSword doctor' to see which tool is missing  -  it's almost always THEOS or the iOS SDK."; return 1; }
    ok "Built $(basename "$deb")"

    stage "2/4" "Deploying to $ip... (phone)"
    local rp; rp="/tmp/$(basename "$deb")"
    scp_safe "$deb" "root@$ip:$rp" >/dev/null 2>&1
    ssh_safe "root@$ip" "dpkg -i '$rp' >/dev/null 2>&1; rm -f '$rp'" 2>/dev/null
    ssh_safe "root@$ip" "killall -9 Filza 2>/dev/null" 2>/dev/null || true
    ok "Deployed + restarted"

    stage "3/4" "Waiting for exploit... (phone is working)"
    local dots=""; for ((i=0; i<10; i++)); do dots+="."; echo -ne "\r  ${C_EYE}[3/4]${NC} Waiting for exploit${dots}"; sleep 1; done
    echo ""

    stage "4/4" "Verifying... (reading phone logs)"
    local log; log=$(ssh_safe "root@$ip" "tail -20 /tmp/FilzaTweak.log 2>/dev/null" 2>/dev/null || echo "")
    if echo "$log" | grep -q "ESCAPED"; then
        echo ""
        banner "$C_GRN" "SANDBOX ESCAPED - SUCCESS" 36
        echo ""
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$ip\",\"result\":\"success\"}" >> "$DATA_DIR/history.json"
    else
        echo ""
        banner "$C_RED" "ESCAPE NOT CONFIRMED" 36
        echo -e "  ${C_DIM}Check logs: ./W0lfSword log${NC}"
        echo ""
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$ip\",\"result\":\"fail\"}" >> "$DATA_DIR/history.json"
        $VERBOSE && echo -e "  ${C_DIM}── Raw log tail ──${NC}\n$log\n"
    fi
}

