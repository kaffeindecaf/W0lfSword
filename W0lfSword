# THE internal list: what phones + iOS versions support what exploit or
# chain. Rows: min|max|soc|id|name|status|note. "*" = any.
#   min/max: iOS range the row applies to
#   soc:     model pattern (A12+, A18, A19, A9-A11, A10+, A12-A13, M5, *)
#   status:  implemented | pending | research | blocked
exploit_matrix() {
    cat <<'EOF'
