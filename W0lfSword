    ssh_safe "root@$IP" "uiopen '$TARGET_BUNDLE' 2>/dev/null; sleep 2; ps ax -o comm= 2>/dev/null | grep -qx Filza || { [ -n '$filza_bin' ] && nohup env HOME=/var/mobile '$filza_bin' >/dev/null 2>&1 & }" 2>/dev/null || true
