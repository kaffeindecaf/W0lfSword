# ═══════════════════════════════════════════════════════════════
#  UTILITY FUNCTIONS
# ═══════════════════════════════════════════════════════════════

check_theos() {
    if [ -z "${THEOS:-}" ]; then
        if [ -d "$HOME/theos" ]; then
            export THEOS="$HOME/theos"
        else
            echo -e "  ${ICON_ERR} THEOS not set and ~/theos not found"
            return 1
        fi
    fi
    return 0
}

find_deb() {
    ls -t packages/*.deb 2>/dev/null | head -1
}

get_device_ip() {
    if [ -n "${1:-}" ]; then
        echo "$1"
        return 0
    fi
    if [ -f "$PROJECT_DIR/.device_ip" ]; then
        cat "$PROJECT_DIR/.device_ip"
        return 0
    fi
    echo ""
}

step_ok()   { echo -e "  ${ICON_OK} $1"; }
step_info() { echo -e "  ${ICON_INFO} $1"; }
step_warn() { echo -e "  ${ICON_WARN} $1"; }
step_err()  { echo -e "  ${ICON_ERR} $1"; }
step_hdr()  { echo -e ""; echo -e "  ${CLR_FROST}${BOLD}$1${NC}"; echo -e "  ${CLR_STEEL}$(printf '─%.0s' $(seq 1 ${#1}))${NC}"; }

# ═══════════════════════════════════════════════════════════════
#  COMMAND: build
# ═══════════════════════════════════════════════════════════════

cmd_build() {
    show_banner_mini "compiling..."
    check_theos || exit 1

    echo ""
    step_hdr "W0lfSword Build"

    if make package 2>&1 | tail -6; then
        local deb
        deb=$(find_deb)
        if [ -n "$deb" ]; then
            echo ""
            step_ok "Build successful"
            step_info "Package: $(basename "$deb") ($(du -h "$deb" | cut -f1))"
        else
            step_warn "Build completed but no .deb found in packages/"
        fi
    else
        echo ""
        step_err "Build failed — check output above"
        step_info "Run ${CLR_FROST}./W0lfSword doctor${NC} to diagnose"
        exit 1
    fi
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: extract
# ═══════════════════════════════════════════════════════════════

cmd_extract() {
    show_banner_mini "extracting dylib..."
    echo ""

    local deb
    deb=$(find_deb)
    if [ -z "$deb" ]; then
        step_err "No .deb found — run ${CLR_FROST}./W0lfSword build${NC} first"
        exit 1
    fi

    step_info "Source: $(basename "$deb")"
    local extract_dir="/tmp/w0lf_extract_$$"
    mkdir -p "$extract_dir"
    dpkg-deb -x "$deb" "$extract_dir/" 2>/dev/null
    dpkg-deb -e "$deb" "$extract_dir/DEBIAN/" 2>/dev/null

    local dylib
    dylib=$(find "$extract_dir" -name '*.dylib' -type f 2>/dev/null | head -1)
    if [ -z "$dylib" ]; then
        step_err "No .dylib found in package"
        rm -rf "$extract_dir"
        exit 1
    fi

    cp "$dylib" "$PROJECT_DIR/W0lfSword.dylib"
    step_ok "Extracted: W0lfSword.dylib ($(du -h W0lfSword.dylib | cut -f1))"

    local ftype
    ftype=$(file W0lfSword.dylib 2>/dev/null | cut -d: -f2-)
    [ -n "$ftype" ] && step_info "Type: $ftype"

    rm -rf "$extract_dir"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: deploy
# ═══════════════════════════════════════════════════════════════

cmd_deploy() {
    local device_ip
    device_ip=$(get_device_ip "${1:-}")

    if [ -z "$device_ip" ]; then
        step_err "No device IP specified"
        echo -e ""
        echo -e "  ${CLR_FROST}Usage:${NC} ./W0lfSword deploy 192.168.1.5"
        echo -e "  ${DIM}Or save once: echo '192.168.1.5' > .device_ip${NC}"
        exit 1
    fi

    show_banner_mini "deploying to ${CLR_EYE}$device_ip${NC}..."
    echo ""

    # SSH check
    if ! ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "root@$device_ip" "echo ok" 2>/dev/null | grep -q ok; then
        step_err "Cannot SSH to root@$device_ip"
        step_info "Make sure OpenSSH is installed and device is on same network"
        exit 1
    fi
    step_ok "SSH connected"

    local deb
    deb=$(find_deb)
    if [ -z "$deb" ]; then
        step_err "No .deb found — run ${CLR_FROST}./W0lfSword build${NC} first"
        exit 1
    fi

    echo ""
    step_hdr "Transfer"

    local remote_path="/tmp/$(basename "$deb")"
    if scp -o StrictHostKeyChecking=no "$deb" "root@$device_ip:$remote_path" 2>/dev/null; then
        step_ok "Copied $(basename "$deb")"
    else
        step_err "scp transfer failed"
        exit 1
    fi

    step_hdr "Install"
    local install_out
    install_out=$(ssh -o StrictHostKeyChecking=no "root@$device_ip" "dpkg -i '$remote_path' 2>&1; rm -f '$remote_path'")
    echo -e "  ${DIM}$install_out${NC}"
    step_ok "Package installed"

    step_hdr "Activate"
    ssh -o StrictHostKeyChecking=no "root@$device_ip" "killall -9 Filza 2>/dev/null; echo ok" >/dev/null 2>&1
    step_ok "Process restarted — open app on device"

    echo "$device_ip" > "$PROJECT_DIR/.device_ip"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: status
# ═══════════════════════════════════════════════════════════════

cmd_status() {
    show_banner

    # Git
    local branch dirty
    branch=$(git branch --show-current 2>/dev/null || echo "?")
    if git diff --quiet 2>/dev/null; then
        dirty="${CLR_GREEN}clean${NC}"
    else
        dirty="${CLR_AMBER}dirty${NC}"
    fi

    # Build
    local deb dylib
    deb=$(find_deb)
    dylib=$(find . -name '*.dylib' -not -path './.theos/*' -type f 2>/dev/null | head -1)

    # Device
    local dev_status="${DIM}not configured${NC}"
    if [ -f "$PROJECT_DIR/.device_ip" ]; then
        local saved_ip
        saved_ip=$(cat "$PROJECT_DIR/.device_ip")
        if ping -c1 -W1 "$saved_ip" 2>/dev/null | grep -q '1 received'; then
            dev_status="${CLR_GREEN}$saved_ip reachable${NC}"
        else
            dev_status="${CLR_AMBER}$saved_ip (offline)${NC}"
        fi
    fi

    # ROADMAP
    local done=0 total=0 pct=0
    if [ -f ROADMAP.md ]; then
        done=$(grep -c '\[x\]' ROADMAP.md 2>/dev/null || echo 0)
        total=$(grep -c '\- \[.\]' ROADMAP.md 2>/dev/null || echo 0)
        [ "$total" -gt 0 ] && pct=$(( done * 100 / total ))
    fi

    echo -e "  ${CLR_FROST}${BOLD}System${NC}"
    echo -e "  ${DIM}────────────────────────────────────────────${NC}"
    echo -e "  Git:      branch=${CLR_EYE}$branch${NC}  ($dirty)"
    if [ -n "$deb" ]; then
        local age=$(( ($(date +%s) - $(stat -c %Y "$deb" 2>/dev/null || stat -f %m "$deb" 2>/dev/null || echo 0)) / 60 ))
        echo -e "  Build:    ${CLR_GREEN}$(basename "$deb")${NC} (${age}m ago)"
    else
        echo -e "  Build:    ${CLR_BLOOD}not built${NC}"
    fi
    if [ -n "$dylib" ]; then
        echo -e "  Dylib:    ${CLR_FROST}$dylib${NC} ($(du -h "$dylib" | cut -f1))"
    fi
    echo ""

    echo -e "  ${CLR_FROST}${BOLD}Device${NC}"
    echo -e "  ${DIM}────────────────────────────────────────────${NC}"
    echo -e "  Target:   $dev_status"
    echo ""

    echo -e "  ${CLR_FROST}${BOLD}Progress${NC}"
    echo -e "  ${DIM}────────────────────────────────────────────${NC}"
    echo -e "  ROADMAP:  ${CLR_EYE}$done/$total${NC} done (${pct}%)"
    echo -e "  Docs:     $(find . -maxdepth 1 -name '*.md' | wc -l) markdown files, $(find . -maxdepth 1 -name '*.sh' | wc -l) scripts"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: audit
# ═══════════════════════════════════════════════════════════════

cmd_audit() {
    show_banner_mini "running static analysis..."
    echo ""

    local issues=0

    step_hdr "Brace Balance"
    for f in Tweak.m sandbox_escape.m kexploit/sandbox.m kexploit/offsets.m \
             kexploit/kexploit_opa334.m kexploit/vnode.m utils/permission_utils.m \
             FilzaPadlockBypass.xm SSV/SSVUtils.m; do
        [ ! -f "$f" ] && continue
        local result
        result=$(python3 -c "
b=0; p=0
for c in open('$f').read():
    if c=='{': b+=1
    elif c=='}': b-=1
    elif c=='(': p+=1
    elif c==')': p-=1
print(b,p)
" 2>/dev/null || echo "? ?")
        local b=$(echo "$result" | awk '{print $1}')
        local p=$(echo "$result" | awk '{print $2}')
        if [ "$b" = "0" ] && [ "$p" = "0" ]; then
            echo -e "    ${ICON_OK} $f" 
        else
            echo -e "    ${ICON_ERR} $f (braces=$b parens=$p)"
            ((issues++)) || true
        fi
    done
    echo ""

    step_hdr "printf → TweakLog"
    local printf_count
    printf_count=$(grep -r 'printf(' kexploit/*.m kpf/*.m utils/*.c 2>/dev/null | grep -v '//printf\|snprintf' | wc -l || echo 0)
    if [ "$printf_count" -gt 0 ]; then
        echo -e "    ${ICON_WARN} $printf_count printf() calls not yet converted"
        local main_count=$(grep -c 'printf(' kexploit/kexploit_opa334.m 2>/dev/null || echo 0)
        echo -e "    ${DIM}  kexploit_opa334.m: $main_count calls${NC}"
    else
        echo -e "    ${ICON_OK} All printf() converted to TweakLog()"
    fi
    echo ""

    step_hdr "Kernel R/W Safety"
    local kread_sites
    kread_sites=$(grep -rn 'kread64(' kexploit/ sandbox_escape.m SSV/ utils/ 2>/dev/null | wc -l || echo 0)
    echo -e "    ${ICON_INFO} $kread_sites kread64() call sites (manual PAC review needed)"
    echo ""

    if [ "$issues" -eq 0 ]; then
        echo -e "  ${CLR_GREEN}${BOLD}Audit passed${NC}"
    else
        echo -e "  ${CLR_BLOOD}${BOLD}Audit found $issues issue(s)${NC}"
    fi
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: log
# ═══════════════════════════════════════════════════════════════

cmd_log() {
    local device_ip lines
    device_ip=$(get_device_ip "${2:-}")
    lines="${1:-50}"

    if [ -z "$device_ip" ]; then
        step_err "No device configured — use ${CLR_FROST}./W0lfSword deploy <ip>${NC} first"
        exit 1
    fi

    show_banner_mini "fetching last $lines lines from ${CLR_EYE}$device_ip${NC}..."
    echo ""

    ssh -o StrictHostKeyChecking=no "root@$device_ip" \
        "tail -$lines /tmp/FilzaTweak.log 2>/dev/null || echo '(no log yet)'" \
        2>/dev/null | while IFS= read -r line; do

        if   echo "$line" | grep -q '\*\*\*'; then
            echo -e "  ${CLR_GREEN}${BOLD}$line${NC}"
        elif echo "$line" | grep -q 'ERROR\|FAILED\|invalid\|failed'; then
            echo -e "  ${CLR_BLOOD}$line${NC}"
        elif echo "$line" | grep -q 'WARNING\|warn\|Retry'; then
            echo -e "  ${CLR_AMBER}$line${NC}"
        elif echo "$line" | grep -q 'succeeded\|success\|set active=1\|ESCAPED'; then
            echo -e "  ${CLR_GREEN}$line${NC}"
        elif echo "$line" | grep -q '\[SSV\]\|\[Tweak\]\|\[SBX\]'; then
            echo -e "  ${CLR_FROST}$line${NC}"
        else
            echo -e "  ${DIM}$line${NC}"
        fi
    done
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: toggle
# ═══════════════════════════════════════════════════════════════

cmd_toggle() {
    local action="${1:-}"

    if [ "$action" != "on" ] && [ "$action" != "off" ]; then
        echo -e "  ${CLR_FROST}Usage:${NC} ./W0lfSword toggle on   (disable exploit)"
        echo -e "         ${CLR_FROST}./W0lfSword toggle off${NC}  (enable exploit)"
        exit 1
    fi

    local device_ip
    device_ip=$(get_device_ip "${2:-}")
    [ -z "$device_ip" ] && { step_err "No device configured"; exit 1; }

    if [ "$action" = "on" ]; then
        ssh -o StrictHostKeyChecking=no "root@$device_ip" \
            "touch /var/mobile/Documents/.filza_tweak_disable" 2>/dev/null
        step_ok "Exploit DISABLED (flag file created)"
    else
        ssh -o StrictHostKeyChecking=no "root@$device_ip" \
            "rm -f /var/mobile/Documents/.filza_tweak_disable" 2>/dev/null
        step_ok "Exploit ENABLED (flag file removed)"
    fi
    step_info "Restart the target app to apply"
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  COMMAND: offsets
# ═══════════════════════════════════════════════════════════════

cmd_offsets() {
    local target_ver="${1:-}"

    show_banner_mini "offset coverage..."
    echo ""

    step_hdr "iOS Version Blocks"
    if [ -f kexploit/offsets.m ]; then
        grep -n 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO' kexploit/offsets.m | while read -r line; do
            local lineno ver
            lineno=$(echo "$line" | cut -d: -f1)
            ver=$(echo "$line" | grep -o '@"[^"]*"' | tr -d '@"')
            echo -e "    ${CLR_FROST}Line $lineno${NC}  →  ${CLR_SNOW}$ver${NC}"
        done
    fi
    echo ""

    step_hdr "SoC Coverage"
    for cpu in A10 A13Above A15Above A16Above A17Above A18Above; do
        local count
        count=$(grep -c "is$cpu" kexploit/offsets.m 2>/dev/null || echo 0)
        echo -e "    ${cpu}: ${CLR_EYE}$count${NC} override blocks"
    done
    echo ""

    if [ -n "$target_ver" ]; then
        if grep -q "@\"$target_ver\"" kexploit/offsets.m 2>/dev/null; then
            step_ok "iOS $target_ver — block found"
        else
            step_warn "iOS $target_ver — no explicit block (inherits from earlier)"
        fi
        echo ""
    fi
}

