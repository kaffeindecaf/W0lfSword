    if confirm "Rebuild and redeploy?"; then
        cmd_build || { err "Build failed — stopping"; return 1; }
        local ip; ip=$(get_device_ip)
        if [ -n "$ip" ]; then
            cmd_deploy "$ip"
        else
            warn "No device configured — skipping deploy. Run: ./W0lfSword deploy <ip>"
        fi
    fi
    log_script "update completed"
}

cmd_setup() {
    show_header
    echo ""
    section "W0lfSword Setup — Install Dependencies"
    echo ""
    
    if [ "$EUID" -ne 0 ]; then
        err "Run with sudo: sudo ./W0lfSword setup"
        return 1
    fi
    
    local pkg_manager=""
    if command -v apt &>/dev/null; then pkg_manager="apt"
    elif command -v brew &>/dev/null; then pkg_manager="brew"
    elif command -v pacman &>/dev/null; then pkg_manager="pacman"
    else err "No supported package manager (apt/brew/pacman)"; return 1; fi
    
    echo -e "  ${C_DIM}Detected: ${C_EYE}${pkg_manager}${NC}"
    echo ""
    
    local to_install=""
    command -v clang &>/dev/null || to_install="$to_install clang"
    command -v dpkg-deb &>/dev/null || to_install="$to_install dpkg"
    command -v ssh &>/dev/null || to_install="$to_install openssh-client"
    command -v git &>/dev/null || to_install="$to_install git"
    command -v python3 &>/dev/null || to_install="$to_install python3"
    
    # idevice tools (Linux only via apt)
    if [ "$pkg_manager" = "apt" ]; then
        command -v idevice_id &>/dev/null || to_install="$to_install libimobiledevice-utils"
    fi
    
    if [ -n "$to_install" ]; then
        echo -e "  ${C_AMB}Missing:${C_RED}${to_install}${NC}"
        echo ""
        if confirm "Install now?"; then
            case "$pkg_manager" in
                apt)    apt update -qq && apt install -y $to_install;;
                brew)   brew install $to_install;;
                pacman) pacman -Sy --noconfirm $to_install;;
            esac
            ok "Packages installed"
        fi
    else
        ok "All system packages present"
    fi
    
    # THEOS
    if check_theos; then
        ok "THEOS found at ${THEOS}"
    else
        echo -e "  ${C_AMB}⚠ THEOS not found${NC}"
        if confirm "Install THEOS to ~/theos?"; then
            bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null
            export THEOS="$HOME/theos"
            ok "THEOS installed"
        fi
    fi
    
    echo ""
    echo -e "  ${C_GRN}${B}Setup complete. Run './W0lfSword doctor' to verify.${NC}"
    log_script "setup completed ($pkg_manager)"
}

cmd_reboot() {
    local ip; ip=$(get_device_ip "${1:-}")
    [ -z "$ip" ] && { err "No device IP"; return 1; }
    
    if ! confirm "Reboot device at $ip? This will disconnect it."; then
        echo -e "  ${C_DIM}Cancelled${NC}"; return 0
    fi
    
    echo -e "  ${C_DIM}Sending reboot...${NC}"
    ssh_safe "root@$ip" "reboot" 2>/dev/null || true
    ok "Reboot signal sent — device will disconnect momentarily"
    log_script "reboot $ip"
}

cmd_export() {
    local outfile="${1:-w0lfsword_export_$(date +%Y%m%d_%H%M%S).zip}"
    local tmpdir; tmpdir=$(mktemp -d)
    
    echo -e "  ${C_DIM}Collecting debug data...${NC}"
    
    # Copy key files
    mkdir -p "$tmpdir/logs" "$tmpdir/offsets" "$tmpdir/profile"
    cp "$DATA_DIR/session.log" "$tmpdir/logs/" 2>/dev/null || true
    cp "$DATA_DIR/last_crash.log" "$tmpdir/logs/" 2>/dev/null || true
    cp kexploit/offsets.m "$tmpdir/offsets/" 2>/dev/null || true
    cp kexploit/offsets.h "$tmpdir/offsets/" 2>/dev/null || true
    cp -r "$DATA_DIR/profiles" "$tmpdir/profile/" 2>/dev/null || true
    
    # Git info
    {
        echo "=== W0lfSword Export ==="
        echo "Date: $(date -Iseconds)"
        echo "Branch: $(git branch --show-current 2>/dev/null || echo ?)"
        echo "Commit: $(git rev-parse HEAD 2>/dev/null || echo ?)"
        echo "Last log:"
        git log --oneline -5 2>/dev/null || true
    } > "$tmpdir/info.txt"
    
    # Zip it
    local cwd; cwd=$(pwd)
    cd "$tmpdir" && zip -qr "$cwd/$outfile" . 2>/dev/null
    cd "$cwd" && rm -rf "$tmpdir"
    
    ok "Export saved: ${C_EYE}${outfile}${NC} ($(du -h "$outfile" | cut -f1))"
    log_script "exported to $outfile"
}

