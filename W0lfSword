            echo -e "  ${C_DIM}    xcode-select --install${NC}"
            echo ""
            hint "Re-run 'sudo ./W0lfSword setup' after the install finishes."
            return 1
        fi
        if ! xcrun --sdk iphoneos --show-sdk-path &>/dev/null 2>&1; then
            warn "iPhoneOS SDK not visible  -  open Xcode once or install the iOS SDK"
