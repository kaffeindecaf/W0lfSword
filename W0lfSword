    elif [ "$EXPLOIT_METHOD" = "unknown" ]; then
        warn "Unknown SoC for model $DEV_MODEL — exploit method falls back to 'auto'"
        EXPLOIT_METHOD="auto"
    fi

    # ── Phase 3: USB cable check ──────────────────────────────
