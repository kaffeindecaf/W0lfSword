    echo -e "  ${C_DIM}iOS $T_IOSMIN–$T_IOSMAX · exploit $T_EXPLOIT · target $T_TARGET${NC}"
    echo ""

    [ -n "$T_TPL" ] || { warn "'$T_ID' is planned  -  no template yet"; hint "See ROADMAP K3.6/K3.7 for the next catalog entries."; return 1; }

    # ── 2. Device probe (USB first, then saved IP over SSH) ────
    local IOS_VER="" DEV_MODEL="" IP=""
    if command -v idevice_id &>/dev/null; then
        local uuid; uuid=$(idevice_id -l 2>/dev/null | head -1 || echo "")
        if [ -n "$uuid" ]; then
            DEV_MODEL=$(ideviceinfo -k ProductType 2>/dev/null || ideviceinfo -k HardwareModel 2>/dev/null || echo "")
            IOS_VER=$(ideviceinfo -k ProductVersion 2>/dev/null || echo "")
            echo -e "  ${C_GRN}✓${NC} USB device: ${C_EYE}$DEV_MODEL${NC}  -  iOS $IOS_VER"
        fi
    fi
    if [ -z "$IOS_VER" ]; then
        IP=$(get_device_ip)
        if [ -n "$IP" ] && ping_check "$IP"; then
            IOS_VER=$(ssh_safe "root@$IP" "sw_vers -productVersion" 2>/dev/null || echo "")
            DEV_MODEL=$(ssh_safe "root@$IP" "sysctl -n hw.machine" 2>/dev/null || echo "")
            echo -e "  ${C_GRN}✓${NC} WiFi device: ${C_EYE}$DEV_MODEL${NC}  -  iOS $IOS_VER"
        fi
    fi
    if [ -z "$IOS_VER" ]; then
        err "No device found  -  connect via USB or: ./W0lfSword device add <ip>"
        return 1
    fi

    # ── 3. Exploit selector (K3.3 / K1.7) ──────────────────────
    local METHOD FAMILY
    METHOD=$(select_exploit "$DEV_MODEL")
    FAMILY=$(soc_family "$DEV_MODEL")
    log_script "tweak $tid: device=$DEV_MODEL ios=$IOS_VER method=$METHOD family=$FAMILY"

    if [ "$METHOD" = "unknown" ]; then
        err "Unsupported device: $DEV_MODEL"
        hint "No exploit path for this SoC yet (A10-A11 need the PUAF port  -  ROADMAP K1.6/F1)."
        return 1
    fi
    if [ "$METHOD" = "puaf" ]; then
        err "A9-A11 device  -  PUAF fallback is not ported yet"
        hint "A10-A11 will work once the kfd PhysPuppet/Smith port lands (ROADMAP K1.6). Nothing was installed."
        return 1
    fi
    if [ "$METHOD" = "mte" ]; then
        err "A19/M5 device  -  Memory Tagging Extension kills this exploit class"
        hint "No kernel R/W path exists on MTE hardware. Nothing was installed."
        return 1
    fi

    local METHOD_OK=1
    case "$T_EXPLOIT" in
        darksword)
            if [ "$METHOD" = "pe_v1" ] || [ "$METHOD" = "pe_v2" ]; then
                METHOD_OK=1
            else
                METHOD_OK=0
            fi
            if [ "$(version_sort_first "$IOS_VER" "26.1")" = "26.1" ]; then
                warn "DarkSword is patched in iOS 26.1  -  '$T_ID' requires it"
                err "This tweak needs the kernel exploit, unavailable on iOS $IOS_VER"
                return 1
            fi
            ;;
        userspace) METHOD_OK=1;;  # MCM container access works without kernel R/W
        puaf) METHOD_OK=0;;
        *) METHOD_OK=0;;
    esac
    [ "$METHOD_OK" -eq 1 ] || { err "Exploit requirement '$T_EXPLOIT' cannot be met ($METHOD on $DEV_MODEL)"; return 1; }

    # ── 4. Compatibility check (iOS range + SoC set) ───────────
    local VERDICT
    VERDICT=$(python3 - "$IOS_VER" "$FAMILY" "$T_IOSMIN" "$T_IOSMAX" "$T_SOCS" <<'PYEOF'
import sys
ios, fam, mn, mx, socs = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]

def ver(v): return tuple(int(x) for x in v.split('.'))
def lt(a, b):
    pa, pb = ver(a), ver(b)
    for x, y in zip(pa, pb):
        if x < y: return True
        if x > y: return False
    return len(pa) < len(pb)

family_set = {
    "A12-A16": {"A12","A13","A14","A15","A16"},
    "A17":     {"A17"},
    "A18":     {"A18"},
    "M1-M4":   {"M1","M2","M3","M4"},
    "A9-A11":  {"A9","A10","A11"},
}.get(fam, set())
want = set(socs.split(',')) if socs else set()

problems = []
if lt(ios, mn): problems.append(f"iOS {ios} < minimum {mn}")
if lt(mx, ios): problems.append(f"iOS {ios} > maximum {mx}")
if want and not (family_set & want): problems.append(f"SoC family {fam} not in supported set ({socs})")
print("; ".join(problems) if problems else "OK")
PYEOF
)
    if [ "$VERDICT" = "OK" ]; then
        ok "Compatibility: iOS $IOS_VER · $FAMILY · exploit $METHOD"
    else
        err "Incompatible: $VERDICT"
        hint "Nothing was installed. Pick a tweak that covers iOS $IOS_VER."
        return 1
    fi

    # ── 5. Build the dylib from template (K3.2) ────────────────
    echo ""
    section "Build (on this computer)"
    echo ""
    start_pulse "building $T_ID" & PULSE_PID=$!
    if ! bash tweaks/build_tweak.sh "$T_ID" >/tmp/w0lf_tweak_build.log 2>&1; then
        stop_pulse
        err "Build failed  -  log tail:"
        tail -5 /tmp/w0lf_tweak_build.log | sed 's/^/      /'
        return 1
    fi
    stop_pulse
    local DEB; DEB=$(ls -t tweaks/packages/*.deb 2>/dev/null | head -1)
    [ -n "$DEB" ] || { err "Build produced no .deb"; return 1; }
    ok "Built $(basename "$DEB")"

    # ── 6. Deploy + respring ───────────────────────────────────
    if [ -z "$IP" ]; then
        IP=$(get_device_ip)
    fi
    if [ -z "$IP" ] || ! ping_check "$IP"; then
        warn "No SSH path to the device (USB-only)"
        hint "Deploy manually: ./W0lfSword deploy <ip>  -  or copy $(basename "$DEB") and dpkg -i it."
        return 0
    fi
    echo ""
    section "Deploy (computer → phone)"
    echo ""
    local rp; rp="/tmp/$(basename "$DEB")"
    retry 3 1 scp_safe "$DEB" "root@$IP:$rp" || { err "SCP failed after 3 retries"; return 1; }
    ssh_safe "root@$IP" "dpkg -i '$rp' 2>&1; rm -f '$rp'" >/dev/null 2>&1
    ok "Installed on $IP"
    ssh_safe "root@$IP" "killall -9 SpringBoard 2>/dev/null" || true
    ok "SpringBoard respringing  -  tweak live in a few seconds"
    log_script "tweak $tid installed on $IP (device=$DEV_MODEL ios=$IOS_VER method=$METHOD)"
    echo ""
    echo -e "  ${C_DIM}Uninstall anytime on the phone:${NC}"
    echo -e "  ${C_DIM}  dpkg -r com.kaffeindecaf.w0lfsword.tweak.$T_ID${NC}"
    echo ""
}

