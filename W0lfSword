# ═══════════════════════════════════════════════════════════════
#  UTILITY
# ═══════════════════════════════════════════════════════════════

check_theos() {
    [ -n "${THEOS:-}" ] && return 0
    [ -d "$HOME/theos" ] && { export THEOS="$HOME/theos"; return 0; }
    return 1
}

find_deb() { ls -t packages/*.deb 2>/dev/null | head -1; }

get_device_ip() {
    [ -n "${1:-}" ] && echo "$1" && return 0
    local a; a=$(cat "$DATA_DIR/active_device" 2>/dev/null || echo "")
    [ -n "$a" ] && echo "$a" && return 0
    cat "$PROJECT_DIR/.device_ip" 2>/dev/null || echo ""
}

# ═══════════════════════════════════════════════════════════════
#  ORIGINAL W0LFSWORD COMMANDS
# ═══════════════════════════════════════════════════════════════

cmd_build() {
    $VERBOSE || spinner "compiling"
    check_theos || { err "THEOS not set — export THEOS=~/theos"; return 1; }
    local log; log=$(make package 2>&1)
    local ec=$?
    $VERBOSE && echo "$log" | tail -20
    local deb; deb=$(find_deb)
    if [ $ec -eq 0 ] && [ -n "$deb" ]; then
        ok "Built $(basename "$deb") ($(du -h "$deb" | cut -f1))"
    else
        err "Build failed (exit=$ec)"
        [ -n "$log" ] && echo "  ${C_DIM}${log}${NC}" | tail -5
        return 1
    fi
}

cmd_extract() {
    $VERBOSE || spinner "extracting"
    local deb; deb=$(find_deb)
    [ -z "$deb" ] && { err "No .deb found — build first"; return 1; }
    local edir="/tmp/w0lf_extract_$$"; mkdir -p "$edir"
    dpkg-deb -x "$deb" "$edir/" 2>/dev/null
    local dylib; dylib=$(find "$edir" -name '*.dylib' -type f 2>/dev/null | head -1)
    [ -z "$dylib" ] && { err "No dylib in package"; rm -rf "$edir"; return 1; }
    cp "$dylib" "$PROJECT_DIR/W0lfSword.dylib"
    ok "Extracted W0lfSword.dylib ($(du -h W0lfSword.dylib | cut -f1))"
    rm -rf "$edir"
}

cmd_deploy() {
    local ip; ip=$(get_device_ip "${1:-}")
    [ -z "$ip" ] && { err "No device IP — pass it or use 'device add'"; return 1; }
    $VERBOSE || spinner "deploying to $ip"

    if ! ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "root@$ip" "echo ok" 2>/dev/null | grep -q ok; then
        err "SSH failed to root@$ip"; return 1
    fi
    vlog "SSH connection: ok"

    local deb; deb=$(find_deb)
    [ -z "$deb" ] && { err "No .deb — build first"; return 1; }

    local rp="/tmp/$(basename "$deb")"
    vlog "Uploading $deb → root@$ip:$rp"
    scp -o StrictHostKeyChecking=no "$deb" "root@$ip:$rp" 2>/dev/null
    local out; out=$(ssh -o StrictHostKeyChecking=no "root@$ip" "dpkg -i '$rp' 2>&1; rm -f '$rp'")

    ok "Installed on $ip"
    [ -n "$out" ] && vlog "dpkg: $out"
    ssh -o StrictHostKeyChecking=no "root@$ip" "killall -9 Filza 2>/dev/null" 2>/dev/null || true
    vlog "Filza restarted"
    echo "$ip" > "$DATA_DIR/active_device"
}

cmd_status() {
    show_header
    local branch; branch=$(git branch --show-current 2>/dev/null || echo "?")
    local dirty="clean"
    git diff --quiet 2>/dev/null || dirty="${C_AMB}dirty${NC}"

    local done=0 total=0 pct=0
    [ -f ROADMAP.md ] && done=$(grep -c '\[x\]' ROADMAP.md 2>/dev/null || echo 0)
    [ -f ROADMAP.md ] && total=$(grep -c '\- \[.\]' ROADMAP.md 2>/dev/null || echo 0)
    [ "$total" -gt 0 ] && pct=$(( done * 100 / total ))

    local ip; ip=$(get_device_ip)
    local dev="${C_DIM}none${NC}"
    [ -n "$ip" ] && ping -c1 -W1 "$ip" >/dev/null 2>&1 && dev="${C_GRN}$ip${NC}" || dev="${C_AMB}$ip (offline)${NC}"

    echo ""
    section "Session"
    printf "  ${C_GREY}%-12s${NC} %s\n" "git"     "${C_EYE}${branch}${NC} ($dirty)"
    printf "  ${C_GREY}%-12s${NC} %s\n" "device"   "$dev"
    printf "  ${C_GREY}%-12s${NC} %s/%s (%s%%)" "roadmap" "$done" "$total" "$pct"
    echo ""

    section "Exploit State"
    local pe_v1=0 pe_v2=0
    grep -q 'pe_v1' kexploit/kexploit_opa334.m 2>/dev/null && pe_v1=1
    grep -q 'pe_v2' kexploit/kexploit_opa334.m 2>/dev/null && pe_v2=1
    printf "  ${C_GREY}%-12s${NC} " "methods"
    [ $pe_v1 -eq 1 ] && echo -ne "${C_GRN}pe_v1${NC} "
    [ $pe_v2 -eq 1 ] && echo -ne "${C_GRN}pe_v2${NC} "
    echo ""

    local ext_count; ext_count=$(grep -c 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO' kexploit/offsets.m 2>/dev/null || echo 0)
    printf "  ${C_GREY}%-12s${NC} %s iOS version blocks\n" "offsets" "$ext_count"
    echo ""
}

cmd_audit() {
    $VERBOSE || spinner "auditing"
    local issues=0
    local files=(Tweak.m sandbox_escape.m kexploit/sandbox.m kexploit/offsets.m \
                 kexploit/kexploit_opa334.m kexploit/vnode.m utils/permission_utils.m \
                 TweakExploit.m)
    for f in "${files[@]}"; do
        [ ! -f "$f" ] && continue
        local r; r=$(python3 -c "
b=p=0
for c in open('$f').read():
    if c=='{': b+=1
    elif c=='}': b-=1
    elif c=='(' or c==')':
        p+=1 if c=='(' else -1
print(b,p)
" 2>/dev/null || echo "? ?")
        local b; b=$(echo "$r" | awk '{print $1}')
        local p; p=$(echo "$r" | awk '{print $2}')
        if [ "$b" = "0" ] && [ "$p" = "0" ]; then
            $VERBOSE && ok "$f (braces=$b parens=$p)" || ok "$f"
        else
            echo -e "  ${C_RED}✗${NC} $f ${C_RED}(braces=$b parens=$p)${NC}"
            ((issues++)) || true
        fi
    done
    if [ "$issues" -eq 0 ]; then
        echo ""; echo -e "  ${C_GRN}${B}▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓  AUDIT PASSED${NC}"
    else
        echo ""; echo -e "  ${C_RED}${B}$issues issue(s) found${NC}"
    fi
}

cmd_log() {
    local lines="${1:-50}"
    local ip; ip=$(get_device_ip "${2:-}")
    [ -z "$ip" ] && { err "No device configured"; return 1; }
    $VERBOSE || spinner "fetching log"

    echo -e "  ${C_STEEL}${B}── /tmp/FilzaTweak.log @ $ip ──${NC}\n"
    ssh -o StrictHostKeyChecking=no "root@$ip" "tail -$lines /tmp/FilzaTweak.log 2>/dev/null || echo '(no log)'" 2>/dev/null | while IFS= read -r l; do
        if   echo "$l" | grep -q '\*\*\*';                   then echo -e "  ${C_GRN}${B}▓ ${NC}$l"
        elif echo "$l" | grep -q 'ERROR\|FAILED\|invalid\|PANIC'; then echo -e "  ${C_RED}✗ $l${NC}"
        elif echo "$l" | grep -q 'Retry\|retry\|WARNING\|warn';   then echo -e "  ${C_AMB}▸ $l${NC}"
        elif echo "$l" | grep -q 'succeeded\|ESCAPED\|active=1';  then echo -e "  ${C_GRN}✓ $l${NC}"
        elif echo "$l" | grep -q '\[SSV\]\|\[Tweak\]\|\[SBX\]';   then echo -e "  ${C_FROST}─ $l${NC}"
        else                                                    echo -e "  ${C_DIM}  $l${NC}"; fi
    done
    echo ""
}

cmd_toggle() {
    local action="${1:-}"
    local ip; ip=$(get_device_ip "${2:-}")
    [ "$action" != "on" ] && [ "$action" != "off" ] && { echo -e "${C_RED}Usage:${NC} toggle on|off [ip]"; return 1; }
    [ -z "$ip" ] && { err "No device"; return 1; }
    if [ "$action" = "on" ]; then
        ssh -o StrictHostKeyChecking=no "root@$ip" "touch /var/mobile/Documents/.filza_tweak_disable" 2>/dev/null
        echo -e "  ${C_RED}✗${NC} Exploit DISABLED — restart Filza to apply"
    else
        ssh -o StrictHostKeyChecking=no "root@$ip" "rm -f /var/mobile/Documents/.filza_tweak_disable" 2>/dev/null
        echo -e "  ${C_GRN}✓${NC} Exploit ENABLED — restart Filza to apply"
    fi
}

