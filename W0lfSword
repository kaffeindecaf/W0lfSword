# ═══════════════════════════════════════════════════════════════
#  CONFIG  -  .w0lfsword/config (plain key=value, # comments)
#  Edit by hand or: ./W0lfSword config set <key> <value>
# ═══════════════════════════════════════════════════════════════

CONFIG_FILE="$DATA_DIR/config"

# key|default|one-line help (schema doubles as the written template)
config_schema() {
    cat <<'EOF'
animations|on|master toggle for all animations (loading screen, spinner, effects)
anim_speed|normal|animation speed: fast | normal | slow
show_wolf|menu|when the ascii wolf shows: menu (default, boot + menu) | loading (boot only) | never
menu_compact|off|tighten the menu: fewer blank lines, no device block
device_scan|on|scan USB/WiFi devices on every menu draw (off = only saved device)
color|on|color output (off = plain text, for logs / slow terminals)
confirm_risky|on|ask before device-crashing PoCs (off = fire immediately)
prompt_symbol|W0lfSword ▸|interactive menu prompt text
loading_time|1.2|loading animation length in seconds
report_errors|ask|on critical failure: ask (prompt) | on (auto-file) | off (save log only)
EOF
}

config_defaults() {
    local k d
    while IFS='|' read -r k d _; do
        [ -n "$k" ] || continue
        case "$k" in
            animations)     CFG_ANIMATIONS="$d";;
            anim_speed)     CFG_ANIM_SPEED="$d";;
            show_wolf)      CFG_SHOW_WOLF="$d";;
            menu_compact)   CFG_MENU_COMPACT="$d";;
            device_scan)    CFG_DEVICE_SCAN="$d";;
            color)          CFG_COLOR="$d";;
            confirm_risky)  CFG_CONFIRM_RISKY="$d";;
            prompt_symbol)  CFG_PROMPT="$d";;
            loading_time)   CFG_LOADING_TIME="$d";;
            report_errors)  CFG_REPORT_ERRORS="$d";;
        esac
    done < <(config_schema)
}

config_get() {
    case "$1" in
        animations)    echo "$CFG_ANIMATIONS";;
        anim_speed)    echo "$CFG_ANIM_SPEED";;
        show_wolf)     echo "$CFG_SHOW_WOLF";;
        menu_compact)  echo "$CFG_MENU_COMPACT";;
        device_scan)   echo "$CFG_DEVICE_SCAN";;
        color)         echo "$CFG_COLOR";;
        confirm_risky) echo "$CFG_CONFIRM_RISKY";;
        prompt_symbol) echo "$CFG_PROMPT";;
        loading_time)  echo "$CFG_LOADING_TIME";;
        report_errors) echo "$CFG_REPORT_ERRORS";;
        *) echo "";;
    esac
}

config_valid() {
    case "$1" in
        animations|menu_compact|device_scan|color|confirm_risky)
            [ "$2" = "on" ] || [ "$2" = "off" ];;
        anim_speed)
            [ "$2" = "fast" ] || [ "$2" = "normal" ] || [ "$2" = "slow" ];;
        show_wolf)
            [ "$2" = "loading" ] || [ "$2" = "menu" ] || [ "$2" = "never" ];;
        prompt_symbol)
            [ -n "$2" ];;
        report_errors)
            [ "$2" = "ask" ] || [ "$2" = "on" ] || [ "$2" = "off" ];;
        loading_time)
            case "$2" in
                ''|*[!0-9.]*) false;;
                *) [ "$(echo "$2" | awk '{print ($1>=0.4 && $1<=5) ? 1 : 0}')" = "1" ];;
            esac;;
        *) false;;
    esac
}

config_write_template() {
    mkdir -p "$DATA_DIR"
    local k d h
    {
        echo "# W0lfSword config - edit this file or use: ./W0lfSword config set <key> <value>"
        echo "# one key=value per line, # for comments. defaults shown."
        echo ""
        while IFS='|' read -r k d h; do
            [ -n "$k" ] || continue
            echo "# $h"
            echo "$k=$d"
        done < <(config_schema)
    } > "$CONFIG_FILE"
}

config_set() {
    local k="$1" v="$2" tmp="$CONFIG_FILE.tmp" found=0
    config_valid "$k" "$v" || return 1
    [ -f "$CONFIG_FILE" ] || config_write_template
    while IFS= read -r line; do
        if [[ "$line" == "$k="* ]]; then
            echo "$k=$v"
            found=1
        else
            echo "$line"
        fi
    done < "$CONFIG_FILE" > "$tmp"
    [ "$found" -eq 0 ] && echo "$k=$v" >> "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    load_config
    return 0
}

load_config() {
    config_defaults
    [ -f "$CONFIG_FILE" ] || return 0
    local line k v
    while IFS='=' read -r k v; do
        [ -n "$k" ] || continue
        case "$k" in \#*) continue;; esac
        config_valid "$k" "$v" || continue
        case "$k" in
            animations)     CFG_ANIMATIONS="$v";;
            anim_speed)     CFG_ANIM_SPEED="$v";;
            show_wolf)      CFG_SHOW_WOLF="$v";;
            menu_compact)   CFG_MENU_COMPACT="$v";;
            device_scan)    CFG_DEVICE_SCAN="$v";;
            color)          CFG_COLOR="$v";;
            confirm_risky)  CFG_CONFIRM_RISKY="$v";;
            prompt_symbol)  CFG_PROMPT="$v";;
            loading_time)   CFG_LOADING_TIME="$v";;
        esac
    done < "$CONFIG_FILE"
    # color=off neutralizes the palette so every helper prints plain text
    if [ "$CFG_COLOR" = "off" ]; then
        C_WOLF='' C_FROST='' C_DIM='' C_GRN='' C_AMB='' C_RED='' B='' NC=''
    fi
}
load_config

# ═══════════════════════════════════════════════════════════════
#  ERROR REPORTING  -  critical failures → verbose log → GitHub
# ═══════════════════════════════════════════════════════════════

REPORT_DIR="$DATA_DIR/reports"
CRIT_CMD=""   # set in main() to the invoked subcommand

# Collect a full verbose report of the failure; echoes the file path.
error_report_collect() {
    local msg="$1"
    local file
    file="$REPORT_DIR/crash-$(date '+%Y%m%d-%H%M%S')-$$.txt"
    mkdir -p "$REPORT_DIR"
    local gitrev="" branch=""
    if git -C "$PROJECT_DIR" rev-parse --short HEAD &>/dev/null; then
        gitrev=$(git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null)
        branch=$(git -C "$PROJECT_DIR" branch --show-current 2>/dev/null)
    fi
    {
        echo "W0lfSword error report  -  $(date '+%Y-%m-%d %H:%M:%S %Z')"
        echo "=========================================="
        echo "version:   $VERSION"
        echo "commit:    ${gitrev:-unknown} (${branch:-?})"
        echo "command:   $0 ${CRIT_CMD:-?}"
        echo "error:     $msg"
        echo ""
        echo "system:"
        echo "  os:      $(uname -s) $(uname -r) $(uname -m)"
        echo "  bash:    $BASH_VERSION"
        [ -n "${THEOS:-}" ] && echo "  theos:   $THEOS"
        echo ""
        echo "config:"
        [ -f "$CONFIG_FILE" ] && sed 's/^/  /' "$CONFIG_FILE" || echo "  (none)"
        echo ""
        echo "device:"
        [ -f "$DATA_DIR/active_device" ] && echo "  active:  $(cat "$DATA_DIR/active_device")" || echo "  (none)"
        echo ""
        echo "session log tail:"
        [ -f "$SESSION_LOG" ] && tail -80 "$SESSION_LOG" | sed 's/^/  /' || echo "  (none)"
    } > "$file"
    echo "$file"
}

# File a saved report as a GitHub issue. 0 = filed.
report_to_github() {
    local file="$1" msg="$2"
    if ! command -v gh &>/dev/null; then
        err "gh CLI not installed  -  report saved to $file"
        hint "install https://cli.github.com  -  then: gh issue create --repo kaffeindecaf/W0lfSword --body-file \"$file\""
        return 1
    fi
    if ! gh auth status &>/dev/null; then
        err "gh not logged in  -  run: gh auth login"
        hint "report saved to $file  -  or file it manually at https://github.com/kaffeindecaf/W0lfSword/issues"
        return 1
    fi
    local title="[auto-report] ${CRIT_CMD:-menu}: ${msg:0:72}"
    title=$(printf '%s' "$title" | tr '\n\r' '  ')
    local issue_url
    if issue_url=$(gh issue create --repo kaffeindecaf/W0lfSword --title "$title" --body-file "$file" 2>&1) && [ -n "$issue_url" ]; then
        ok "issue filed: $issue_url"
        log_script "github issue filed: $title -> $issue_url"
        return 0
    fi
    err "gh issue create failed: ${issue_url:-unknown error}  -  report saved to $file"
    return 1
}

# crit: the critical-error entry point. Prints the error, dumps a full
# verbose report, then (per config) prompts / auto-files / stays local.
crit() {
    local msg="$1"
    err "$msg"
    log_script "CRITICAL: $msg"
    local file; file=$(error_report_collect "$msg")
    vlog "error report: $file"
    # JSON mode or piped stdin: never prompt, never send - just save.
    if $JSON_MODE || [ ! -t 0 ]; then
        if $JSON_MODE; then
            echo "  verbose report saved: $file" >&2
        else
            hint "verbose report saved: $file"
        fi
        return 1
    fi
    case "${CFG_REPORT_ERRORS:-ask}" in
        off)
            hint "verbose report saved: $file  (report_errors=off)"
            ;;
        on)
            report_to_github "$file" "$msg"
            ;;
        ask)
            if $YES_MODE; then
                report_to_github "$file" "$msg"
            else
                echo -ne "  ${C_AMB}Report this error to GitHub (kaffeindecaf/W0lfSword)? [y/N]${NC} "; read -r ans
                case "$ans" in
                    y|Y|yes|YES) report_to_github "$file" "$msg";;
                    *)
                        hint "report saved locally: $file  -  file it later: ./W0lfSword report $file"
                        ;;
                esac
            fi
            ;;
    esac
    return 1
}

cmd_report() {
    local sub="${1:-list}"
    case "$sub" in
        list|ls)
            show_header
            echo ""
            section "Error reports  -  $REPORT_DIR"
            if [ -d "$REPORT_DIR" ] && ls "$REPORT_DIR"/crash-*.txt &>/dev/null; then
                local f
                for f in "$REPORT_DIR"/crash-*.txt; do
                    local head; head=$(head -1 "$f")
                    printf "  ${C_FROST}%s${NC}  %s\n" "$(basename "$f")" "$head"
                done
                echo ""
                echo -e "  ${C_DIM}file one as a GitHub issue: ./W0lfSword report <file>${NC}"
            else
                echo -e "  ${C_DIM}no saved reports yet  -  critical errors land here automatically${NC}"
            fi
            ;;
        *)
            local f="$1"
            [ -f "$f" ] || f="$REPORT_DIR/$f"
            if [ ! -f "$f" ]; then
                err "report not found: $1"
                hint "saved reports: ./W0lfSword report list"
                return 1
            fi
            local msg cmdline
            msg=$(grep '^error:' "$f" | head -1 | sed 's/^error:[[:space:]]*//')
            cmdline=$(grep '^command:' "$f" | head -1 | sed 's/^command:[[:space:]]*//; s#.*/W0lfSword ##')
            [ -n "$cmdline" ] && CRIT_CMD="$cmdline"
            report_to_github "$f" "${msg:-unknown error}"
            ;;
    esac
    echo ""
}

cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        show|list|"")
            show_header
            echo ""
            section "Config  -  $CONFIG_FILE"
            [ -f "$CONFIG_FILE" ] || config_write_template
            printf "  ${C_FROST}%-16s${NC} %-12s %s\n" "key" "value" "what it does"
            printf "  ${C_DIM}%s${NC}\n" "$(repeat_char '─' 108)"
            local k d h
            while IFS='|' read -r k d h; do
                [ -n "$k" ] || continue
                printf "  ${C_FROST}%-16s${NC} %-12s %s\n" "$k" "$(config_get "$k")" "$h"
            done < <(config_schema)
            echo ""
            echo -e "  ${C_DIM}usage: config set <key> <value>  ·  config edit  ·  config reset${NC}"
            echo -e "  ${C_DIM}or edit $CONFIG_FILE directly - it reloads next run${NC}"
            ;;
        set)
            local k="${2:-}" v="${3:-}"
            if [ -z "$k" ] || [ -z "$v" ]; then
                err "usage: config set <key> <value>"
                hint "valid keys: $(config_schema | cut -d'|' -f1 | tr '\n' ' ')"
                return 1
            fi
            if config_set "$k" "$v"; then
                ok "$k = $v"
            else
                err "invalid value: $k = $v"
            fi
            ;;
        edit)
            local ed="${EDITOR:-vi}"
            [ -f "$CONFIG_FILE" ] || config_write_template
            if [ -t 1 ]; then
                "$ed" "$CONFIG_FILE" < /dev/tty > /dev/tty 2>&1 || "$ed" "$CONFIG_FILE"
                load_config
                ok "config reloaded"
            else
                hint "not a terminal - edit the file directly: $CONFIG_FILE"
            fi
            ;;
        reset)
            confirm "Reset config to defaults?" || return 1
            rm -f "$CONFIG_FILE"
            load_config
            ok "config reset to defaults"
            ;;
        *) err "usage: config show | set <key> <value> | edit | reset";;
    esac
    echo ""
}

# ═══════════════════════════════════════════════════════════════
#  ANIMATIONS  -  loading screen, wolf scramble, type effects
#  All gated by config + TTY: never fire in --json or piped output.
# ═══════════════════════════════════════════════════════════════

# 1 when animations are allowed right now (config on + real terminal)
anim_on() {
    $JSON_MODE && return 1
    [ "$CFG_ANIMATIONS" = "on" ] || return 1
    [ -t 1 ] || return 1
    return 0
}

# fractional pause honoring anim_speed (fast halves, slow doubles)
anim_pause() {
    local t="${1:-0.05}"
    case "$CFG_ANIM_SPEED" in
        fast) t=$(awk "BEGIN{print $t*0.5}");;
        slow) t=$(awk "BEGIN{print $t*2}");;
    esac
    sleep "$t" 2>/dev/null || true
}

# typewriter effect for short strings
type_text() {
    local s="$1" i
    for ((i=0; i<${#s}; i++)); do
        printf "%s" "${s:$i:1}"
        anim_pause 0.03
    done
    printf "\n"
}

