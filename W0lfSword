# ═══════════════════════════════════════════════════════════════
#  COMMAND: doctor
# ═══════════════════════════════════════════════════════════════

cmd_doctor() {
    show_banner

    local all_ok=true
    local theos_dir="${THEOS:-$HOME/theos}"

    step_hdr "Toolchain"
    echo ""

    check_ok() {
        local label="$1" icon="$2"
        printf "  %-30s " "$label"
        echo -e "$icon"
    }

    # THEOS
    if [ -n "${THEOS:-}" ] || [ -d "$HOME/theos" ]; then
        check_ok "THEOS" "${CLR_GREEN}✓${NC}"
    else
        check_ok "THEOS" "${CLR_BLOOD}✗  install: theos.dev${NC}"
        all_ok=false
    fi

    # SDK
    if [ -d "$theos_dir/sdks" ] && ls "$theos_dir/sdks/"*.sdk >/dev/null 2>&1; then
        local sdk_ver
        sdk_ver=$(ls "$theos_dir/sdks/"*.sdk 2>/dev/null | head -1 | grep -oP '\d+\.\d+' | head -1)
        check_ok "iOS SDK" "${CLR_GREEN}✓ (${sdk_ver})${NC}"
    else
        check_ok "iOS SDK" "${CLR_AMBER}⚠  download from theos/sdks${NC}"
    fi

    # dpkg-deb
    if command -v dpkg-deb &>/dev/null; then
        check_ok "dpkg-deb" "${CLR_GREEN}✓${NC}"
    else
        check_ok "dpkg-deb" "${CLR_BLOOD}✗  brew install dpkg${NC}"
        all_ok=false
    fi

    # clang
    if command -v clang &>/dev/null; then
        local cv=$(clang --version 2>/dev/null | head -1 | awk '{print $NF}' | cut -d. -f1)
        check_ok "clang" "${CLR_GREEN}✓ (v${cv})${NC}"
    else
        check_ok "clang" "${CLR_BLOOD}✗  xcode-select --install${NC}"
        all_ok=false
    fi

    # ldid
    if command -v ldid &>/dev/null; then
        check_ok "ldid" "${CLR_GREEN}✓${NC}"
    else
        check_ok "ldid" "${CLR_AMBER}⚠  optional (code signing)${NC}"
    fi

    # ssh
    if command -v ssh &>/dev/null; then
        check_ok "ssh" "${CLR_GREEN}✓${NC}"
    else
        check_ok "ssh" "${CLR_AMBER}⚠  needed for deploy/log${NC}"
    fi

    # git
    if command -v git &>/dev/null; then
        check_ok "git" "${CLR_GREEN}✓${NC}"
    else
        check_ok "git" "${CLR_AMBER}⚠  needed for version control${NC}"
    fi

    # fakeroot
    if command -v fakeroot &>/dev/null; then
        check_ok "fakeroot" "${CLR_GREEN}✓${NC}"
    else
        check_ok "fakeroot" "${CLR_AMBER}⚠  optional (packaging)${NC}"
    fi

    # Device
    if [ -f "$PROJECT_DIR/.device_ip" ]; then
        local saved_ip
        saved_ip=$(cat "$PROJECT_DIR/.device_ip")
        if ping -c1 -W1 "$saved_ip" 2>/dev/null | grep -q '1 received'; then
            check_ok "Device ($saved_ip)" "${CLR_GREEN}✓ reachable${NC}"
        else
            check_ok "Device ($saved_ip)" "${CLR_AMBER}⚠ offline${NC}"
        fi
    else
        check_ok "Device" "${DIM}— not configured${NC}"
    fi

    echo ""
    if $all_ok; then
        echo -e "  ${CLR_GREEN}${BOLD}All critical tools present — ready to hunt.${NC}"
    else
        echo -e "  ${CLR_BLOOD}${BOLD}Some tools missing — install them above before building.${NC}"
    fi
    echo ""
}

