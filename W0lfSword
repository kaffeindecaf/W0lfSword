    command -v idevice_id &>/dev/null || {
        [ "$pkg_manager" = "apt" ]    && to_install="$to_install libimobiledevice-utils"
        [ "$pkg_manager" = "brew" ]   && to_install="$to_install libimobiledevice"
        [ "$pkg_manager" = "pacman" ] && to_install="$to_install libimobiledevice"
    }
    command -v ideviceinstaller &>/dev/null || {
        [ "$pkg_manager" = "apt" ]    && to_install="$to_install ideviceinstaller"
        [ "$pkg_manager" = "brew" ]   && to_install="$to_install ideviceinstaller"
        [ "$pkg_manager" = "pacman" ] && to_install="$to_install ideviceinstaller"
    }

    if [ -n "$to_install" ]; then
        echo -e "  ${C_AMB}Installing missing packages:${NC} ${C_RED}${to_install}${NC}"
        start_pulse "installing packages" & PULSE_PID=$!
        case "$pkg_manager" in
            apt)    apt update -qq >/dev/null 2>&1; apt install -y $to_install >/dev/null 2>&1 || true;;
            brew)   brew install $to_install >/dev/null 2>&1 || true;;
            pacman) pacman -Sy --noconfirm $to_install >/dev/null 2>&1 || true;;
        esac
        stop_pulse
        command -v ideviceinstaller &>/dev/null && ok "ideviceinstaller ready  -  USB app install active"
    else
        ok "All system packages present"
    fi

    # THEOS
    if check_theos; then
        ok "THEOS found at ${THEOS}"
    else
        echo -e "  ${C_AMB}Installing THEOS automatically...${NC}"
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" >/dev/null 2>&1 || true
        if [ "$IS_MACOS" -eq 1 ] && ! check_theos; then
            $SUDO mkdir -p /opt/theos 2>/dev/null || true
            $SUDO chown "$(id -u)" /opt/theos 2>/dev/null || true
            git clone --recursive https://github.com/theos/theos.git /opt/theos >/dev/null 2>&1 || true
        fi
        if check_theos; then
            export THEOS="${THEOS}"
            ok "THEOS installed at ${THEOS}"
        else
            warn "THEOS auto-install failed  -  follow BUILD.md, then re-run nojailbreak"
            return 1
        fi
    fi
    echo ""

    # ldid is REQUIRED here (not optional like adderall) - the MHA re-sign
    # uses it. The repo's Procursus build at scripts/ldid is the fallback.
    if command -v ldid &>/dev/null; then
        ok "ldid found"
    elif [ -x "$PROJECT_DIR/scripts/ldid" ]; then
        ok "ldid found (repo build: scripts/ldid)"
        export PATH="$PROJECT_DIR/scripts:$PATH"
    else
        err "ldid not found  -  install it (apt install ldid / brew install ldid)"
        return 1
    fi

    # ── Phase 2: Device Discovery (USB ONLY) ──────────────────
    section "Phase 2  -  Device Discovery (USB required)"
    echo ""
    local usb_uuid=""
    if command -v idevice_id &>/dev/null; then
        usb_uuid=$(idevice_id -l 2>/dev/null | head -1 || echo "")
        if [ -n "$usb_uuid" ]; then
            if ! idevicepair validate >/dev/null 2>&1; then
                echo -e "  ${C_AMB}Pairing with device  -  tap TRUST on the phone if it asks${NC}"
                start_pulse "pairing" & PULSE_PID=$!
                idevicepair pair 2>/dev/null || true
                stop_pulse
                sleep 1
            fi
            echo -e "  ${C_GRN}✓${NC} USB device detected: ${C_EYE}$usb_uuid${NC}"
            DEV_MODEL=$(ideviceinfo -k ProductType 2>/dev/null || ideviceinfo -k HardwareModel 2>/dev/null || echo "unknown")
            IOS_VER=$(ideviceinfo -k ProductVersion 2>/dev/null || echo "")
            DEV_NAME=$(ideviceinfo -k DeviceName 2>/dev/null || echo "iPhone")
            vlog "nojailbreak: model=$DEV_MODEL ios=$IOS_VER name=$DEV_NAME"
            [ -z "$IOS_VER" ] && echo -e "  ${C_AMB}⚠${NC} Couldn't read device info yet  -  tap TRUST on the phone, then re-run nojailbreak"
        fi
    fi

    if [ -z "$usb_uuid" ]; then
        echo -e "  ${C_RED}✗ No USB device found${NC}"
        echo -e "  ${C_DIM}  Plug the phone in with a USB cable and tap TRUST on the phone${NC}"
        return 1
    fi
    if [ -z "$IOS_VER" ]; then
        echo -e "  ${C_RED}✗ Couldn't read device info - is the phone unlocked and trusted?${NC}"
        return 1
    fi

    echo ""
    echo -e "  ${C_EYE}${B}$DEV_NAME${NC}  -  ${C_GRN}iOS $IOS_VER${NC} • ${C_EYE}$DEV_MODEL${NC}"
    log_script "nojailbreak device: $DEV_NAME ($DEV_MODEL) iOS $IOS_VER"

    # ── Phase 3: iOS range gate (18.0 - 26.0.1) ───────────────
    section "Phase 3  -  iOS Range Check"
    echo ""
    if [ "$(version_sort_first "$IOS_VER" "18.0")" != "18.0" ]; then
        err "iOS $IOS_VER is below 18.0 - the MHA container-access trick needs iOS 18+"
        echo -e "  ${C_DIM}  Supported for nojailbreak: iOS 18.0 - 26.0.1${NC}"
        return 1
    fi
    if [ "$(version_sort_first "$IOS_VER" "26.1")" = "26.1" ]; then
        err "iOS $IOS_VER is above 26.0.1 - DarkSword kernel exploit is patched in 26.1"
        echo -e "  ${C_DIM}  Supported for nojailbreak: iOS 18.0 - 26.0.1${NC}"
        return 1
    fi
    ok "iOS $IOS_VER in supported range (18.0 - 26.0.1)"

    # SoC gate via the shared selector
    local METHOD_CHK; METHOD_CHK=$(select_exploit "$DEV_MODEL")
    if [ "$METHOD_CHK" = "mte" ]; then
        err "MTE device (A19/M5): Memory Tagging Extension kills this exploit class"
        return 1
    fi
    if [ "$METHOD_CHK" = "unknown" ]; then
        err "Unsupported device: $DEV_MODEL  -  no exploit path for this SoC"
        return 1
    fi
    ok "SoC supported: $(soc_family "$DEV_MODEL")"
    echo ""

    # ── Phase 4: USB Cable Check ──────────────────────────────
    section "Phase 4  -  USB Cable Check"
    echo ""
    test_usb_cable "$usb_uuid" || {
        err "USB is the only connection here  -  fix the cable/port, then re-run nojailbreak"
        return 1
    }
    local ctype; ctype=$(ideviceinfo -k ConnectionType 2>/dev/null || echo "")
    [ "$ctype" = "USB" ] && echo -e "  ${C_DIM}connection: USB (Lightning)${NC}"
    if command -v idevicediagnostics &>/dev/null && idevicediagnostics diagnostics All >/dev/null 2>&1; then
        echo -e "  ${C_GRN}✓${NC} USB data round-trip OK"
    else
        warn "USB diagnostics round-trip failed  -  install may be flaky"
    fi
    echo ""

    # ── Phase 5: Offset Coverage ──────────────────────────────
    section "Phase 5  -  Offset Coverage"
    echo ""
    local highest_th=""
    while IFS= read -r th; do
        [ -z "$th" ] && continue
        if [ "$(version_sort_first "$th" "$IOS_VER")" = "$th" ]; then
            highest_th="$th"
        fi
    done < <(grep -oE 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO\(@\"[0-9.]+\"\)' kexploit/offsets.m \
             | sed 's/.*(@"\([0-9.]*\)").*/\1/' | sort -u -t. -k1,1n -k2,2n -k3,3n)
    if [ -n "$highest_th" ]; then
        ok "iOS $IOS_VER covered - offsets from iOS $highest_th onward"
    else
        warn "iOS $IOS_VER below the lowest offset threshold in offsets.m"
    fi
    echo ""

    # ── Phase 6: Filza installed check ────────────────────────
    section "Phase 6  -  Filza Status (over USB)"
    echo ""
    local installed=""
    if command -v ideviceinstaller &>/dev/null; then
        installed=$(ideviceinstaller -l 2>/dev/null | grep -iE "Filza|MobileHouseArrest" | head -3 || echo "")
    fi
    if [ -n "$installed" ]; then
        echo -e "  ${C_GRN}✓${NC} Filza / MHA build found on device:"
        echo "$installed" | sed 's/^/    /'
        echo ""
        if confirm "Filza is already installed. Launch it and verify kernel R/W?"; then
            # Can't uiopen without SSH; just tell the user what to do.
            echo -e "  ${C_FROST}Open Filza on the phone.${NC}"
            echo -e "  ${C_DIM}If folders show real contents (not empty), kernel R/W is live.${NC}"
            echo -e "  ${C_DIM}Check /tmp/FilzaTweak.log on a jailbroken device, or just browse /var/mobile.${NC}"
            log_script "nojailbreak: Filza already installed, user verifying"
            return 0
        fi
    else
        echo -e "  ${C_AMB}ℹ Filza is NOT installed on the device.${NC}"
        echo -e "  ${C_DIM}  Building a fresh MHA Filza with the exploit dylib injected...${NC}"
    fi
    echo ""

    # ── Phase 7: Find the Filza.ipa source ────────────────────
    section "Phase 7  -  Filza.ipa Source"
    echo ""
    if [ -z "$IPA_SRC" ]; then
        for cand in "$PROJECT_DIR/Filza.ipa" "$HOME/Downloads/Filza.ipa" "$PROJECT_DIR/packages/Filza.ipa"; do
            [ -f "$cand" ] && { IPA_SRC="$cand"; break; }
        done
    fi
    if [ -z "$IPA_SRC" ] || [ ! -f "$IPA_SRC" ]; then
        err "No Filza.ipa found"
        echo -e "  ${C_DIM}  Put Filza.ipa in $PROJECT_DIR or pass it: --ipa /path/to/Filza.ipa${NC}"
        echo -e "  ${C_DIM}  (Filza is a paid app - download it from the official site)${NC}"
        return 1
    fi
    ok "Using: $IPA_SRC"

    # ── Phase 8: Build + re-sign ──────────────────────────────
    section "Phase 8  -  Build & Re-sign (on this computer)"
    echo ""
    stage "1/3" "Building tweak (MHA_IDENTITY=1, substrate-free)..."
    check_theos || { err "THEOS not set"; hint "Install it with: sudo ./W0lfSword setup"; return 1; }
    local build_log; build_log=$(make package MHA_IDENTITY=1 2>&1)
    local ec=$?
    $VERBOSE && echo "$build_log" | tail -5
    if [ $ec -ne 0 ]; then
        err "Build failed (exit=$ec)"
        return 1
    fi
    local dylib; dylib=$(ls .theos/obj/debug/arm64/FilzaApplySandboxExt.dylib 2>/dev/null || ls .theos/obj/arm64/FilzaApplySandboxExt.dylib 2>/dev/null || echo "")
    [ -n "$dylib" ] || { err "Built dylib not found in .theos"; return 1; }
    ok "Built tweak dylib ($(du -h "$dylib" | cut -f1))"

    stage "2/3" "Re-signing + injecting dylib (registerable bundle id)..."
    local out_ipa="$PROJECT_DIR/packages/Filza-MHA.ipa"
    # Apple refuses to register com.apple.* App IDs for third parties (Dev
    # API error 9400), so the Apple-ID sideload path uses a registerable
    # bundle id. The kernel R/W works from any bundle id; the MHA identity
    # (com.apple.mobile.MobileHouseArrest) is only for the TrollStore path.
    bash "$PROJECT_DIR/scripts/re-sign_mha.sh" "$IPA_SRC" "$dylib" "$out_ipa" "com.kaffeindecaf.w0lfsword.filza" >/tmp/mha_resign.log 2>&1
    if [ $? -ne 0 ] || [ ! -f "$out_ipa" ]; then
        err "MHA re-sign failed"
        $VERBOSE && tail -10 /tmp/mha_resign.log
        return 1
    fi
    ok "Built $out_ipa ($(du -h "$out_ipa" | cut -f1))"

    # ── Phase 9: Install over USB ─────────────────────────────
    stage "3/3" "Installing over USB..."
    if ! command -v ideviceinstaller &>/dev/null; then
        err "ideviceinstaller missing  -  install it, then re-run nojailbreak"
        return 1
    fi
    local inst_out
    inst_out=$(ideviceinstaller -i "$out_ipa" 2>&1)
    local irc=$?
    if [ $irc -eq 0 ]; then
        ok "Filza-MHA installed over USB"
    else
        echo -e "  ${C_AMB}⚠ ideviceinstaller install failed:${NC}"
        echo "$inst_out" | tail -3 | sed 's/^/    /'
        echo ""
        echo -e "  ${C_AMB}The IPA is adhoc-signed (ldid)  -  stock iOS may reject it.${NC}"
        echo -e "  ${C_DIM}  Option A: sign it with your Apple ID first, then re-run:${NC}"
        echo -e "    ${C_FROST}./W0lfSword nojailbreak --ipa /path/signed.ipa${NC}"
        echo -e "  ${C_DIM}  Option B: sideload $out_ipa with PlumeImpactor / AltStore / TrollStore,${NC}"
        echo -e "    then re-run ${C_FROST}./W0lfSword nojailbreak${NC} to verify.${NC}"
        log_script "nojailbreak: install failed (rc=$irc), handing off to external sideloader"
        return 1
    fi

    # ── Phase 10: Verify + handoff ────────────────────────────
    echo ""
    section "Phase 10  -  Done"
    echo ""
    installed=$(ideviceinstaller -l 2>/dev/null | grep -iE "Filza|MobileHouseArrest" | head -3 || echo "")
    if [ -n "$installed" ]; then
        ok "Verified on device:"
        echo "$installed" | sed 's/^/    /'
    fi
    echo ""
    banner "$C_GRN" "INSTALLED - OPEN FILZA ON THE PHONE" 44
    echo ""
    echo -e "  ${C_FROST}1. Open Filza on the phone (first launch takes a few seconds).${NC}"
    echo -e "  ${C_FROST}2. Browse to /var and /var/mobile.${NC}"
    echo -e "  ${C_FROST}3. Real contents = kernel R/W is live.${NC}"
    echo -e "  ${C_DIM}    (empty folders would mean the root-helper stubs misfired - tell me)${NC}"
    echo -e "  ${C_DIM}Nothing persists across a reboot; the exploit re-runs on each launch.${NC}"
    echo ""
    log_script "nojailbreak SUCCESS: $DEV_MODEL iOS $IOS_VER (USB install)"
    echo "{\"timestamp\":\"$(date -Iseconds)\",\"device\":\"$DEV_MODEL\",\"ios\":\"$IOS_VER\",\"mode\":\"nojailbreak\",\"result\":\"installed\"}" >> "$DATA_DIR/history.json"
    return 0
}

