# Prompt helper  -  respects --yes and config confirm_risky=off
confirm() {
    $YES_MODE && return 0
    [ "$CFG_CONFIRM_RISKY" = "off" ] && return 0
    local msg="${1:-Continue?}"
    echo -ne "  ${C_AMB}${msg} [y/N]${NC} "; read -r ans
    [ "$ans" = "y" ] || [ "$ans" = "Y" ] && return 0
    return 1
}

# Validated choice prompt  -  loops until the answer is one of the allowed
# values (empty = default). Rejects typos like "autp" instead of "auto".
# Respects --yes (returns the default without asking).
# NOTE: prompt goes to STDERR  -  these are usually called inside $(...) so
# stdout must carry ONLY the final value (no prompt text pollution).
ask_choice() {
    local prompt="${1:-}" default="${2:-}" valid="$3"
    $YES_MODE && { echo "$default"; return 0; }
    local ans
    while true; do
        echo -ne "  ${C_FROST}${prompt} [${default}]:${NC} " >&2; read -r ans
        [ -z "$ans" ] && ans="$default"
        for v in $valid; do
            [ "$ans" = "$v" ] && { echo "$ans"; return 0; }
        done
        echo -e "  ${C_RED}✗${NC} Invalid: '${ans}'  -  choose from: ${C_EYE}$valid${NC}" >&2
    done
}

# Validated integer prompt  -  bounded, re-asks on garbage. Respects --yes.
# NOTE: prompt goes to STDERR  -  see ask_choice.
ask_int() {
    local prompt="${1:-}" default="${2:-}" min="${3:-1}" max="${4:-20}"
    $YES_MODE && { echo "$default"; return 0; }
    local ans
    while true; do
        echo -ne "  ${C_FROST}${prompt} [${default}]:${NC} " >&2; read -r ans
        [ -z "$ans" ] && ans="$default"
        if [[ "$ans" =~ ^[0-9]+$ ]] && [ "$ans" -ge "$min" ] && [ "$ans" -le "$max" ]; then
            echo "$ans"; return 0
        fi
        echo -e "  ${C_RED}✗${NC} Invalid: '${ans}'  -  enter a number ${min}–${max}" >&2
    done
}

# Pulse animation  -  runs in background, stopped by killing $PULSE_PID
start_pulse() {
    local msg="$1"
    local frames=( '▓' '▒' '░' '▒' )
    while true; do
        for f in "${frames[@]}"; do
            printf "\r  ${C_EYE}%s${NC} ${C_GREY}%s${NC}" "$f" "$msg"
            sleep 0.15
        done
    done
}

stop_pulse() {
    [ -n "${PULSE_PID:-}" ] && kill "$PULSE_PID" 2>/dev/null || true
    wait "${PULSE_PID:-}" 2>/dev/null || true
    PULSE_PID=""
    printf "\r\033[K"
}

cmd_adderall() {
    # Parse adderall-specific flags
    local SAFE_MODE=false
    local USB_ONLY=false
    local args_clean=()
    for a in "$@"; do
        case "$a" in --safe|--safe-mode) SAFE_MODE=true;; --usb|--USB) USB_ONLY=true;; *) args_clean+=("$a");; esac
    done
    set -- "${args_clean[@]}"

    show_header
    echo ""
    if $SAFE_MODE; then
        banner "$C_AMB" "W0lfSword ADDERALL - SAFE MODE (no exploit)" 44
    else
        banner "$C_AMB" "W0lfSword ADDERALL - Auto Exploit" 44
    fi
    echo ""
    echo -e "  ${C_DIM}Fully automated: install missing tools, find your phone, pair it, check the${NC}"
    echo -e "  ${C_DIM}USB cable, verify offsets, build, deploy, and confirm the exploit${NC}"
    echo -e "  ${C_DIM}Run with --yes to skip the remaining prompts, -vv for extreme verbosity${NC}"
    echo ""
    disclaimer <<EOF
What this does, step by step: installs any missing build tools on this
computer (clang, dpkg, THEOS, libimobiledevice  -  no questions asked), finds
your phone over USB or WiFi, pairs it (tap TRUST on the phone when asked),
tests that the USB cable is reliable, compiles the tweak, installs it on the
phone, restarts Filza, then waits and checks whether the exploit escaped
the sandbox.
$FILZA_NOTE
$JAILBREAK_NOTE
$PERSIST_NOTE
EOF
    log_script "adderall started"

    # ── Phase 0: Sudo check ──────────────────────────────────
    # Linux needs root for apt. macOS runs brew as the user (brew refuses
    # root)  -  sudo is only used for /opt/theos there.
    local SUDO=""
    if [ "$EUID" -ne 0 ]; then
        if [ "$IS_MACOS" -eq 1 ]; then
            SUDO="sudo"
        else
            # Root is only needed for the apt auto-install below. If every
            # dependency is already present, running as the normal user is
            # actually better: $HOME and the SSH keys stay intact (sudo resets
            # HOME to /root, which breaks key lookups for the deploy phase).
            local need_root=false
            command -v clang &>/dev/null      || need_root=true
            command -v dpkg-deb &>/dev/null   || need_root=true
            command -v git &>/dev/null        || need_root=true
            command -v python3 &>/dev/null    || need_root=true
            command -v ssh &>/dev/null        || need_root=true
            command -v idevice_id &>/dev/null || need_root=true
            check_theos || need_root=true
            if $need_root; then
                echo -e "  ${C_RED}✗ adderall needs root to auto-install packages. Re-run with:${NC}"
                echo -e "    ${C_FROST}sudo ./W0lfSword adderall${NC}"
                return 1
            fi
            echo -e "  ${C_DIM}All dependencies present  -  running as $USER (auto-install skipped)${NC}"
        fi
    fi

    local IP="" IOS_VER="" DEV_MODEL="" CPU_FAMILY=""
    local DEV_NAME=""

    # ── Phase 1: Auto-install dependencies (no prompts) ──────
    section "Phase 1  -  Dependencies (on this computer, fully automatic)"
    echo ""

    local pkg_manager=""
    if [ "$IS_MACOS" -eq 1 ]; then pkg_manager="brew"
    elif command -v apt &>/dev/null; then pkg_manager="apt"
    elif command -v pacman &>/dev/null; then pkg_manager="pacman"
    else warn "No package manager detected  -  see BUILD.md for manual install"; fi

    # macOS: clang + the iPhoneOS SDK come from Xcode CLT, not brew
    if [ "$IS_MACOS" -eq 1 ] && ! xcode-select -p &>/dev/null; then
        echo -e "  ${C_AMB}Installing Xcode Command Line Tools (a system dialog will appear)${NC}"
        xcode-select --install 2>/dev/null || true
        echo -e "  ${C_DIM}  → Let that finish, then re-run: ./W0lfSword adderall${NC}"
        return 1
    fi

    local to_install=""
    command -v clang &>/dev/null    || { [ "$pkg_manager" != "brew" ] && to_install="$to_install clang"; }
    command -v dpkg-deb &>/dev/null || to_install="$to_install dpkg"
    command -v git &>/dev/null      || to_install="$to_install git"
    command -v python3 &>/dev/null  || to_install="$to_install python3"
    command -v make &>/dev/null     || { [ "$pkg_manager" = "apt" ] && to_install="$to_install make"; [ "$pkg_manager" = "pacman" ] && to_install="$to_install make"; }
    command -v curl &>/dev/null     || to_install="$to_install curl"
    command -v unzip &>/dev/null    || to_install="$to_install unzip"
    command -v zip &>/dev/null      || to_install="$to_install zip"
    command -v ssh &>/dev/null      || { [ "$pkg_manager" = "apt" ] && to_install="$to_install openssh-client"; }
    command -v scp &>/dev/null      || { [ "$pkg_manager" = "apt" ] && to_install="$to_install openssh-client"; }
    command -v idevice_id &>/dev/null || {
        [ "$pkg_manager" = "apt" ]    && to_install="$to_install libimobiledevice-utils"
        [ "$pkg_manager" = "brew" ]   && to_install="$to_install libimobiledevice"
        [ "$pkg_manager" = "pacman" ] && to_install="$to_install libimobiledevice"
    }

    if [ -n "$to_install" ]; then
        echo -e "  ${C_AMB}Installing missing packages:${NC} ${C_RED}${to_install}${NC}"
        echo -e "  ${C_DIM}  (automatic  -  adderall never asks about dependencies)${NC}"
        start_pulse "installing packages" & PULSE_PID=$!
        case "$pkg_manager" in
            apt)    apt update -qq >/dev/null 2>&1; apt install -y $to_install >/dev/null 2>&1 || true;;
            brew)   brew install $to_install >/dev/null 2>&1 || true;;
            pacman) pacman -Sy --noconfirm $to_install >/dev/null 2>&1 || true;;
        esac
        stop_pulse
        command -v idevice_id &>/dev/null && ok "libimobiledevice ready  -  USB device detection active"
    else
        ok "All system packages present"
    fi

    # THEOS
    if check_theos; then
        ok "THEOS found at ${THEOS}"
    else
        echo -e "  ${C_AMB}Installing THEOS automatically...${NC}"
        bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" >/dev/null 2>&1 || true
        if [ "$IS_MACOS" -eq 1 ] && ! check_theos; then
            $SUDO mkdir -p /opt/theos 2>/dev/null || true
            $SUDO chown "$(id -u)" /opt/theos 2>/dev/null || true
            git clone --recursive https://github.com/theos/theos.git /opt/theos >/dev/null 2>&1 || true
        fi
        if check_theos; then
            export THEOS="${THEOS}"
            ok "THEOS installed at ${THEOS}"
        else
            warn "THEOS auto-install failed  -  follow BUILD.md, then re-run adderall"
            return 1
        fi
    fi
    echo ""

    # ── Phase 2: Device Discovery ─────────────────────────────
    section "Phase 2  -  Device Discovery (computer → phone)"
    echo ""

    local usb_uuid=""
    if command -v idevice_id &>/dev/null; then
        usb_uuid=$(idevice_id -l 2>/dev/null | head -1 || echo "")
        if [ -n "$usb_uuid" ]; then
            # Auto-pair  -  first-time trust dialog appears ON THE PHONE
            if ! idevicepair validate >/dev/null 2>&1; then
                echo -e "  ${C_AMB}Pairing with device  -  tap TRUST on the phone if it asks${NC}"
                start_pulse "pairing" & PULSE_PID=$!
                idevicepair pair 2>/dev/null || true
                stop_pulse
                sleep 1
            fi
            echo -e "  ${C_GRN}✓${NC} USB device detected: ${C_EYE}$usb_uuid${NC}"
            DEV_MODEL=$(ideviceinfo -k ProductType 2>/dev/null || ideviceinfo -k HardwareModel 2>/dev/null || echo "unknown")
            IOS_VER=$(ideviceinfo -k ProductVersion 2>/dev/null || echo "")
            DEV_NAME=$(ideviceinfo -k DeviceName 2>/dev/null || echo "iPhone")
            vlog "ideviceinfo: model=$DEV_MODEL ios=$IOS_VER name=$DEV_NAME"
            [ -z "$IOS_VER" ] && echo -e "  ${C_AMB}⚠${NC} Couldn't read device info yet  -  tap TRUST on the phone, then re-run adderall"
        else
            echo -e "  ${C_DIM}No USB device found  -  checking saved WiFi devices...${NC}"
        fi
    fi

    # USB SSH tunnel  -  prefer USB transport when a device is attached
    # (no WiFi IP needed; iproxy forwards localhost:2222 → device:22).
    if [ -n "$usb_uuid" ]; then
        usb_ssh_up
        local usb_rc=$?
        if [ "$usb_rc" -eq 0 ]; then
            echo -e "  ${C_GRN}✓${NC} USB SSH tunnel up  -  deploys go over USB (localhost:$SSH_TUNNEL_PORT), no WiFi needed"
            # Deploy target = the tunnel; ssh_safe/scp_safe route via
            # SSH_TUNNEL_PORT and ignore the host, so a bare localhost keeps
            # later phases from prompting for a WiFi IP (which would hang in
            # USB-only runs and is pointless when the tunnel is up).
            [ -z "$IP" ] && IP="localhost"
        elif [ "$usb_rc" -eq 2 ]; then
            warn "USB SSH: sshd is up, but this computer has no SSH key on the phone"
            # Adderall installs the key itself (one password prompt)  -  no
            # manual ssh-copy-id needed anymore.
            if ssh_install_key "root@localhost" 2222; then
                echo -e "  ${C_GRN}✓${NC} SSH key installed on the phone  -  USB tunnel ready (localhost:2222)"
            else
                kill "$SSH_TUNNEL_PID" 2>/dev/null || true
                SSH_TUNNEL_PID=""
                SSH_TUNNEL_PORT=""
                if $USB_ONLY; then
                    err "USB SSH key install failed  -  OpenSSH reachable but auth not set up"
                    return 1
                fi
                echo -e "  ${C_DIM}Falling back to WiFi${NC}"
            fi
        elif $USB_ONLY; then
            err "USB SSH unavailable  -  is OpenSSH running on the phone? (--usb was set)"
            hint "The tunnel only replaces WiFi; the phone still needs sshd on port 22."
            return 1
        else
            echo -e "  ${C_DIM}USB SSH unavailable (OpenSSH not reachable on the phone?)  -  falling back to WiFi${NC}"
        fi
    elif $USB_ONLY; then
        err "--usb was set but no USB device is connected"
        return 1
    fi

    # If no USB, try WiFi/SSH
    if [ -z "$IOS_VER" ]; then
        IP=$(get_device_ip)
        if [ -n "$IP" ]; then
            echo -e "  ${C_GRN}✓${NC} Saved device: ${C_EYE}$IP${NC}"
            if ping_check "$IP"; then
                echo -e "  ${C_GRN}✓${NC} Device online via WiFi"
                # ensure this computer's key is on the phone (one prompt)
                if ! ssh_install_key "root@$IP"; then
                    warn "SSH key install to $IP failed  -  WiFi deploys may not work"
                fi
                IOS_VER=$(ssh_safe "root@$IP" "sw_vers -productVersion" 2>/dev/null || echo "")
                # sysctl isn't in PATH on rootless Dopamine  -  uname -m is the
                # reliable model source ("iPhone12,8" etc.)
                DEV_MODEL=$(ssh_safe "root@$IP" "sysctl -n hw.machine 2>/dev/null || uname -m" 2>/dev/null || echo "")
            else
                echo -e "  ${C_RED}✗${NC} Device offline  -  use USB or add device IP"
            fi
        fi
        if [ -z "$IOS_VER" ]; then
            echo -ne "  ${C_FROST}Enter device IP (or press enter for USB only):${NC} "; read -r IP
            if [ -n "$IP" ]; then
                ssh_install_key "root@$IP" >/dev/null 2>&1 || true
                IOS_VER=$(ssh_safe "root@$IP" "sw_vers -productVersion" 2>/dev/null || echo "")
            fi
        fi
    fi

    if [ -z "$IOS_VER" ]; then
        echo -e "  ${C_RED}✗ No device found${NC}"
        echo -e "  ${C_DIM}  1. Plug the phone in with a USB cable and tap TRUST on the phone${NC}"
        echo -e "  ${C_DIM}  2. Or: ./W0lfSword device add <phone-ip>  (phone needs OpenSSH + WiFi)${NC}"
        return 1
    fi

    echo ""
    echo -e "  ${C_EYE}${B}$DEV_NAME${NC}  -  ${C_GRN}iOS $IOS_VER${NC} • ${C_EYE}$DEV_MODEL${NC}"
    log_script "device: $DEV_NAME ($DEV_MODEL) iOS $IOS_VER"
    ios_recommendations "$IOS_VER"
    echo ""

    # A6.x  -  exploit compatibility gate: refuse before building anything
    local METHOD_CHK; METHOD_CHK=$(select_exploit "$DEV_MODEL")
