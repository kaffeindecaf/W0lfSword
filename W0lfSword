cmd_kcwatch() {
    local script="$PROJECT_DIR/scripts/kcwatch.py"
    if [ ! -f "$script" ]; then
        err "kcwatch.py missing  -  expected at scripts/kcwatch.py"
        return 1
    fi
    local sub="${1:-poll}"
    case "$sub" in
        help|-h|--help)
            cat <<'EOF'
kcwatch  -  automated kernel-delta watcher (research/kcwatch.md).
  poll              check ipsw.me for a new build; if found: ranged-fetch
                    the kernelcache (no full IPSW), XPF-resolve it, diff
                    vs the previous build, render a report + verdict.
  status            show the last-seen build and cached history.
  diff              diff the two most recent cached builds for the board.
  verify            compare the cached build's XPF struct offsets against
                    the values kexploit/offsets.m would set for that
                    version. exit 1 on mismatch (CI-friendly).
  index             render the cumulative multi-board feed index.
  atom              render an Atom feed (atom.xml) from the reports.
  Options: --board t8030|t8103|t8110 (default t8030)  --version <ver>
           --dry-run  --json   (env: KCWATCH_DIR, KCWATCH_FEED_URL)
  State + cache: .w0lfsword/kcwatch/<board>/ (gitignored)
  Feed reports: .w0lfsword/kcwatch/<board>/reports/kernel-deltas.md
EOF
            ;;
        poll|status|diff|verify|index|atom)
            shift
            python3 "$script" "$sub" "$@"
            ;;
        *)
            err "Unknown kcwatch subcommand: $sub"
            hint "Usage: ./W0lfSword kcwatch [poll|status|diff|verify|index|atom] [--board t8030] [--dry-run]"
            return 1
            ;;
