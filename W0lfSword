    log_script "nojailbreak started"

    # ── Phase 0: Sudo check (same policy as adderall) ─────────
    local SUDO=""
    if [ "$EUID" -ne 0 ]; then
        if [ "$IS_MACOS" -eq 1 ]; then
            SUDO="sudo"
        else
            local need_root=false
            command -v clang &>/dev/null      || need_root=true
            command -v dpkg-deb &>/dev/null   || need_root=true
            command -v git &>/dev/null        || need_root=true
            command -v python3 &>/dev/null    || need_root=true
            command -v idevice_id &>/dev/null || need_root=true
            command -v ideviceinstaller &>/dev/null || need_root=true
