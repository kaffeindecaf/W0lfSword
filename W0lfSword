                brew)   brew install $to_install;;
                pacman) pacman -Sy --noconfirm $to_install;;
            esac
            ok "Packages installed"
        fi
    else
        ok "All system packages present"
    fi
    
    # THEOS
    if check_theos; then
        ok "THEOS found at ${THEOS}"
    else
        echo -e "  ${C_AMB}⚠ THEOS not found${NC}"
        if confirm "Install THEOS?"; then
            if [ "$IS_MACOS" -eq 1 ]; then
                # macOS: /opt/theos is the default theos.dev location
                if command -v brew &>/dev/null && [ ! -d /opt/theos ]; then
                    if bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null; then
                        export THEOS=/opt/theos
                    else
                        $SUDO mkdir -p /opt/theos && $SUDO chown "$(id -u)" /opt/theos && git clone --recursive https://github.com/theos/theos.git /opt/theos && export THEOS=/opt/theos
                    fi
                else
                    bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null \
                        && export THEOS=/opt/theos
                fi
                ok "THEOS installed at ${THEOS:-/opt/theos}"
                hint "Add 'export THEOS=/opt/theos' to ~/.zshrc (macOS) for future runs."
            else
                bash -c "$(curl -fsSL https://raw.githubusercontent.com/theos/theos/master/bin/install-theos)" 2>/dev/null
                export THEOS="$HOME/theos"
                ok "THEOS installed"
                hint "The export only lasts for this session  -  add 'export THEOS=~/theos' to your shell rc for future runs."
            fi
        fi
    fi
    
    # usbliter8-arctic tools sync
    local ul8_tools_dir="$PROJECT_DIR/.w0lfsword/usbliter8/tools"
    if [ ! -f "$ul8_tools_dir/usbliter8ctl" ]; then
        echo ""
        echo -e "  ${C_AMB}Syncing usbliter8-arctic tools...${NC}"
        mkdir -p "$ul8_tools_dir"
        for src_dir in referenceforAI/projects/usbliter8-fun/tools referenceforAI/projects/usbliter8-fun2/tools; do
            [ -d "$src_dir" ] && cp "$src_dir"/* "$ul8_tools_dir/" 2>/dev/null && chmod +x "$ul8_tools_dir"/* 2>/dev/null
        done
        ok "usbliter8-arctic tools synced"
    fi
    
    echo ""
    echo -e "  ${C_GRN}${B}Setup complete. Run './W0lfSword doctor' to verify.${NC}"
    log_script "setup completed ($pkg_manager)"
}

cmd_reboot() {
    local ip; ip=$(get_device_ip "${1:-}")
    [ -z "$ip" ] && { err "No device IP"; hint "Connect via USB or: ./W0lfSword device add <ip>"; return 1; }
    
    disclaimer <<EOF
In plain English: reboots the phone over SSH. Remember  -  after a reboot the
exploit is gone until you open Filza again, at which point it runs fresh.
This also means a reboot can rescue you if the phone ever gets stuck.
EOF
    if ! confirm "Reboot device at $ip? This will disconnect it."; then
        echo -e "  ${C_DIM}Cancelled${NC}"; return 0
    fi
    
    echo -e "  ${C_DIM}Sending reboot...${NC}"
    ssh_safe "root@$ip" "reboot" 2>/dev/null || true
    ok "Reboot signal sent  -  device will disconnect momentarily"
    log_script "reboot $ip"
}

cmd_export() {
    local outfile="${1:-w0lfsword_export_$(date +%Y%m%d_%H%M%S).zip}"
    case "$outfile" in /*) : ;; *) outfile="$PROJECT_DIR/$outfile" ;; esac
    local tmpdir; tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/w0lfsword.XXXXXX" 2>/dev/null || mktemp -d)
    
    echo -e "  ${C_DIM}Collecting debug data...${NC}"
    
    # Copy key files
    mkdir -p "$tmpdir/logs" "$tmpdir/offsets" "$tmpdir/profile"
    cp "$DATA_DIR/session.log" "$tmpdir/logs/" 2>/dev/null || true
    cp "$DATA_DIR/last_crash.log" "$tmpdir/logs/" 2>/dev/null || true
    cp kexploit/offsets.m "$tmpdir/offsets/" 2>/dev/null || true
    cp kexploit/offsets.h "$tmpdir/offsets/" 2>/dev/null || true
    cp -r "$DATA_DIR/profiles" "$tmpdir/profile/" 2>/dev/null || true
    
    # Git info
    {
        echo "=== W0lfSword Export ==="
        echo "Date: $(date -Iseconds)"
        echo "Branch: $(git branch --show-current 2>/dev/null || echo ?)"
        echo "Commit: $(git rev-parse HEAD 2>/dev/null || echo ?)"
        echo "Last log:"
        git log --oneline -5 2>/dev/null || true
    } > "$tmpdir/info.txt"
    
    # Zip it
    if ! ( cd "$tmpdir" && zip -qr "$outfile" . ); then
        rm -rf "$tmpdir"
        err "Export failed  -  is zip installed?"
        hint "Install zip: sudo apt install zip  (or: brew install zip)"
        return 1
    fi
    rm -rf "$tmpdir"
    
    ok "Export saved: ${C_EYE}${outfile}${NC} ($(du -h "$outfile" | cut -f1))"
    log_script "exported to $outfile"
}

