cmd_audit() {
    $VERBOSE || spinner "auditing"
    local issues=0
    local files=(Tweak.m sandbox_escape.m kexploit/sandbox.m kexploit/offsets.m \
                 kexploit/kexploit_opa334.m kexploit/vnode.m utils/permission_utils.m \
                 TweakExploit.m)
    local results=""
    for f in "${files[@]}"; do
        [ ! -f "$f" ] && continue
        local r; r=$(python3 -c "
b=p=0
for c in open('$f').read():
    if c=='{': b+=1
    elif c=='}': b-=1
    elif c=='(' or c==')':
        p+=1 if c=='(' else -1
print(b,p)
" 2>/dev/null || echo "? ?")
        local b; b=$(echo "$r" | awk '{print $1}')
        local p; p=$(echo "$r" | awk '{print $2}')
        if [ "$b" = "0" ] && [ "$p" = "0" ]; then
            if ! $JSON_MODE; then
                if $VERBOSE; then ok "$f (braces=$b parens=$p)"; else ok "$f"; fi
            fi
        else
            $JSON_MODE || echo -e "  ${C_RED}✗${NC} $f ${C_RED}(braces=$b parens=$p)${NC}"
            ((issues++)) || true
        fi
        results="$results$f|$b|$p"$'\n'
    done
    # -- shellcheck over the main script (AUD.5). Optional: skipped (with a hint)
    #    when shellcheck is not installed. Exclusions = categories that have their
    #    own queued AUD tickets - drop an exclusion when its item lands:
    #      SC2059 -> AUD.3 (colors-in-printf-format is the repo-wide convention)
    #      SC2012 -> AUD.2 (ls -t listings, low risk)
    #      SC2086 -> AUD.1 (intentional word-splitting for multi-package installs)
    local sc_warns=0 sc_out=""
    if command -v shellcheck &>/dev/null; then
        sc_out=$(shellcheck -s bash -e SC2059,SC2012,SC2086 W0lfSword 2>&1)
        sc_warns=$(printf '%s\n' "$sc_out" | grep -c '^W0lfSword:' || true)
    fi
    # --json (J6.2): machine-readable audit result
    if $JSON_MODE; then
        printf '%s' "$results" | SC_WARNS="$sc_warns" python3 -c '
import sys, json, os, shutil
rows = []
for line in sys.stdin.read().splitlines():
