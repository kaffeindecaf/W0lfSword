# ── Spinner animation (0.5s) ──────────────────────────────────

spinner() {
    $JSON_MODE && return 0   # machine-readable output stays clean
    [ "$CFG_ANIMATIONS" = "on" ] || return 0   # config animations=off
    local msg="${1:-Working}"
    local spinframes=( '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏' )
    local end=$((SECONDS * 10 + 5))
    while [ $((SECONDS * 10)) -lt $end ]; do
        for f in "${spinframes[@]}"; do
            [ $((SECONDS * 10)) -ge $end ] && break
            printf "\r  ${C_EYE}%s${NC} ${C_GREY}%s...${NC}" "$f" "$msg"
            sleep 0.05
        done
    done
    printf "\r\033[K"
}

# ── Platform detection (Linux / macOS) ────────────────────────
OS_NAME="$(uname -s)"
IS_MACOS=0
[ "$OS_NAME" = "Darwin" ] && IS_MACOS=1

# Portable helpers  -  GNU coreutils (Linux) vs BSD (macOS) differ.
# No seq, sort -V, getent, or mktemp-without-template here (A6.17).
repeat_char() {
    local c="$1" n="$2" i s=""
    for ((i=0; i<n; i++)); do s="${s}${c}"; done
    printf '%s' "$s"
}

# ping: Linux -W is seconds, macOS -W is milliseconds (so -W1 would
# mean 1ms and every device would look offline on a Mac).
ping_check() {
    if [ "$IS_MACOS" -eq 1 ]; then
        ping -c1 -W1000 "$1" >/dev/null 2>&1
    else
        ping -c1 -W1 "$1" >/dev/null 2>&1
    fi
}

# Portable version comparison (macOS sort has no -V).
version_sort_first() {
    printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -1
}

# ── Exploit selector (K1.7 / K3.3) ────────────────────────────
# Maps hw.machine model identifier → exploit method + SoC family.
#   A12-A17 + M1-M4 → DarkSword pe_v1
#   A18            → DarkSword pe_v2
#   A9-A11         → PUAF fallback (not ported yet  -  see K1.6)
#   anything else  → unknown (refuse)
select_exploit() {
    case "$1" in
        iPhone8,*|iPhone9,*|iPhone10,*) echo "puaf";;  # A9-A11  -  must precede iPhone1[1-6]
        iPhone1[1-5],*|iPhone16,*)      echo "pe_v1";; # A12-A16 + A17 (pe_v1 path)
        iPhone17,*)                     echo "pe_v2";; # A18 (pe_v2 path)
        iPhone18,*)                     echo "mte";;   # A19  -  MTE kills this exploit class
        iPad8,*|iPad11,*|iPad1[3-6],*)  echo "pe_v1";; # A12X/Z + M1-M4 iPads
        iPad17,*)                       echo "mte";;   # M5  -  MTE
        *)                              echo "unknown";;
    esac
}

# K5.9  -  auto-select the best attack chain for a device (iOS version + model).
# Letters follow the K5 chain matrix (ROADMAP K5): A DarkSword, B userspace/
# ImageIO, D bootchain, E PUAF. Order per K5.9: DarkSword offsets → A; else
# 16.x → E; else A11- → D; else userspace bug → B; else nothing.
# Prints: "<id>|<name>|<status>|<why>"
select_best_chain() {
    local ver="$1" model="$2"
    [ -n "$ver" ] || { echo "|unknown||no iOS version"; return; }
    local major minor
    major="${ver%%.*}"; minor="${ver#*.}"; minor="${minor%%.*}"
    [ -n "$major" ] || { echo "|unknown||unparseable version $ver"; return; }
    local method; method=$(select_exploit "$model")

    # K5 A  -  DarkSword kernel R/W (→ C5.3 chain B): A12+ on 17.0–26.0.1
    if { [ "$method" = pe_v1 ] || [ "$method" = pe_v2 ]; } \
       && [ "$major" -ge 17 ] \
       && { [ "$major" -lt 26 ] || { [ "$major" -eq 26 ] && [ "$minor" -le 0 ]; }; }; then
        echo "A|DarkSword kernel R/W|implemented|17.0–26.0.1, $method (stages: chains b)"
        return
    fi
    # K5 E  -  kfd PUAF fallback: 16.x
    if [ "$major" -eq 16 ]; then
        echo "E|kfd PUAF fallback|port pending|16.x  -  K5.3"
        return
    fi
    # K5 D  -  bootchain: A9–A11 checkm8, A12/A13 usbliter8 tethered
    case "$model" in
        iPhone8,*|iPhone9,*|iPhone10,*)   # A9–A11
            echo "D|checkm8 bootchain|usbliter8-fun2|A9–A11, 15.6–27.0b"
            return
            ;;
        iPhone1[1-2],*)    # A12/A13  -  usbliter8 when the kernel gate is closed
            if [ "$major" -ge 26 ]; then
                echo "D|usbliter8 tethered|implemented|A12/A13, any iOS (needs RP2350 board)"
                return
            fi
            ;;
    esac
    # K5 B  -  userspace escape (→ C5.3 chain A): bad_query/MCM on 26.1+
    if [ "$major" -ge 26 ]; then
        echo "B|userspace escape (bad_query/MCM)|implemented|26.1+ no-kernel route (stages: chains a)"
        return
    fi
    echo "|no chain||DarkSword needs A12+ ≤26.0.1; kfd port (K5.3) would cover 16.x + A10/A11"
}

