    # ── Phase 4: Environment (on this computer) ───────────────
    echo ""
    section "Phase 4 — Environment (on this computer)"
    echo ""
    local missing=""
    check_theos || missing="$missing theos"
    command -v clang &>/dev/null    || missing="$missing clang"
    command -v dpkg-deb &>/dev/null || missing="$missing dpkg"
    command -v ssh &>/dev/null      || missing="$missing ssh"

