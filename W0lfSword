    fi

    # ── Phase 3: Offset Check ────────────────────────────────
    echo ""
    section "Phase 5 — Offset Coverage (on this computer)"
    echo ""

    # offsets.m uses >= thresholds (SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO).
    # Find the highest threshold that is <= the device version.
    local highest_th=""
    while IFS= read -r th; do
        [ -z "$th" ] && continue
        if [ "$(version_sort_first "$th" "$IOS_VER")" = "$th" ]; then
            highest_th="$th"
        fi
    done < <(grep -o 'SYSTEM_VERSION_GREATER_THAN_OR_EQUAL_TO(@"[0-9.]*")' kexploit/offsets.m \
             | sed 's/.*(@"\([0-9.]*\)").*/\1/' | sort -u -t. -k1,1n -k2,2n -k3,3n)

    if [ -n "$highest_th" ]; then
        echo -e "  ${C_GRN}✓${NC} iOS $IOS_VER is covered — offsets apply from iOS ${C_EYE}$highest_th${NC} onward"
    else
        echo -e "  ${C_AMB}⚠${NC} iOS $IOS_VER is below the lowest offset threshold in offsets.m"
    fi

    # DarkSword itself is capped: patched in iOS 26.1 (CVE-2025-43520).
    if [ "$(version_sort_first "$IOS_VER" "26.1")" = "26.1" ]; then
        echo -e "  ${C_AMB}⚠${NC} DarkSword kernel exploit is capped at iOS 26.0.1 — patched in 26.1"
        echo -e "  ${C_DIM}On iOS 26.1+ the kernel stage will refuse to run; safe mode and the"
        echo -e "  ${C_DIM}userspace container access (MCM) still work. See SandboxEscape.md.${NC}"
    fi

    if [ -z "$highest_th" ]; then
        if confirm "Attempt to auto-pull kernelcache and run XPF?"; then
            echo -e "  ${C_DIM}(kernelcache extraction requires SSH + root on device)${NC}"
            if [ -n "$IP" ]; then
                start_pulse "pulling kernelcache" & PULSE_PID=$!
                # Grab kernelcache from device
                local kc_path="/tmp/kernelcache_$IOS_VER"
                ssh_safe "root@$IP" \
                    "dd if=/dev/rdisk0s1s1 of=/tmp/kc bs=1M count=32 2>/dev/null; lzma -d /tmp/kc -c > /tmp/kc_raw 2>/dev/null" 2>/dev/null || true
                scp_safe "root@$IP:/tmp/kc_raw" "$kc_path" 2>/dev/null || true
                stop_pulse
                if [ -f "$kc_path" ] && [ -s "$kc_path" ]; then
                    echo -e "  ${C_GRN}✓${NC} Kernelcache pulled ($(du -h "$kc_path" | cut -f1))"
                    echo -e "  ${C_DIM}Run XPF manually: XPF/src/xpf $kc_path > offsets_new.txt${NC}"
                else
                    echo -e "  ${C_AMB}⚠${NC} Kernelcache pull failed — might need different device path"
                fi
            else
                echo -e "  ${C_RED}✗${NC} No SSH — kernelcache pull needs WiFi connection"
            fi
        fi
    fi
    vlog "iOS $IOS_VER — highest offset threshold: ${highest_th:-none}"

    # ── Phase 4: Configuration ───────────────────────────────
    echo ""
    section "Phase 6 — Configuration (on this computer)"
    echo ""

    local TARGET_BUNDLE="com.tigisoftware.Filza"
    # Detect the installed Filza bundle ID from the phone instead of guessing
    # from version numbers (ROADMAP A2.1: Filza versioning is misleading —
    # 4.0.0 is newer than 4.0.2). Falls back to the question when unreachable.
    local detected_bundle=""
    if [ -n "$SSH_TUNNEL_PORT" ] || [ -n "$IP" ]; then
        detected_bundle=$(ssh_safe "root@${IP:-localhost}" \
            "p=\$(dpkg -L com.tigisoftware.filza64bit 2>/dev/null | grep -m1 \"Filza.app/Info.plist\$\"); [ -n \"\$p\" ] && grep -ao \"com.tigisoftware.Filza[0-9]*\" \"\$p\" | sort -u | head -1" 2>/dev/null)
    fi
    if [ -n "$detected_bundle" ]; then
        TARGET_BUNDLE="$detected_bundle"
        echo -e "  ${C_GREY}Target:${NC}  ${C_EYE}$TARGET_BUNDLE${NC}  ${C_DIM}(detected on phone)${NC}"
    else
        if confirm "Target Filza 4.0.2 (com.tigisoftware.Filza000) instead of 4.0.0?"; then
            TARGET_BUNDLE="com.tigisoftware.Filza000"
        fi
        echo -e "  ${C_GREY}Target:${NC}  ${C_EYE}$TARGET_BUNDLE${NC}"
    fi

    if [ "$EXPLOIT_METHOD" = "auto" ]; then
        EXPLOIT_METHOD=$(ask_choice "Exploit method" "auto" "auto pe_v1 pe_v2")
    fi
    echo -e "  ${C_GREY}Exploit:${NC} ${C_AMB}$EXPLOIT_METHOD${NC}"

    local RETRY_COUNT=5
    RETRY_COUNT=$(ask_int "Retry count" 5 1 20)

    local ENABLE_SSV=true
    confirm "Enable SSV bypass?" || ENABLE_SSV=false
    echo -e "  ${C_GREY}SSV:${NC}     $($ENABLE_SSV && echo "${C_GRN}yes${NC}" || echo "${C_DIM}no${NC}")"

    local PROFILE_NAME="${DEV_MODEL}-${IOS_VER}"
    if ! $YES_MODE; then
        while true; do
            echo -ne "  ${C_FROST}Profile name [$PROFILE_NAME]:${NC} "; read -r pn
            [ -z "$pn" ] && pn="$PROFILE_NAME"
            if [[ "$pn" =~ ^[A-Za-z0-9._-]+$ ]]; then
                PROFILE_NAME="$pn"; break
            fi
            echo -e "  ${C_RED}✗${NC} Invalid profile name: '${pn}' — letters, digits, . _ - only"
        done
    fi

    echo ""
    echo -e "  ${C_STEEL}${B}── Configuration Summary ──${NC}"
    printf "  ${C_GREY}%-12s${NC} %s\n" "Device"    "$DEV_NAME ($DEV_MODEL)"
    printf "  ${C_GREY}%-12s${NC} %s\n" "iOS"       "$IOS_VER"
    printf "  ${C_GREY}%-12s${NC} %s\n" "Target"    "$TARGET_BUNDLE"
    printf "  ${C_GREY}%-12s${NC} %s\n" "Exploit"   "$EXPLOIT_METHOD"
    printf "  ${C_GREY}%-12s${NC} %d\n" "Retries"   "$RETRY_COUNT"
    printf "  ${C_GREY}%-12s${NC} %s\n" "SSV"       "$($ENABLE_SSV && echo 'yes' || echo 'no')"
    printf "  ${C_GREY}%-12s${NC} %s\n" "Profile"   "$PROFILE_NAME"
    echo ""

    confirm "Proceed with deployment?" || { echo -e "  ${C_DIM}Aborted.${NC}"; return 0; }

    # Save profile
    mkdir -p "$DATA_DIR/profiles"
    [ -n "$IP" ] && echo "$IP" > "$DATA_DIR/active_device"
    cat > "$DATA_DIR/profiles/$PROFILE_NAME.json" << EOF
{
  "name": "$PROFILE_NAME",
  "device_ip": "${IP:-}",
  "device_model": "$DEV_MODEL",
  "ios_version": "$IOS_VER",
  "target": "$TARGET_BUNDLE",
  "exploit_method": "$EXPLOIT_METHOD",
  "retry_count": $RETRY_COUNT,
  "ssv_enabled": $ENABLE_SSV,
  "saved_at": "$(date -Iseconds)"
}
EOF
    echo "$PROFILE_NAME" > "$DATA_DIR/active_profile"

    # ── Phase 5: Build → Deploy → Verify ─────────────────────
    echo ""
    section "Phase 7 — Build, Deploy, Verify (computer → phone)"
    echo ""

    stage "1/5" "Building... (on this computer)"
    check_theos || { err "THEOS not set"; hint "Install it with: sudo ./W0lfSword setup (then doctor to verify)"; return 1; }
    local build_out
    if $DEBUG; then
