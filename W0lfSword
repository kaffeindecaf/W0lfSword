# ── Fail-safe wrappers ───────────────────────────────────────
# USB SSH tunnel: iproxy forwards localhost:2222 → device:22 over
# usbmuxd, so deploys work without WiFi/IP. The phone still needs
# OpenSSH listening on port 22 — the tunnel only replaces the network.
SSH_TUNNEL_PID=""
SSH_TUNNEL_PORT=""

# SSH key for deploys: reuse the invoking user's key even under sudo
# (sudo resets HOME to /root, which would silently look in /root/.ssh).
REAL_USER="${SUDO_USER:-$USER}"
REAL_HOME="$(eval echo "~$REAL_USER" 2>/dev/null || echo "$HOME")"
SSH_KEY="${SSH_KEY:-$REAL_HOME/.ssh/id_ed25519}"

# Ensure this computer has an SSH keypair; generate one if missing.
ssh_ensure_key() {
    [ -f "$SSH_KEY" ] && [ -f "$SSH_KEY.pub" ] && return 0
    mkdir -p "$(dirname "$SSH_KEY")" 2>/dev/null
    chmod 700 "$(dirname "$SSH_KEY")" 2>/dev/null
    if command -v ssh-keygen &>/dev/null; then
        echo -e "  ${C_AMB}No SSH key on this computer — generating one now${NC}"
        ssh-keygen -t ed25519 -N "" -f "$SSH_KEY" \
            -C "$REAL_USER@$(hostname 2>/dev/null || echo localhost)" >/dev/null 2>&1
    fi
    [ -f "$SSH_KEY.pub" ]
}

# Install this computer's public key on the phone (one-time; prompts for
# the phone's root password). Returns 0 when key auth now works.
ssh_install_key() {
    local host="${1:-root@localhost}" port="${2:-}"
    local portargs=()
    [ -n "$port" ] && portargs=(-p "$port")
    ssh_ensure_key || { err "cannot create SSH key"; return 1; }
    # fast path: key already works
    if ssh -i "$SSH_KEY" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
            "${portargs[@]}" "$host" "echo ok" 2>/dev/null | grep -q ok; then
        return 0
    fi
    if $YES_MODE; then
        hint "Add the key yourself: ssh-copy-id ${portargs[*]} $host   (phone root password)"
        return 1
    fi
    if ! command -v ssh-copy-id &>/dev/null; then
        err "ssh-copy-id not installed — add the key manually: ssh-copy-id ${portargs[*]} $host"
        return 1
    fi
    echo -e "  ${C_AMB}This computer has no SSH key on the phone — installing it now${NC}"
    echo -e "  ${C_DIM}(one-time setup; enter the phone's root password, default alpine)${NC}"
    ssh-copy-id -i "$SSH_KEY.pub" -o StrictHostKeyChecking=no "${portargs[@]}" "$host" 2>&1 | tail -2
    ssh -i "$SSH_KEY" -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
        "${portargs[@]}" "$host" "echo ok" 2>/dev/null | grep -q ok
}

usb_ssh_up() {
    [ -n "$SSH_TUNNEL_PID" ] && return 0
    command -v iproxy &>/dev/null || return 1
    command -v idevice_id &>/dev/null || return 1
    [ -n "$(idevice_id -l 2>/dev/null | head -1)" ] || return 1
    iproxy 2222 22 >/dev/null 2>&1 &
    SSH_TUNNEL_PID=$!
    sleep 1
    local out
    out=$(ssh -i "$SSH_KEY" -o ConnectTimeout=2 -o StrictHostKeyChecking=no -o BatchMode=yes \
             -p 2222 root@localhost "echo ok" 2>&1) || true
    if echo "$out" | grep -q ok; then
        SSH_TUNNEL_PORT="2222"
        return 0
    fi
    if echo "$out" | grep -qi "permission denied"; then
        # sshd is up; keep the tunnel alive so a key can be installed now
        SSH_TUNNEL_PORT="2222"
        return 2   # sshd is up, but this computer has no key on the phone
    fi
    kill "$SSH_TUNNEL_PID" 2>/dev/null || true
    SSH_TUNNEL_PID=""
    return 1       # no sshd / unreachable
}

ssh_safe() {
    local host="${1:-}"
    shift
    if [ -n "$SSH_TUNNEL_PORT" ]; then
        ssh -i "$SSH_KEY" -p "$SSH_TUNNEL_PORT" -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
            -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "root@localhost" "$@" 2>/dev/null
    else
        ssh -i "$SSH_KEY" -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
            -o ServerAliveInterval=5 -o ServerAliveCountMax=2 "$host" "$@" 2>/dev/null
    fi
}
scp_safe() {
    local remote="${1:-}"
    shift
    if [ -n "$SSH_TUNNEL_PORT" ]; then
        scp -i "$SSH_KEY" -P "$SSH_TUNNEL_PORT" -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
            "root@localhost:${remote#*:}" "$@" 2>/dev/null
    else
        scp -i "$SSH_KEY" -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o BatchMode=yes \
            "$remote" "$@" 2>/dev/null
    fi
}
retry() {
    local max="${1:-3}" delay="${2:-1}" cmd="${3:-true}"
    local i=0
    while [ $i -lt "$max" ]; do
        eval "$cmd" && return 0
        i=$((i+1))
        [ $i -lt "$max" ] && sleep "$delay"
    done
    return 1
}

