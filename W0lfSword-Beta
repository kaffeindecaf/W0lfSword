show_menu() {
    show_wolf
    echo -e "  ${CLR_SNOW}${BOLD}W0lfSword-Beta${NC}  ${CLR_WOLF}iOS Exploit Menu${NC}"
    echo -e "  ${DIM}DarkSword Engine — Made by kaffeindecaf${NC}"
    echo -e "  ${CLR_STEEL}────────────────────────────────────────────${NC}"
    echo ""
    echo -e "  ${CLR_EYE}${BOLD}[1]${NC}  Quick Exploit      ${DIM}Build → Deploy → Verify${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[2]${NC}  Deploy Only        ${DIM}Install on device${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[3]${NC}  Device Manager     ${DIM}Add/switch devices${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[4]${NC}  Live Monitor       ${DIM}Real-time log viewer${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[5]${NC}  Profiles           ${DIM}Save/load configs${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[6]${NC}  History            ${DIM}Exploit stats${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[7]${NC}  Diagnostics        ${DIM}Doctor, audit, status${NC}"
    echo -e "  ${CLR_EYE}${BOLD}[8]${NC}  Targets            ${DIM}Supported apps${NC}"
    echo ""
    echo -e "  ${CLR_EYE}${BOLD}[q]${NC}  Quit"
    echo ""
    echo -ne "  ${CLR_FROST}W0lfSword >${NC} "
}

run_menu() {
    while true; do
        show_menu
        read -r choice
        echo ""
        case "$choice" in
            1) cmd_quick;;
            2) cmd_deploy;;
            3) echo -e "  ${CLR_FROST}Device commands:${NC} list | add <ip> | switch <ip> | info [ip]"
               echo -ne "  ${CLR_FROST}device >${NC} "; read -r dcmd
               cmd_device $dcmd;;
            4) cmd_monitor;;
            5) echo -e "  ${CLR_FROST}Profile commands:${NC} list | save <name> | load <name>"
               echo -ne "  ${CLR_FROST}profile >${NC} "; read -r pcmd
               cmd_profile $pcmd;;
            6) cmd_history stats; cmd_history show;;
            7) cmd_doctor; echo ""; cmd_audit; echo ""; cmd_status;;
            8) cmd_targets;;
            q|Q|quit|exit) echo -e "  ${CLR_WOLF}~ howl later ~${NC}\n"; exit 0;;
            *) echo -e "  ${ICON_WARN} Unknown option — try 1-8 or q";;
        esac
        echo ""; echo -ne "  ${DIM}Press enter to continue...${NC}"; read -r; echo ""
    done
}

