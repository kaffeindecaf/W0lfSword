# ═══════════════════════════════════════════════════════════════
#  MAIN DISPATCH
# ═══════════════════════════════════════════════════════════════

main() {
    local cmd="${1:-}"

    # No args → interactive menu
    if [ -z "$cmd" ]; then
        run_menu
        return 0
    fi

    shift || true

    case "$cmd" in
        # Original W0lfSword commands
        build)     cmd_build "$@";;
        extract)   cmd_extract "$@";;
        deploy)    cmd_deploy "$@";;
        status)    cmd_status "$@";;
        audit)     cmd_audit "$@";;
        log)       cmd_log "$@";;
        toggle)    cmd_toggle "$@";;
        offsets)   cmd_offsets "$@";;
        targets)   cmd_targets "$@";;
        clean)     cmd_clean "$@";;
        doctor)    cmd_doctor "$@";;
        # New Beta commands
        quick)     cmd_quick "$@";;
        profile)   cmd_profile "$@";;
        device)    cmd_device "$@";;
        history)   cmd_history "$@";;
        monitor)   cmd_monitor "$@";;
        # Help
        help|--help|-h) cmd_help "$@";;
        *)
            echo -e "${CLR_BLOOD}Unknown: $cmd${NC}"
            echo -e "Run ${CLR_FROST}./W0lfSword-Beta${NC} for menu or ${CLR_FROST}./W0lfSword-Beta help${NC}"
            ;;
    esac
}

main "$@"
