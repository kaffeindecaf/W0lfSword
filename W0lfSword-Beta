# ╚══════════════════════════════════════════════════════════════╝
#
# W0lfSword-Beta is a SUPERSET of W0lfSword.
# It includes every original command PLUS an interactive exploit menu.
# Original ./W0lfSword remains untouched.
#
# ── Menu (no args) ──────────────────────
#   Interactive arrow-key menu for exploit operations
#
# ── All W0lfSword Commands ─────────────
#   build, extract, deploy, status, audit, log, toggle,
#   offsets, targets, clean, doctor, help
#
# ── New Beta Commands ──────────────────
#   profile save|load|list  — Manage exploit profiles
#   device add|list|switch|info — Multi-device management
#   history [stats]         — Exploit attempt history
#   monitor                 — Real-time log viewer
#   quick                   — One-command: build → deploy → verify

set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

# ═══════════════════════════════════════════════════════════════
#  ARCTIC WOLF COLOR PALETTE
# ═══════════════════════════════════════════════════════════════

CLR_WOLF='\033[38;5;153m'
CLR_ICE='\033[38;5;195m'
CLR_FROST='\033[38;5;117m'
CLR_SNOW='\033[38;5;255m'
CLR_STEEL='\033[38;5;109m'
CLR_MOON='\033[38;5;188m'
CLR_EYE='\033[38;5;39m'
CLR_BLOOD='\033[0;31m'
CLR_GREEN='\033[0;32m'
CLR_AMBER='\033[1;33m'
NC='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
ICON_OK="${CLR_GREEN}✓${NC}"
ICON_ERR="${CLR_BLOOD}✗${NC}"
ICON_WARN="${CLR_AMBER}⚠${NC}"
ICON_INFO="${CLR_ICE}ℹ${NC}"

# ═══════════════════════════════════════════════════════════════
#  ASCII ART — ARCTIC WOLF
# ═══════════════════════════════════════════════════════════════

show_wolf() {
    echo -e "${CLR_WOLF}"
    cat << 'WOLF'
                             __
                         .d$$b
                       .' TO$;\
                      /  : TP._;
                     / _.;  :Tb|
                    /   /   ;j$j
                _.-"       d$$$$
              .' ..       d$$$$;
             /  /P'      d$$$$P. |\
            /   "      .d$$$P' |\^"l
          .'           `T$P^"""""  :
      ._.'      _.'                ;
   `-.-".-'-' ._.       _.-"    .-"
 `.-" _____  ._              .-"
-.(g$$$$$$$b.              .'
  ""^^T$$$P^)            .(:
    _/  -"  /.'         /:/;
 ._.'-'`-'  ")/         /;/;
`-.-"..--""   " /         /  ;
.-" ..--""        -'          :
..--""--.-"         (\      .-(\
  ..--""              `-\(\/;`
    _.                      :
                            ;`-
                           :\
