set -uo pipefail
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR" || { echo "cannot cd to $PROJECT_DIR" >&2; exit 1; }

PY="python3"
[ -n "${PYTHON:-}" ] && PY="$PYTHON"

# ── Colors (W0lfSword palette) ─────────────────────────────────
# CRITICAL: these are literal backslash sequences, NOT real ESC.
# Use them ONLY in printf FORMAT strings or `echo -e` args.
C_WOLF='\033[38;5;153m'
C_ICE='\033[38;5;195m'
C_FROST='\033[38;5;117m'
C_SNOW='\033[38;5;255m'
C_GREY='\033[38;5;245m'
C_DIM='\033[38;5;240m'
C_EYE='\033[1;38;5;39m'
C_RED='\033[0;31m'
C_GRN='\033[0;32m'
C_AMB='\033[1;33m'
NC='\033[0m'
B='\033[1m'

# ── Sudo check ─────────────────────────────────────────────────
# USB access needs root on Linux (libusb). macOS/Windows do not.
# Read-only commands (help, version, offsets list, coverage,
# contribute status/pr, explain) skip the warning.
# deps is deliberately absent: a dependency check must work as a normal user
ROOT_NEEDED_COMMANDS="guided setup hw flash pwn health doctor"
FIRST_ARG="${1:-menu}"
if [ "$(uname -s)" = "Linux" ] && [ "$EUID" -ne 0 ]; then
    case " $ROOT_NEEDED_COMMANDS " in
        *" $FIRST_ARG "*)
            echo -e "  ${C_AMB}⚠  Not running as root${NC}"
            echo -e "  ${C_DIM}  USB access needs root on Linux. Re-run with:${NC}  ${C_EYE}sudo ./usbliter8 $FIRST_ARG${NC}"
            echo ""
            ;;
    esac
fi

# ── Session log + exit trap ────────────────────────────────────
DATA_DIR="$PROJECT_DIR/.usbliter8"
mkdir -p "$DATA_DIR"
SESSION_LOG="$DATA_DIR/session.log"
log_script() { echo "[$(date '+%H:%M:%S')] $*" >> "$SESSION_LOG"; }

cleanup() {
    local rc=$?
    # never write escape codes into piped output: --json must stay parseable
    if [ -t 1 ]; then
        tput cnorm 2>/dev/null || true
        stty echo 2>/dev/null || true
        echo -e "\033[?25h"
    fi
    log_script "session ended (exit=$rc)"
    return $rc
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

# ── Helpers ────────────────────────────────────────────────────
ok()   { printf "  ${C_GRN}✓${NC} %s\n" "$1"; }
err()  { printf "  ${C_RED}✗${NC} %s\n" "$1"; }
warn() { printf "  ${C_AMB}⚠${NC} %s\n" "$1"; }
hint() { printf "  ${C_DIM}  → %s${NC}\n" "$1"; }
section() { printf "\n  ${C_FROST}${B}%s${NC}\n  ${C_DIM}%s${NC}\n" "$1" "$(printf '%*s' "${#1}" '' | tr ' ' '─')"; }

menu_opt() {
    local n="$1" name="${2:-}" desc="${3:-}" tag="${4:-}"
    printf "  ${C_EYE}${B}%2s.${NC} ${C_SNOW}%-13s${NC} ${C_DIM}%s${NC} " "$n" "$name" "$desc"
    if [ -n "$tag" ]; then echo -e "$tag"; else echo ""; fi
}

stage() { printf "  ${C_EYE}[%s]${NC} %s\n" "$1" "$2"; }

confirm() {
    local ans
    printf "  ${C_FROST}%s [y/N]: ${NC}" "$1"
    read -r ans
    case "$ans" in y|Y|yes|YES) return 0;; *) return 1;; esac
}

